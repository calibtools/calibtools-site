{%- assign ct_font = "'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" -%}
{%- assign ct_mono = "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" -%}
{%- assign ct_quote_no = name -%}
{%- for line in subtotal_line_items -%}{%- for property in line.properties -%}{%- if property.first == 'Quotation' and property.last != blank -%}{%- assign ct_quote_no = property.last -%}{%- endif -%}{%- endfor -%}{%- endfor -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<meta name="viewport" content="width=device-width">
<title>Your custom offer {{ ct_quote_no }}</title>
</head>
<body style="margin:0;padding:0;background:#F4F3EF;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F4F3EF;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background:#FFFFFF;border:1px solid #A8A59C;">

<tr><td style="padding:24px 28px 20px 28px;border-bottom:1px solid #141414;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
    <td align="left" valign="middle"><a href="https://calib.tools" style="text-decoration:none;"><img src="https://calib.tools/brand/email/wordmark-framed-light.png" width="160" alt="Calib.Tools" style="display:block;border:0;width:160px;height:auto;"></a></td>
    <td align="right" valign="middle" style="font-family:{{ ct_mono }};font-size:11px;line-height:16px;letter-spacing:0.04em;text-transform:uppercase;color:#6B6A66;">Quotation<br><span style="font-size:13px;color:#141414;letter-spacing:0;">{{ ct_quote_no }}</span></td>
  </tr></table>
</td></tr>

<tr><td style="padding:28px 28px 8px 28px;font-family:{{ ct_font }};color:#141414;">
  <h1 style="margin:0 0 10px 0;font-family:{{ ct_font }};font-size:26px;line-height:32px;font-weight:600;color:#141414;">Your custom offer</h1>
  {%- if custom_message != blank -%}
  <p style="margin:0 0 6px 0;font-size:15px;line-height:23px;color:#4A4A47;">{{ custom_message }}</p>
  {%- else -%}
  <p style="margin:0 0 6px 0;font-size:15px;line-height:23px;color:#4A4A47;">The quotation below lists what we agreed. Check the specification, then confirm the order with the button. Production starts once the order is confirmed.</p>
  {%- endif -%}
</td></tr>

<tr><td style="padding:16px 28px 8px 28px;">
  <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
    <td align="center" bgcolor="#E60012" style="background:#E60012;"><a href="{{ invoice_url }}" style="display:block;padding:14px 22px;font-family:{{ ct_mono }};font-size:13px;line-height:16px;letter-spacing:0.06em;text-transform:uppercase;font-weight:500;color:#FFFFFF;text-decoration:none;">Review and confirm your order</a></td>
  </tr></table>
  {%- if quote_pdf_url -%}
  <p style="margin:14px 0 0 0;font-family:{{ ct_font }};font-size:15px;line-height:22px;"><a href="{{ quote_pdf_url }}" style="color:#B3000E;text-decoration:underline;">Download the quotation (PDF)</a></p>
  {%- endif -%}
  <p style="margin:14px 0 0 0;font-family:{{ ct_font }};font-size:13px;line-height:20px;color:#4A4A47;">Custom targets are made to your specification, so an order can&rsquo;t be canceled, returned or exchanged once it is paid. A target that doesn&rsquo;t meet the agreed specification is repaired or replaced.</p>
</td></tr>

<tr><td style="padding:24px 28px 0 28px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr><td colspan="3" style="padding:8px 12px;background:#FBE9EA;font-family:{{ ct_mono }};font-size:11px;line-height:16px;letter-spacing:0.04em;text-transform:uppercase;color:#B3000E;">Items</td></tr>
    {%- for line in subtotal_line_items -%}
    <tr>
      <td width="64" valign="top" style="width:64px;padding:14px 0 14px 0;border-bottom:1px solid #EAE8E2;">{%- if line.image -%}<img src="{{ line | img_url: 'compact_cropped' }}" width="56" height="56" alt="" style="display:block;width:56px;height:56px;border:1px solid #EAE8E2;">{%- endif -%}</td>
      <td valign="top" style="padding:14px 10px 14px 4px;border-bottom:1px solid #EAE8E2;font-family:{{ ct_font }};color:#141414;">
        <div style="font-size:15px;line-height:21px;font-weight:600;">{{ line.title }}</div>
        <div style="font-family:{{ ct_mono }};font-size:12px;line-height:18px;color:#6B6A66;">Quantity {{ line.quantity }}</div>
        {%- for property in line.properties -%}{%- assign ct_first = property.first | slice: 0 -%}{%- if property.last != blank and ct_first != '_' and property.first != 'Quotation' -%}
        <div style="font-size:13px;line-height:19px;color:#4A4A47;"><span style="color:#6B6A66;">{{ property.first }}:</span> {{ property.last }}</div>
        {%- endif -%}{%- endfor -%}
      </td>
      <td align="right" valign="top" style="padding:14px 0 14px 0;border-bottom:1px solid #EAE8E2;font-family:{{ ct_mono }};font-size:14px;line-height:21px;color:#141414;white-space:nowrap;">{{ line.final_line_price | money }}</td>
    </tr>
    {%- endfor -%}
  </table>
</td></tr>

{%- if note != blank -%}
<tr><td style="padding:16px 28px 0 28px;font-family:{{ ct_font }};">
  <div style="padding:12px 14px;background:#F4F3EF;font-size:13px;line-height:20px;color:#4A4A47;"><span style="font-family:{{ ct_mono }};font-size:11px;letter-spacing:0.04em;text-transform:uppercase;color:#6B6A66;">Specification and notes</span><br>{{ note | newline_to_br }}</div>
</td></tr>
{%- endif -%}

<tr><td style="padding:18px 28px 26px 28px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-family:{{ ct_mono }};font-size:14px;line-height:24px;color:#141414;">
    <tr><td style="color:#6B6A66;">Subtotal</td><td align="right">{{ subtotal_price | money }}</td></tr>
    <tr><td style="color:#6B6A66;">Shipping</td><td align="right">{{ shipping_price | money }}</td></tr>
    {%- if tax_price > 0 -%}<tr><td style="color:#6B6A66;">Taxes</td><td align="right">{{ tax_price | money }}</td></tr>{%- endif -%}
    <tr><td style="padding-top:8px;border-top:1px solid #141414;font-weight:600;">Total</td><td align="right" style="padding-top:8px;border-top:1px solid #141414;font-size:17px;font-weight:600;">{{ total_price | money_with_currency }}</td></tr>
  </table>
  <p style="margin:10px 0 0 0;font-family:{{ ct_font }};font-size:12px;line-height:18px;color:#6B6A66;">Import duties and taxes of your country are not included unless the quotation says so.</p>
</td></tr>

<tr><td style="padding:18px 28px 22px 28px;border-top:1px solid #A8A59C;font-family:{{ ct_font }};font-size:13px;line-height:20px;color:#4A4A47;">
  Questions or changes? Reply to this email or write to <a href="mailto:{{ shop.email }}" style="color:#B3000E;text-decoration:underline;">{{ shop.email }}</a>. We answer within one business day.
</td></tr>

<tr><td style="padding:16px 28px 20px 28px;border-top:1px solid #D6D3CB;font-family:{{ ct_font }};font-size:14px;line-height:20px;color:#141414;">
  <span style="color:#E60012;">&#9632;</span>&nbsp; Every calibration starts with a target you can trust.<br>
  <span style="font-family:{{ ct_mono }};font-size:11px;letter-spacing:0.04em;color:#6B6A66;">CALIB.TOOLS ENGINEERING · calib.tools</span>
</td></tr>

</table>
</td></tr>
</table>
</body>
</html>
