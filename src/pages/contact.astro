---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
import { CONTACT_EMAIL } from '@/lib/claims';

const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Contact' }]);
---
<Base title="Contact" description="Get in touch with Calib.Tools — questions, quotes, custom targets and institutional orders." section="support" jsonLd={bcLd}>
  <div class="container-x py-10 md:py-16">
    <div class="mx-auto max-w-[720px] prose-calib flex flex-col gap-5">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">Contact</h1>

      <p>Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> &mdash; we reply within one business day.</p>

      <p>For custom targets, large quantities or institutional purchase orders, use the <a href="/quote/">Request a quote</a> form.</p>

      <h2>What to include</h2>
      <ul class="ml-5 flex flex-col gap-2 text-[15px] list-disc">
        <li>Pattern type and dimensions (or a link to your pattern generator export)</li>
        <li>Quantity and substrate preference (composite or ceramic)</li>
        <li>Whether you need an ILAC calibration certificate</li>
        <li>Shipping destination</li>
      </ul>
    </div>
  </div>
</Base>
