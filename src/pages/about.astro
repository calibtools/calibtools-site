---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
import { INSPECTION_CLAIM, CONTACT_EMAIL } from '@/lib/claims';
import { VISION, MISSION, ONE_LINER } from '@/lib/brand';
import { Image } from 'astro:assets';
import workspaceImg from '@/assets/about/workspace.webp';
import benchImg from '@/assets/about/inspection-bench.webp';
import caliperImg from '@/assets/about/check-caliper.webp';
import flatnessImg from '@/assets/about/check-flatness.webp';
const imgSizes = '(max-width: 760px) 100vw, 720px';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'About' }]);
---
<Base title="About Calib.Tools" description={ONE_LINER} jsonLd={bcLd}>
  <div class="container-x py-10 md:py-16">
    <div class="prose-calib mx-auto flex max-w-[720px] flex-col gap-8">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">About Calib.Tools</h1>

      <p>{ONE_LINER}</p>

      <section class="flex flex-col gap-3">
        <h2>Our vision</h2>
        <p>{VISION}</p>
      </section>

      <section class="flex flex-col gap-3">
        <h2>Our mission</h2>
        <p>{MISSION}</p>
      </section>

      <section class="flex flex-col gap-3">
        <h2>What we make</h2>
        <p>ChArUco, checkerboard, AprilGrid, circle grid and HALCON targets on aluminum composite and ceramic, from palm-sized boards for microscope optics to 800&nbsp;&times;&nbsp;600&nbsp;mm boards for robot cells. Every pattern follows OpenCV conventions, and every target has a datasheet with its real tolerances.</p>
        <Image src={workspaceImg} alt="A ChArUco board and a checkerboard calibration board leaning against the wall on a workbench by a window, next to a small industrial camera on a tripod and a closed laptop." widths={[480, 720, 1440]} sizes={imgSizes} class="block h-auto w-full border border-line" />
      </section>

      <section class="flex flex-col gap-3">
        <h2>How we work</h2>
        <ul class="ml-5 flex flex-col gap-2 text-[15px] list-disc">
          <li><strong>Specs first.</strong> Tolerance, flatness and material are on the product page and datasheet before you buy, not after you ask.</li>
          <li><strong>Measured before it ships.</strong> {INSPECTION_CLAIM}.</li>
          <li><strong>Files that match the board.</strong> Marker ID ranges, config files and drawings come from the same data as the target itself.</li>
        </ul>
        <figure class="m-0 flex flex-col gap-2">
          <div class="grid grid-cols-1 gap-2 sm:grid-cols-3">
            <Image src={caliperImg} alt="A digital caliper lying across the squares of a checkerboard calibration board." widths={[240, 480, 720]} sizes="(max-width: 640px) 100vw, 240px" class="block aspect-[3/2] h-auto w-full border border-line object-cover" />
            <Image src={flatnessImg} alt="A hand sliding a feeler gauge under a steel straightedge that rests across a checkerboard calibration board on a granite plate." widths={[240, 480, 720]} sizes="(max-width: 640px) 100vw, 240px" class="block aspect-[3/2] h-auto w-full border border-line object-cover" />
            <Image src={benchImg} alt="A ChArUco calibration board lying on the granite table of a bridge-type measuring machine." widths={[240, 480, 720]} sizes="(max-width: 640px) 100vw, 240px" class="block aspect-[3/2] h-auto w-full border border-line object-cover" />
          </div>
          <figcaption class="text-[13px] text-ink-muted">The checks, illustrated: pitch, flatness and corner positions. These pictures are illustrations, not photographs of an order.</figcaption>
        </figure>
      </section>

      <section class="flex flex-col gap-3">
        <h2>Free tools</h2>
        <p>A good target in a bad setup still wastes time. Our <a href="/tools/generator/">pattern generator</a>, <a href="/tools/fov/">field-of-view calculator</a>, <a href="/tools/capture/">capture planner</a> and <a href="/tools/check/">image checks</a> are free, run in your browser and need no account.</p>
      </section>

      <section class="flex flex-col gap-3">
        <h2>Who we are</h2>
        <p>Calib.Tools LLC is a US company. We design and specify the targets, and produce them with a partner factory that measures each one on equipment checked against a golden-sample reference for its material and process. We ship worldwide.</p>
      </section>

      <div class="flex flex-wrap gap-3 border-t border-line pt-6">
        <a href="/targets/" class="btn-md btn-primary">Shop targets</a>
        <a href="/tools/" class="btn-md btn-secondary">Open free tools</a>
        <a href={`mailto:${CONTACT_EMAIL}`} class="btn-md btn-secondary">Email us</a>
      </div>
    </div>
  </div>
</Base>
