---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'About' }]);
---
<Base title="About Calib.Tools" description="Who builds Calib.Tools, how we inspect every board, and why calibration target accuracy matters. Know your target to the micron." jsonLd={bcLd}>
  <div class="container-x py-10 md:py-16">
    <div class="prose-calib mx-auto flex max-w-[720px] flex-col gap-8">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">About Calib.Tools</h1>

      <section class="flex flex-col gap-3">
        <h2>Who</h2>
        <p>[WHO WE ARE — founding team, background in machine vision and metrology.]</p>
      </section>

      <section class="flex flex-col gap-3">
        <h2>Where</h2>
        <p>We sell from the US, manufacture with a partner factory and measure every board before it ships. Shipping worldwide.</p>
      </section>

      <section class="flex flex-col gap-3">
        <h2>How we inspect</h2>
        <p>Every board is measured at the factory before shipping by comparison against a golden sample calibrated by a DAkkS-accredited laboratory. An ILAC-MRA calibration certificate from a CNAS-accredited laboratory is available as an add-on (SVC-X-CERT-ILAC).</p>
      </section>

      <section class="flex flex-col gap-3">
        <h2>Why</h2>
        <p>[WHY WE BUILT THIS — calibration targets should be affordable, well-documented and shipped with the files you actually need. The free tools exist because a good target paired with a bad setup wastes money. We want every team — from a PhD student to a production line — to know their targets are measured before they ship.]</p>
      </section>

      <div class="flex flex-wrap gap-3 border-t border-line pt-6">
        <a href="/targets/" class="btn-md btn-primary">Shop targets</a>
        <a href="/tools/" class="btn-md btn-secondary">Open free tools</a>
        <a href="mailto:hello@calib.tools" class="btn-md btn-secondary">hello@calib.tools</a>
      </div>
    </div>
  </div>
</Base>
