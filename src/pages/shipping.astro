---
import Base from '@/layouts/Base.astro';
---
<Base title="Shipping" description="Shipping information for Calib.Tools calibration targets.">
  <div class="container-x py-10 md:py-16">
    <div class="prose-calib mx-auto flex max-w-[720px] flex-col gap-5">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">Shipping</h1>

      <h2>Processing time</h2>
      <p>Orders placed before 14:00 CET on business days are dispatched the same day. All other orders ship the next business day.</p>

      <h2>Shipping methods &amp; rates</h2>
      <table>
        <thead><tr><th>Destination</th><th>Method</th><th>Cost</th><th>Transit</th></tr></thead>
        <tbody>
          <tr><td>Germany</td><td>DHL Paket</td><td>Free over €150 / €6.90</td><td>1–2 days</td></tr>
          <tr><td>EU</td><td>DHL / DPD</td><td>Free over €150 / €9.90</td><td>2–4 days</td></tr>
          <tr><td>Switzerland / Norway</td><td>DHL Express</td><td>€14.90</td><td>3–5 days</td></tr>
          <tr><td>United States</td><td>DHL Express</td><td>€24.90</td><td>4–7 days</td></tr>
          <tr><td>Rest of world</td><td>DHL Express</td><td>€29.90</td><td>5–10 days</td></tr>
        </tbody>
      </table>

      <h2>Customs &amp; duties</h2>
      <p>EU orders include VAT. Orders outside the EU may be subject to local customs duties and import taxes. These are the responsibility of the buyer.</p>
      <p>For US orders, DDP (Delivered Duty Paid) is available on request — <a href="mailto:hello@calib.tools">contact us</a>.</p>

      <h2>Tracking</h2>
      <p>A tracking link is emailed as soon as your order ships.</p>

      <h2>Questions?</h2>
      <p>Email <a href="mailto:hello@calib.tools">hello@calib.tools</a> — we reply within one business day.</p>
    </div>
  </div>
</Base>
