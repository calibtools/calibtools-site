---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Shipping' }]);
---
<Base title="Shipping" description="Shipping times, methods and rates for Calib.Tools calibration targets. Tracked express worldwide, made to order." jsonLd={bcLd}>
  <div class="container-x py-10 md:py-16">
    <div class="prose-calib mx-auto flex max-w-[720px] flex-col gap-5">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">Shipping</h1>

      <h2>Processing time</h2>
      <p>All targets are made to order. Production and dispatch from the factory takes 2&ndash;3 weeks. A tracking link is emailed as soon as your order ships.</p>

      <h2>Delivery times &amp; methods</h2>
      <table>
        <thead><tr><th>Destination</th><th>Transit</th><th>Method</th><th>Rates</th></tr></thead>
        <tbody>
          <tr><td>EU</td><td>3&ndash;6 days</td><td>Tracked express</td><td>Calculated at checkout</td></tr>
          <tr><td>UK / Switzerland / Norway</td><td>3&ndash;6 days</td><td>Tracked express</td><td>Calculated at checkout</td></tr>
          <tr><td>United States</td><td>3&ndash;5 days</td><td>Tracked express</td><td>Calculated at checkout</td></tr>
          <tr><td>Rest of world</td><td>5&ndash;10 days</td><td>Tracked express</td><td>Calculated at checkout</td></tr>
        </tbody>
      </table>

      <h2>Customs &amp; duties</h2>
      <p>Prices are in EUR and exclude import VAT and duties. Shipments are sent DAP: the carrier collects import VAT (and duty, if any) from the recipient before delivery. Business customers can reclaim import VAT through their normal return. DDP for larger orders on request &mdash; <a href="mailto:hello@calib.tools">contact us</a>.</p>

      <h2>Questions?</h2>
      <p>Email <a href="mailto:hello@calib.tools">hello@calib.tools</a> &mdash; we reply within one business day.</p>
    </div>
  </div>
</Base>
