---
import Base from '@/layouts/Base.astro';
import { ArrowLeft } from 'lucide-astro';
import { CONTACT_EMAIL } from '@/lib/claims';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface SerialRecord {
  sn: string;
  part_number: string;
  id_range: string;
  inspected_on: string;
  inspector: string;
  report_url: string;
}

export function getStaticPaths() {
  let serials: SerialRecord[] = [];
  try {
    serials = JSON.parse(readFileSync(resolve('data/serials.json'), 'utf-8'));
  } catch { /* empty register */ }

  const paths = serials.map((s) => ({
    params: { sn: s.sn },
    props: { record: s, found: true },
  }));
  paths.push({
    params: { sn: 'unknown' },
    props: { record: null as unknown as SerialRecord, found: false as const },
  });
  return paths;
}

const { sn } = Astro.params;
const { record, found } = Astro.props;
---
<Base
  title={found ? `SN ${sn} — Inspection record` : `No record for SN ${sn}`}
  description={found ? `Inspection record for serial number ${sn}.` : `No record found for serial number ${sn}.`}
  noindex
>
  <section class="container-x flex flex-col items-center gap-6 py-16 md:py-24">
    {found && record ? (
      <div class="flex w-full max-w-[600px] flex-col gap-6">
        <div class="flex flex-col gap-2 text-center">
          <span class="eyebrow">Inspection record</span>
          <h1 class="h-display m-0 text-[32px] md:text-[40px]">SN {record.sn}</h1>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-[15px]">
            <tbody>
              <tr class="border-t border-line">
                <td class="py-3 px-3 font-semibold text-ink-muted">Serial number</td>
                <td class="py-3 px-3 spec">{record.sn}</td>
              </tr>
              <tr class="border-t border-line bg-ground-alt">
                <td class="py-3 px-3 font-semibold text-ink-muted">Part number</td>
                <td class="py-3 px-3 spec">{record.part_number}</td>
              </tr>
              <tr class="border-t border-line">
                <td class="py-3 px-3 font-semibold text-ink-muted">ID range</td>
                <td class="py-3 px-3 spec">{record.id_range}</td>
              </tr>
              <tr class="border-t border-line bg-ground-alt">
                <td class="py-3 px-3 font-semibold text-ink-muted">Inspected on</td>
                <td class="py-3 px-3">{record.inspected_on}</td>
              </tr>
              <tr class="border-t border-line">
                <td class="py-3 px-3 font-semibold text-ink-muted">Inspector</td>
                <td class="py-3 px-3">{record.inspector}</td>
              </tr>
              <tr class="border-t border-b border-line bg-ground-alt">
                <td class="py-3 px-3 font-semibold text-ink-muted">Report</td>
                <td class="py-3 px-3">
                  <a href={record.report_url} class="font-semibold text-brand no-underline hover:underline">Download PDF</a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="text-center">
          <a href="/verify/" class="inline-flex items-center gap-1 text-sm text-ink-muted no-underline hover:text-brand"><ArrowLeft size={16} stroke-width={1.6} aria-hidden="true" /> Look up another serial</a>
        </div>
      </div>
    ) : (
      <div class="flex flex-col items-center gap-4 text-center">
        <span class="eyebrow">Not found</span>
        <h1 class="h-display m-0 text-[32px] md:text-[40px]">No record for SN {sn}</h1>
        <p class="m-0 max-w-[480px] text-base text-ink-muted">
          Check the number on the box label &mdash; it&rsquo;s six digits after &ldquo;SN&rdquo;. Records go live when the target ships, so a brand-new order can take a day to appear.
        </p>
        <p class="m-0 max-w-[480px] text-base text-ink-muted">
          Still nothing? Email <a href={`mailto:${CONTACT_EMAIL}`} class="text-brand">{CONTACT_EMAIL}</a> with your order number.
        </p>
        <a href="/verify/" class="btn-md btn-primary mt-2">Try another serial</a>
      </div>
    )}
  </section>
</Base>
