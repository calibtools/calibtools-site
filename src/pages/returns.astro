---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Returns' }]);
---
<Base title="Returns" description="Return and refund policy for Calib.Tools calibration targets. 30-day return window, no questions asked." jsonLd={bcLd}>
  <div class="container-x py-10 md:py-16">
    <div class="prose-calib mx-auto flex max-w-[720px] flex-col gap-5">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">Returns &amp; refunds</h1>

      <h2>30-day return window</h2>
      <p>Not flat, not accurate, not what you ordered — send it back within 30 days of delivery for a full refund or replacement. No questions asked.</p>

      <h2>How to return</h2>
      <p>Email <a href="mailto:hello@calib.tools">hello@calib.tools</a> with your order number. We will send a prepaid return label (EU) or shipping instructions (rest of world).</p>

      <h2>Condition</h2>
      <p>Targets must be returned in their original packaging. Light handling marks from mounting are fine — we understand these are working tools.</p>

      <h2>Refund timeline</h2>
      <p>Refunds are processed within 3 business days of receiving the return. The amount appears on your statement within 5–10 business days depending on your bank.</p>

      <h2>Custom orders</h2>
      <p>Custom-printed targets (non-standard patterns or sizes) cannot be returned unless they do not meet the agreed specification.</p>

      <h2>Questions?</h2>
      <p>Email <a href="mailto:hello@calib.tools">hello@calib.tools</a>.</p>
    </div>
  </div>
</Base>
