---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Reviews policy' }]);
---
<Base title="Reviews policy" description="How customer reviews work on Calib.Tools. We publish every review, disclose material connections, and never incentivize." jsonLd={bcLd}>
  <section class="container-x py-12 md:py-16">
    <div class="prose-calib mx-auto max-w-[640px]">
      <h1 class="h-display m-0 text-[32px] leading-[1.08] md:text-[44px]">Reviews policy</h1>
      <p class="mt-6 text-[15px] leading-relaxed text-ink-muted">Reviews come from customers we invite after delivery and from engineers who bought or tested our targets elsewhere and agreed to be quoted. If a reviewer received a free sample or a discount, or works with us, we say so under the review. We publish every review we receive and do not edit the text.</p>
      <p class="mt-6 text-[15px] leading-relaxed text-ink-muted">We remove only spam, personal attacks, or content that contains personal data. When we remove a review, a visible note stating the reason replaces it.</p>
      <p class="mt-4 text-[15px] text-ink-muted">
        Questions? <a href="mailto:hello@calib.tools">hello@calib.tools</a>
      </p>
    </div>
  </section>
</Base>
