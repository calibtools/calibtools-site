---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
import { CONTACT_EMAIL } from '@/lib/claims';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Reviews policy' }]);
---
<Base title="Reviews policy" description="How reviews work on Calib.Tools: who can review, what we publish, how material connections are disclosed and the only reasons we remove a review." jsonLd={bcLd}>
  <section class="container-x py-12 md:py-16">
    <div class="prose-calib mx-auto max-w-[640px]">
      <h1 class="h-display m-0 text-[32px] leading-[1.08] md:text-[44px]">Reviews policy</h1>

      <p class="mt-6 text-[15px] leading-relaxed text-ink-muted">Reviews only help if you can trust them. Here&rsquo;s how ours work.</p>

      <h2 class="mt-8">Who can review</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-muted">After your order ships, we email you a private review link for each product. The link is valid for 30 days. We also publish reviews from engineers who bought or tested our targets elsewhere and agreed to be quoted.</p>

      <h2 class="mt-8">What we publish</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-muted">Every review we receive, good or bad, with the rating and text exactly as written. We don&rsquo;t edit wording, and we don&rsquo;t hide low ratings.</p>

      <h2 class="mt-8">Disclosures</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-muted">If a reviewer got a free sample or a discount, or works with us, a label under the review says so. We never offer anything in exchange for a positive review.</p>

      <h2 class="mt-8">What we remove</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-muted">Only spam, personal attacks, and personal data such as phone numbers or addresses. A note stating the reason replaces any removed review.</p>

      <h2 class="mt-8">Our replies</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-ink-muted">We may reply publicly to a review, especially to fix a problem. Replies are marked as coming from Calib.Tools.</p>

      <p class="mt-6 text-[15px] text-ink-muted">
        Questions? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </section>
</Base>
