---
import Base from '@/layouts/Base.astro';
---
<Base title="Sample inspection report" description="Sample dimensional inspection report for Calib.Tools calibration targets.">
  <div class="container-x py-10 md:py-16">
    <div class="prose-calib mx-auto flex max-w-[720px] flex-col gap-5">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">Sample inspection report</h1>
      <div class="rounded border-2 border-dashed border-brand-tint bg-brand-tint/30 p-8 text-center">
        <p class="m-0 text-lg font-semibold text-brand-dark">[PLACEHOLDER]</p>
        <p class="m-0 text-sm text-ink-muted">The sample inspection report PDF will be uploaded here.</p>
      </div>
      <p>Every Calib.Tools calibration target ships with a dimensional inspection report. This page will host a downloadable sample so you can see the format before ordering.</p>
      <a href="/targets/" class="text-sm font-semibold">Back to targets →</a>
    </div>
  </div>
</Base>
