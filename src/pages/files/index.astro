---
import Base from '@/layouts/Base.astro';
import { getAllDatasheets } from '@/lib/datasheetManifest';
import { breadcrumbLd } from '@/lib/seo';
import { CONTACT_EMAIL } from '@/lib/claims';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Downloads' }]);

const entries = getAllDatasheets();
---
<Base title="Files and datasheets" description="Datasheets for every Calib.Tools calibration target — substrate, tolerances, flatness, pattern layout and marker IDs — plus the free config file tools." jsonLd={bcLd}>
  <section class="container-x flex flex-col gap-9 py-12 md:py-16">
    <div class="flex flex-col gap-2.5">
      <span class="eyebrow">Downloads</span>
      <h1 class="h-display m-0 text-[36px] md:text-[48px]">Files &amp; downloads</h1>
      <p class="m-0 max-w-[600px] text-base text-ink-muted">Datasheets for every target we sell. Each PDF is built from the same spec data as the product pages, so the numbers always match. The revision and date are on every page.</p>
    </div>

    {entries.length > 0 && (
      <div class="flex flex-col gap-5">
        <h2 class="h-display m-0 text-[28px] md:text-[32px]">Product datasheets</h2>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-[15px]">
            <thead>
              <tr class="bg-brand-tint text-left">
                <th class="py-3 pl-3 pr-0 font-bold text-brand-dark"><span class="sr-only">First page</span></th>
                <th class="py-3 px-3 font-bold text-brand-dark">Code</th>
                <th class="py-3 px-3 font-bold text-brand-dark">Product</th>
                <th class="py-3 px-3 font-bold text-brand-dark text-right">Pages</th>
                <th class="py-3 px-3 font-bold text-brand-dark"></th>
              </tr>
            </thead>
            <tbody>
              {entries.map((ds, i) => (
                <tr class={`border-t border-line ${i % 2 === 1 ? 'bg-ground-alt' : ''}`}>
                  <td class="py-3 pl-3 pr-0 align-middle">
                    {ds.thumbUrl && (
                      <a href={ds.url} class="block w-[56px] md:w-[72px]" aria-hidden="true" tabindex="-1">
                        <img src={ds.thumbUrl} alt="" width="720" height="1019" loading="lazy" decoding="async" class="block h-auto w-full border border-line bg-white" />
                      </a>
                    )}
                  </td>
                  <td class="py-3 px-3 spec">{ds.code}</td>
                  <td class="py-3 px-3">{ds.name}</td>
                  <td class="py-3 px-3 spec text-right">{ds.pages}</td>
                  <td class="py-3 px-3">
                    <a href={ds.url} class="font-semibold text-brand no-underline hover:text-brand-dark">Download PDF</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <div class="flex flex-col gap-5">
      <h2 class="h-display m-0 text-[28px] md:text-[32px]">Config &amp; pattern files</h2>
      <p class="m-0 max-w-[600px] text-base text-ink-muted">Calibration config files for OpenCV, Kalibr, ROS&nbsp;2 and HALCON come from our free tools, so they always match the board you pick:</p>
      <ul class="ml-5 flex flex-col gap-2 text-[15px] list-disc">
        <li><a href="/tools/generator/" class="text-brand font-semibold no-underline hover:text-brand-dark">Pattern generator</a> &mdash; print-exact PDF and SVG for any grid, with matching config files.</li>
        <li><a href="/tools/convert/" class="text-brand font-semibold no-underline hover:text-brand-dark">Config converter</a> &mdash; turn one format into another (OpenCV &harr; Kalibr &harr; ROS&nbsp;2 &harr; HALCON).</li>
      </ul>
    </div>

    <div class="flex flex-col gap-3">
      <h2 class="h-display m-0 text-[28px] md:text-[32px]">Can&rsquo;t find something?</h2>
      <p class="m-0 max-w-[600px] text-base text-ink-muted">Need a drawing, a DXF outline for your fixture, or an older revision? Email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> with the product code.</p>
    </div>
  </section>
</Base>
