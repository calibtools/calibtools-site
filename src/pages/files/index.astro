---
import Base from '@/layouts/Base.astro';
import { getAllDatasheets } from '@/lib/datasheetManifest';
import { breadcrumbLd } from '@/lib/seo';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Downloads' }]);
const pageDescription = "Download datasheets, user manuals and application notes for every Calib.Tools target: substrate specifications, tolerances, pattern files and revisions.";

const entries = getAllDatasheets();

/** Friendly product name from a datasheet code like CT-DS-CHA-P */
const CODE_TO_NAME: Record<string, string> = {
  'CT-DS-CHA-C': 'ChArUco ceramic board',
  'CT-DS-CHA-P': 'ChArUco composite board',
  'CT-DS-CHT-P': 'Checkerboard composite',
  'CT-DS-APR-P': 'AprilGrid composite',
  'CT-DS-CIR-P': 'Circle grid composite',
  'CT-DS-HAL-P': 'HALCON calibration plate',
  'CT-DS-ACC-A-FIX-14': 'Mounting fixture',
};
---
<Base title="Files and datasheets" description={pageDescription} jsonLd={bcLd}>
  <section class="container-x flex flex-col gap-9 py-12 md:py-16">
    <div class="flex flex-col gap-2.5">
      <span class="eyebrow">Downloads</span>
      <h1 class="h-display m-0 text-[36px] md:text-[48px]">Files &amp; datasheets</h1>
      <p class="m-0 max-w-[600px] text-base text-ink-muted">Product datasheets, user manual, inspection report template, and pattern file documentation. All documents are PDF, generated from source and versioned.</p>
    </div>

    {entries.length > 0 && (
      <div class="flex flex-col gap-5">
        <h2 class="h-display m-0 text-[28px] md:text-[32px]">Product datasheets</h2>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-[15px]">
            <thead>
              <tr class="bg-brand-tint text-left">
                <th class="py-3 px-3 font-bold text-brand-dark">Code</th>
                <th class="py-3 px-3 font-bold text-brand-dark">Product</th>
                <th class="py-3 px-3 font-bold text-brand-dark text-right">Pages</th>
                <th class="py-3 px-3 font-bold text-brand-dark"></th>
              </tr>
            </thead>
            <tbody>
              {entries.map((ds, i) => (
                <tr class={`border-t border-line ${i % 2 === 1 ? 'bg-ground-alt' : ''}`}>
                  <td class="py-3 px-3 spec">{ds.code}</td>
                  <td class="py-3 px-3">{CODE_TO_NAME[ds.code] ?? ds.code}</td>
                  <td class="py-3 px-3 spec text-right">{ds.pages}</td>
                  <td class="py-3 px-3">
                    <a href={ds.url} class="font-semibold text-brand no-underline hover:text-brand-dark">Download PDF</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </section>
</Base>
