---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Legal notice' }]);
---
<Base title="Legal notice" description="Legal notice and company information for Calib.Tools, makers of precision calibration targets." jsonLd={bcLd}>
  <div class="container-x py-10 md:py-16">
    <div class="prose-calib mx-auto flex max-w-[720px] flex-col gap-5">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">Legal notice</h1>

      <h2>Company</h2>
      <p>
        <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[US LEGAL ENTITY NAME]</span><br />
        <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[STREET, CITY, STATE ZIP, USA]</span><br />
        <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[STATE OF INCORPORATION]</span>
      </p>

      <h2>Represented by</h2>
      <p><span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[REPRESENTED BY]</span></p>

      <h2>Contact</h2>
      <p>
        Email: <a href="mailto:hello@calib.tools">hello@calib.tools</a>
      </p>

      <h2>Responsible for content</h2>
      <p><span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[NAME, ADDRESS]</span></p>
    </div>
  </div>
</Base>
