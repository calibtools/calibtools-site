---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Legal notice' }]);
---
<Base title="Legal notice" description="Company information, registered address and responsible contact for Calib.Tools LLC, supplier of camera calibration targets and free browser tools." jsonLd={bcLd}>
  <div class="container-x py-10 md:py-16">
    <div class="prose-calib mx-auto flex max-w-[720px] flex-col gap-5">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">Legal notice</h1>

      <h2>Company</h2>
      <p>
        Calib.Tools LLC<br />
        1401 21st Street, Suite R, Sacramento, CA 95811, USA<br />
        Incorporated in California
      </p>

      <h2>Contact</h2>
      <p>
        Email: <a href="mailto:hello@calib.tools">hello@calib.tools</a>
      </p>
    </div>
  </div>
</Base>
