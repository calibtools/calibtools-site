---
import Base from '@/layouts/Base.astro';
---
<Base title="Imprint" description="Legal information and imprint (Impressum) for Calib.Tools.">
  <div class="container-x py-10 md:py-16">
    <div class="prose-calib mx-auto flex max-w-[720px] flex-col gap-5">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">Imprint</h1>
      <p>Information pursuant to § 5 TMG (German Telemedia Act).</p>

      <h2>Company</h2>
      <p>
        <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[COMPANY LEGAL NAME]</span><br />
        <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[STREET ADDRESS]</span><br />
        <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[POSTAL CODE, CITY]</span><br />
        Germany
      </p>

      <h2>Represented by</h2>
      <p><span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[MANAGING DIRECTOR NAME]</span></p>

      <h2>Contact</h2>
      <p>
        Email: <a href="mailto:hello@calib.tools">hello@calib.tools</a><br />
        Phone: <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[PHONE NUMBER]</span>
      </p>

      <h2>Commercial register</h2>
      <p>
        <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[REGISTER COURT]</span>,
        <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[HRB NUMBER]</span>
      </p>

      <h2>VAT identification number</h2>
      <p><span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[UST-IDNR]</span></p>

      <h2>Responsible for content (§ 18 Abs. 2 MStV)</h2>
      <p><span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[NAME, ADDRESS]</span></p>

      <h2>Dispute resolution</h2>
      <p>The European Commission provides an online dispute resolution platform at <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener">ec.europa.eu/consumers/odr</a>. We are neither obliged nor willing to participate in dispute resolution proceedings before a consumer arbitration board.</p>
    </div>
  </div>
</Base>
