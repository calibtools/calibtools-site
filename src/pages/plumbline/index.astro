---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
import { software, RELEASE, NOTIFY_TAG, SAMPLE, coveragePercent, downloadsByPlatform, fileUrl, sizeMb } from '@/lib/software';
import NewsletterForm from '@/islands/NewsletterForm';
import { ChevronDown } from 'lucide-astro';
import { fileLinkHint } from '../../../scripts/file-links.mjs';
import { drawingForPartNumber } from '@/lib/boardDrawing';
import { errorBarsFigureSvg, coverageMapFigureSvg } from '@/lib/guideFigures';

const beta = software.status === 'beta';
const downloads = downloadsByPlatform();
// What the system shows the first time an unsigned app is opened, and how to get past it.
const firstOpen = [
  { os: 'Windows', steps: 'When "Windows protected your PC" appears, click More info, then Run anyway.' },
  { os: 'macOS', steps: `When "Apple could not verify ${software.name} is free of malware" appears, click Done. Open System Settings, go to Privacy & Security, and under Security click Open Anyway beside ${software.name}. Confirm once more. You only do this once.` },
  { os: 'Linux', steps: `Make the file executable, then run it: chmod +x ${downloads.find((d) => d.platform === 'Linux')!.main.file}` },
];
// Figures are drawn from SAMPLE (what the app reports for its own sample images), never typed in.
const errors = SAMPLE.errorsPx;
const kept = SAMPLE.kept;
// The two images spoiled on purpose (SAMPLE.spoiledImages, counted from 1): the ones left out in the third figure.
const out = SAMPLE.spoiledImages.map((n) => n - 1);
const two = (n: number) => String(n).padStart(2, '0');
const outNames = SAMPLE.spoiledImages.map(two).join(' and ');
// After leaving them out: the other images carry their new error (SAMPLE.kept.errorsPx), the two keep their old bar as an outline.
let k = 0;
const errorsAfter = errors.map((v, i) => (out.includes(i) ? v : SAMPLE.kept.errorsPx[k++]));
const grid = SAMPLE.coverage;
const covered = coveragePercent(grid);
const barsSvg = errorBarsFigureSvg(errors, { label: `Bar chart of the reprojection error of ${errors.length} sample images, between ${Math.min(...errors).toFixed(3)} and ${Math.max(...errors).toFixed(3)} px` });
const barsOutSvg = errorBarsFigureSvg(errorsAfter, { leftOut: out, label: `The same bar chart with images ${outNames} drawn as outlines: they are left out of the calibration, and the error of the set falls from ${SAMPLE.rmsPx.toFixed(3)} to ${kept.rmsPx.toFixed(3)} px` });
const coverageSvg = coverageMapFigureSvg(grid, `Coverage map: ${covered} percent of the image has corners; the cells along the edges are empty`);

const BOARD_PN = 'CT-CHA-P-400X300-D6';
const boardSvg = drawingForPartNumber(BOARD_PN);

const faqs = [
  { q: 'Is Plumbline free?', a: 'Yes. It costs nothing, for commercial work too.' },
  { q: 'Are my images uploaded?', a: 'No. Plumbline runs on your computer and works offline. Your images and results stay there.' },
  { q: 'Which lenses does it handle?', a: 'Standard lenses, with the OpenCV camera model and its optional k3, tangential, rational and thin-prism terms, and fisheye lenses.' },
  { q: 'Which boards can I use?', a: 'ChArUco boards, checkerboards, circle grids, asymmetric circle grids, AprilGrids in the Kalibr layout and ArUco grids, printed yourself or bought. You enter the counts, the sizes and the dictionary.' },
  { q: 'Will the result work with OpenCV and ROS?', a: 'Yes. The calibration runs on OpenCV, and the export is an OpenCV YAML or JSON file or a ROS camera_info file.' },
  { q: 'Is the beta safe to rely on?', a: `Version ${RELEASE.version} is a public beta. Its results have been checked with rendered images whose true camera is known; checks with photographs of real boards are under way. For work that matters, compare the result with a method you already trust.` },
  { q: 'Why does my computer warn me when I open it?', a: 'The installers of the beta are not signed, so Windows and macOS ask before the first start. The steps are under "The first time you open it" on this page.' },
];

const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: software.name }]);
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: software.name,
  url: `https://calib.tools${software.href}`,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: software.platforms.join(', '),
  softwareVersion: RELEASE.version,
  datePublished: RELEASE.released,
  downloadUrl: `https://calib.tools${software.href}#download`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'Calib.Tools', url: 'https://calib.tools' },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="Plumbline: free camera calibration software"
  description="Plumbline is free camera calibration software for Windows, macOS and Linux. See the error of every image and where your corners fell. Public beta."
  section="plumbline"
  jsonLd={[bcLd, appLd, faqLd]}
>
  {/* ── Hero ── */}
  <section class="container-x grid grid-cols-1 items-start gap-x-14 gap-y-10 py-10 md:py-14 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)]" data-rows="layout">
    <div class="flex min-w-0 flex-col gap-6">
      <span class="eyebrow">{software.name} · camera calibration software</span>
      <h1 class="h-display m-0 text-[36px] leading-[1.1] md:text-[56px]">Is your calibration as good as its error says?</h1>
      <p class="m-0 max-w-[640px] text-lg leading-relaxed text-ink-muted">
        {software.name} shows the error of every image and where in the frame your corners fell, so you can see which images to retake.
      </p>
    </div>
    <div id="download" class="card bracket flex scroll-mt-24 flex-col gap-4 p-6">
      <div class="flex flex-col gap-2">
        <div class="flex items-center gap-3">
          <span class="text-[20px] font-semibold leading-none">{software.name}</span>
          {beta && <span class="badge text-brand-dark">Beta</span>}
        </div>
        <span class="font-mono text-[13px] text-ink-muted">Version {RELEASE.version} · {RELEASE.released}</span>
      </div>
      <ul class="m-0 flex list-none flex-col gap-4 p-0">
        {downloads.map((d) => (
          <li class="flex flex-col gap-1.5">
            <a href={fileUrl(d.main)} class="btn-md btn-primary w-full normal-case tracking-normal" data-download={d.platform}>Download for {d.main.label}</a>
            <span class="text-[13px] leading-snug text-ink-muted">
              {d.main.fits}, {sizeMb(d.main.bytes)}{d.other && <>. Also: <a href={fileUrl(d.other)} class="whitespace-nowrap" data-download={d.platform}>{d.other.label}</a> ({sizeMb(d.other.bytes)})</>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* ── Beta notice, first start, new-version email ── */}
  <section class="border-t border-line bg-ground-alt">
    <div class="container-x grid gap-x-14 gap-y-10 py-[var(--section-y)] lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)]" data-rows="layout">
      <div class="flex min-w-0 flex-col gap-5">
        <span class="section-no">Public beta</span>
        <span class="section-rule"></span>
        <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">What to know about version {RELEASE.version}</h2>
        <p class="m-0 text-[17px] leading-[1.65] text-ink-muted">This is a public test version. Its results have been checked with rendered images whose true camera is known. Checks with photographs of real boards are under way. For work that matters, compare the result with a method you already trust.</p>
        <p class="m-0 text-[15px] leading-relaxed text-ink-muted">The installers are not signed yet, so Windows and macOS ask before the first start. They were built and started on {RELEASE.builtOn}.</p>
        <p class="m-0 text-[15px] leading-relaxed text-ink-muted">Found a problem? Write to <a href="mailto:hello@calib.tools">hello@calib.tools</a>, or use About, Report a problem in the app.</p>
      </div>
      <div class="flex min-w-0 flex-col gap-5">
        <h3 class="m-0 text-[18px] font-semibold">The first time you open it</h3>
        <div class="flex flex-col border border-line bg-sheet">
          {firstOpen.map((f, i) => (
            <details class:list={['group', i > 0 && 'border-t border-line']}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-4 py-3 text-[15px] font-semibold select-none hover:bg-ground-alt [&::-webkit-details-marker]:hidden">
                <span>{f.os}</span>
                <ChevronDown class="h-4 w-4 shrink-0 text-ink-soft transition-transform group-open:rotate-180" />
              </summary>
              <div class="px-4 pb-4 text-[15px] leading-[1.65] text-ink-muted [overflow-wrap:anywhere]">{f.steps}</div>
            </details>
          ))}
        </div>
        <div id="notify" class="flex scroll-mt-24 flex-col gap-3 border-t border-line pt-5">
          <p class="m-0 text-[15px] font-semibold">Sign up and help improve {software.name}</p>
          <NewsletterForm
            client:load
            compact
            id="pl"
            tag={NOTIFY_TAG}
            heading="Email to sign up for the beta"
            note=""
            button="Sign up"
            done="Thank you. We email you when a new version is out."
          />
          <p class="m-0 text-[13px] leading-relaxed text-ink-muted">{software.name} is in beta, and what you tell us shapes the next version. Leave your email: we let you know when a new version is out and may ask how this one worked for you. We use it for nothing else.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 1 Error for every image ── */}
  <section class="border-t border-line">
    <div class="container-x grid items-center gap-x-14 gap-y-8 py-[var(--section-y)] lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]" data-rows="layout">
      <div class="flex flex-col gap-5">
        <span class="section-no">Error per image</span>
        <span class="section-rule"></span>
        <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">See the error of every image</h2>
        <p class="m-0 text-[17px] leading-[1.65] text-ink-muted">One number for the whole set hides the two images that spoil it. {software.name} draws one bar per image, so a blurred shot or a misplaced corner stands out and you know where to look.</p>
      </div>
      <figure class="card p-5 m-0 flex flex-col gap-3">
        <div class="[&>svg]:block [&>svg]:h-auto [&>svg]:w-full" set:html={barsSvg} />
        <figcaption class="text-[13px] text-ink-muted">Reprojection error of the {errors.length} sample images, in pixels. Whole set: <span class="font-pixel" data-unit="px">{SAMPLE.rmsPx.toFixed(3)} px</span> RMS. Images {outNames} are spoiled on purpose.</figcaption>
      </figure>
    </div>
  </section>

  {/* ── 2 Coverage ── */}
  <section class="border-t border-line">
    <div class="container-x grid items-center gap-x-14 gap-y-8 py-[var(--section-y)] lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)]" data-rows="layout">
      <figure class="card p-5 order-2 m-0 flex flex-col gap-3 lg:order-1">
        <div class="mx-auto w-full max-w-[440px] [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" set:html={coverageSvg} />
        <figcaption class="text-[13px] text-ink-muted">Corners per cell across the {errors.length} sample images. {covered}&nbsp;% of the frame has corners; the outlined cells have none.</figcaption>
      </figure>
      <div class="order-1 flex flex-col gap-5 lg:order-2">
        <span class="section-no">Coverage</span>
        <span class="section-rule"></span>
        <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">See where your corners fell</h2>
        <p class="m-0 text-[17px] leading-[1.65] text-ink-muted">A low error only describes the parts of the image where corners were found. Lens distortion is strongest toward the edges, and that is where views are usually missing. The map shows which cells still need one.</p>
      </div>
    </div>
  </section>

  {/* ── 3 Leave an image out ── */}
  <section class="border-t border-line">
    <div class="container-x grid items-center gap-x-14 gap-y-8 py-[var(--section-y)] lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]" data-rows="layout">
      <div class="flex flex-col gap-5">
        <span class="section-no">Recalibrate</span>
        <span class="section-rule"></span>
        <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">Leave an image out and calibrate again</h2>
        <p class="m-0 text-[17px] leading-[1.65] text-ink-muted">Click a bar to leave that image out. {software.name} calibrates again with the rest and shows the new result beside the list. Click the bar once more to bring the image back.</p>
      </div>
      <figure class="card p-5 m-0 flex flex-col gap-3">
        <div class="[&>svg]:block [&>svg]:h-auto [&>svg]:w-full" set:html={barsOutSvg} />
        <figcaption class="text-[13px] text-ink-muted">Images {outNames} are left out. The other {kept.errorsPx.length} images give <span class="font-pixel" data-unit="px">{kept.rmsPx.toFixed(3)} px</span> RMS, down from <span class="font-pixel" data-unit="px">{SAMPLE.rmsPx.toFixed(3)} px</span>.</figcaption>
      </figure>
    </div>
  </section>

  {/* ── 4 Board ── */}
  <section class="border-t border-line">
    <div class="container-x grid items-center gap-x-14 gap-y-8 py-[var(--section-y)] lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)]" data-rows="layout">
      {boardSvg && (
        <figure class="card p-5 order-2 m-0 flex flex-col gap-3 lg:order-1">
          <div class="mx-auto w-full max-w-[440px] [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" set:html={boardSvg} />
          <figcaption class="text-[13px] text-ink-muted">A ChArUco board, drawn from the same geometry as the board itself: <a href="/targets/charuco-composite/" class="whitespace-nowrap">{BOARD_PN}</a>.</figcaption>
        </figure>
      )}
      <div class="order-1 flex flex-col gap-5 lg:order-2">
        <span class="section-no">Target</span>
        <span class="section-rule"></span>
        <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">Describe your board once</h2>
        <p class="m-0 text-[17px] leading-[1.65] text-ink-muted">{software.name} works with ChArUco boards, checkerboards, circle grids, AprilGrids and ArUco grids, printed or bought. Enter the squares across and down, the square size, and for ChArUco the marker size and dictionary.</p>
        <p class="m-0 text-[17px] leading-[1.65] text-ink-muted">It then states the corner count and marker IDs it expects, so a wrong entry shows before you calibrate.</p>
        <p class="m-0 text-[15px] text-ink-muted">No board yet? <a href="/tools/generator/charuco/">Print one with the pattern generator</a>.</p>
      </div>
    </div>
  </section>

  {/* ── 5 Export ── */}
  <section class="border-t border-line">
    <div class="container-x grid items-center gap-x-14 gap-y-8 py-[var(--section-y)] lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]" data-rows="layout">
      <div class="flex flex-col gap-5">
        <span class="section-no">Export</span>
        <span class="section-rule"></span>
        <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">Get a file your pipeline reads</h2>
        <p class="m-0 text-[17px] leading-[1.65] text-ink-muted">Export the camera matrix and distortion coefficients as OpenCV YAML, XML or JSON, or as a ROS camera_info file that camera drivers load as it is.</p>
      </div>
      <figure class="card p-5 m-0 flex min-w-0 flex-col gap-3">
        <code class="block max-w-full whitespace-pre-wrap [overflow-wrap:anywhere] font-mono text-[12px] leading-[1.6] text-ink">{SAMPLE.kept.cameraInfo}</code>
        <figcaption class="text-[13px] text-ink-muted">The start of the camera_info file {software.name} writes for the sample images, with images {outNames} left out.</figcaption>
      </figure>
    </div>
  </section>

  {/* ── 6 Check it yourself ── */}
  <section class="border-t border-line bg-ground-alt">
    <div class="container-x flex flex-col gap-5 py-[var(--section-y)]">
      <span class="section-no">Check it yourself</span>
      <span class="section-rule"></span>
      <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">Sample images with a known answer</h2>
      <p class="m-0 max-w-[760px] text-[17px] leading-[1.65] text-ink-muted">{software.name} comes with {errors.length} sample images rendered from a camera whose focal length is known. In two of them the board moves {SAMPLE.spoiledShiftMm}&nbsp;mm while the image is read out, as with a hand-held board. Run them, leave the two out and compare.</p>
      <dl class="m-0 grid max-w-[760px] grid-cols-1 gap-px border border-line bg-line md:grid-cols-3">
        <div class="rows-3 gap-y-1 bg-sheet p-3">
          <dt class="spec-label">True focal length</dt>
          <dd class="contents">
            <span class="font-pixel text-[18px] leading-snug text-ink" data-unit="px">{SAMPLE.trueFocalPx} px</span>
            <span class="spec-cond">set when the images were rendered</span>
          </dd>
        </div>
        <div class="rows-3 gap-y-1 bg-sheet p-3">
          <dt class="spec-label">All {errors.length} images</dt>
          <dd class="contents">
            <span class="font-pixel text-[18px] leading-snug text-ink" data-unit="px">{SAMPLE.focalPx.toFixed(2)} px</span>
            <span class="spec-cond">error <span class="font-pixel" data-unit="px">{SAMPLE.rmsPx.toFixed(3)} px</span> RMS, {SAMPLE.corners.toLocaleString('en-US')} corners</span>
          </dd>
        </div>
        <div class="rows-3 gap-y-1 bg-sheet p-3">
          <dt class="spec-label">Without images {outNames}</dt>
          <dd class="contents">
            <span class="font-pixel text-[18px] leading-snug text-ink" data-unit="px">{kept.focalPx.toFixed(2)} px</span>
            <span class="spec-cond">error <span class="font-pixel" data-unit="px">{kept.rmsPx.toFixed(3)} px</span> RMS, {kept.corners.toLocaleString('en-US')} corners</span>
          </dd>
        </div>
      </dl>
      <p class="m-0 max-w-[760px] text-[15px] text-ink-muted">Your images stay on your computer. {software.name} works offline and sends nothing.</p>
    </div>
  </section>

  {/* ── In this version ── */}
  <section class="border-t border-line">
    <div class="container-x flex flex-col gap-5 py-[var(--section-y)]">
      <span class="section-no">Version {RELEASE.version}</span>
      <span class="section-rule"></span>
      <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">What is in this version</h2>
      <dl class="m-0 flex max-w-[760px] flex-col border-t border-line">
        {RELEASE.contents.map((c) => (
          <div class="flex flex-col gap-2 border-b border-line py-4">
            <dt class="font-medium">{c.group}</dt>
            <dd class="m-0">
              <ul class="m-0 flex list-disc flex-col gap-1 pl-5 text-[15px] leading-relaxed text-ink-muted">
                {c.items.map((it) => <li>{it}</li>)}
              </ul>
            </dd>
          </div>
        ))}
        <div class="flex flex-col gap-2 border-b border-line py-4">
          <dt class="font-medium">Known limits</dt>
          <dd class="m-0">
            <ul class="m-0 flex list-disc flex-col gap-1 pl-5 text-[15px] leading-relaxed text-ink-muted">
              {RELEASE.limits.map((it) => <li>{it}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
      <p class="m-0 text-[15px] text-ink-muted"><a href={RELEASE.notes}>Full list of changes</a> · <a href={fileUrl(RELEASE.checksums)} target="_blank" rel="noopener">Checksums of the downloads (SHA-256)<span class="sr-only">{fileLinkHint(fileUrl(RELEASE.checksums))}</span></a></p>
    </div>
  </section>

  {/* ── 7 Questions ── */}
  <section class="border-t border-line">
    <div class="container-x flex flex-col gap-5 py-[var(--section-y)]">
      <span class="section-no">Questions</span>
      <span class="section-rule"></span>
      <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">Before you ask</h2>
      <dl class="m-0 flex max-w-[760px] flex-col border-t border-line">
        {faqs.map((f) => (
          <div class="flex flex-col gap-1 border-b border-line py-4">
            <dt class="font-medium">{f.q}</dt>
            <dd class="m-0 text-[15px] leading-relaxed text-ink-muted">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ── Closing ── */}
  <section class="border-t border-line">
    <div class="container-x flex flex-col gap-5 py-[var(--section-y)]">
      <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">Download {software.name}</h2>
      <div><a href="#download" class="btn-md btn-primary">Go to the downloads</a></div>
      <p class="m-0 max-w-[760px] text-[15px] text-ink-muted">Already have a calibration? The <a href="/tools/quality/">calibration quality analyzer</a> checks it in your browser.</p>
    </div>
  </section>
</Base>
