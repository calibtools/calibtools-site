---
import Base from '@/layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="container-x flex flex-col items-center gap-8 py-20 text-center">
    <div class="flex flex-col gap-3">
      <span class="font-mono text-[13px] uppercase tracking-[0.16em] text-ink-soft">404</span>
      <h1 class="h-display m-0 text-[36px] md:text-[48px]">Page not found</h1>
      <p class="m-0 text-lg text-ink-muted">The page you're looking for doesn't exist or has been moved.</p>
    </div>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/targets/" class="btn-primary">Calibration targets</a>
      <a href="/tools/" class="btn-dark">Free tools</a>
      <a href="/guides/" class="btn-dark">Guides</a>
    </div>
  </section>
</Base>
