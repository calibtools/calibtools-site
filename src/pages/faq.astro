---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
import { faqGroups } from '@/lib/faq-groups';

const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'FAQ' }]);

/** FAQPage JSON-LD */
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqGroups.flatMap((g) =>
    g.items.map((i) => ({
      '@type': 'Question',
      name: i.question,
      acceptedAnswer: { '@type': 'Answer', text: i.answer },
    })),
  ),
};
---
<Base title="FAQ — Calibration targets" description="Frequently asked questions about Calib.Tools calibration targets — accuracy, compatibility, ordering, shipping and returns." section="support" jsonLd={[bcLd, faqLd]}>
  <div class="container-x py-10 md:py-16">
    <div class="mx-auto max-w-[720px]">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">Frequently asked questions</h1>
      <p class="mt-3 text-[17px] text-ink-soft">Can&rsquo;t find your answer? <a href="/contact/">Contact us</a> &mdash; we reply within one business day.</p>

      {faqGroups.map((group) => (
        <section class="mt-10" id={group.id}>
          <h2 class="mt-0 mb-4 font-mono text-[13px] uppercase tracking-[0.08em] text-ink-soft">{group.heading}</h2>
          <div class="flex flex-col gap-0 border border-line rounded-lg overflow-hidden">
            {group.items.map((item, i) => (
              <details class:list={['group', i > 0 && 'border-t border-line']}>
                <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-[15px] font-semibold select-none hover:bg-ground-alt [&::-webkit-details-marker]:hidden list-none">
                  <span>{item.question}</span>
                  <svg class="h-4 w-4 shrink-0 text-ink-soft transition-transform group-open:rotate-180" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6l4 4 4-4" /></svg>
                </summary>
                <div class="px-5 pb-5 text-[15px] leading-[1.65] text-ink-muted">{item.answer}</div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>
