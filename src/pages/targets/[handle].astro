---
import Base from '@/layouts/Base.astro';
import VariantPicker from '@/islands/VariantPicker';
import { getProducts, getProductByHandle, sanitizeHtml, extractSpecsFromHtml } from '@/lib/shopify';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { handle: p.handle } }));
}

const { handle } = Astro.params;
const product = await getProductByHandle(handle!);
if (!product) return Astro.redirect('/targets/');

// Specs: prefer metafields, fall back to parsing descriptionHtml table
const metaSpecs = Object.entries(product.metafields);
const htmlSpecs = extractSpecsFromHtml(product.descriptionHtml);
const specs = metaSpecs.length > 0
  ? metaSpecs.map(([k, v]) => [k.replace(/_/g, ' ').replace(/^\w/, (c) => c.toUpperCase()), v] as [string, string])
  : htmlSpecs;

// Find add-on variant IDs from all products
const allProducts = await getProducts();
const certProduct = allProducts.find((p) => p.handle === 'certificate-ilac');
const fixtureProduct = allProducts.find((p) => p.handle === 'mounting-fixture');
const certVariantId = certProduct?.variants[0]?.id;
const fixtureVariantId = fixtureProduct?.variants[0]?.id;
const certPrice = certProduct?.variants[0]?.price;
const fixturePrice = fixtureProduct?.variants[0]?.price;

const cleanDescription = sanitizeHtml(product.descriptionHtml);
---
<Base title={product.title} section="targets" description={product.description}>
  <div class="container-x flex gap-2 pt-5 text-sm text-ink-soft">
    <a href="/" class="text-ink-soft no-underline">Home</a><span>/</span>
    <a href="/targets/" class="text-ink-soft no-underline">Calibration targets</a><span>/</span>
    <span>{product.title}</span>
  </div>

  <section class="container-x flex flex-wrap gap-14 py-8 md:pb-16">
    {/* Images */}
    <div class="flex min-w-0 flex-1 basis-[520px] flex-col gap-4">
      <div class="aspect-[4/3] rounded-xl bg-ground-panel flex items-center justify-center overflow-hidden">
        {product.image
          ? <img src={product.image} alt={product.title} class="h-full w-full object-cover" />
          : <span class="font-mono text-xs text-ink-soft">[PRODUCT PHOTO]</span>}
      </div>
      {product.images.length > 1 && (
        <div class="grid grid-cols-4 gap-3">
          {product.images.slice(0, 4).map((img, i) => (
            <div class={`aspect-square overflow-hidden rounded-lg bg-ground-panel ${i === 0 ? 'border-2 border-brand' : ''}`}>
              <img src={img.url} alt={img.altText ?? ''} class="h-full w-full object-cover" loading="lazy" />
            </div>
          ))}
        </div>
      )}
    </div>

    {/* Product info + variant picker */}
    <div class="flex min-w-0 flex-1 basis-[420px] flex-col gap-5">
      <span class="eyebrow">In stock · ships from Germany</span>
      <h1 class="h-display m-0 text-[32px] leading-[1.1] md:text-[40px]">{product.title}</h1>
      <p class="m-0 text-base leading-relaxed text-ink-muted">{product.description}</p>

      <VariantPicker
        client:load
        product={product}
        certVariantId={certVariantId}
        fixtureVariantId={fixtureVariantId}
        certPrice={certPrice}
        fixturePrice={fixturePrice}
      />
    </div>
  </section>

  {/* Specs + description */}
  <section class="container-x flex flex-wrap gap-12 pb-16">
    <div class="flex min-w-0 flex-1 basis-[520px] flex-col gap-4">
      {specs && specs.length > 0 ? (
        <>
          <h2 class="h-display m-0 text-2xl">Specifications</h2>
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-[15px]">
              <tbody>
                {specs.map(([k, v]) => (
                  <tr class="border-t border-line last:border-b">
                    <td class="w-2/5 py-3 text-ink-soft">{k}</td>
                    <td class="py-3">{v}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      ) : cleanDescription ? (
        <>
          <h2 class="h-display m-0 text-2xl">Details</h2>
          <div class="prose" set:html={cleanDescription} />
        </>
      ) : null}
    </div>

    <div class="flex min-w-0 flex-1 basis-[320px] flex-col gap-4">
      <div class="card flex flex-col gap-2 bg-ground-alt p-5">
        <strong class="text-[15px]">Not sure about the size?</strong>
        <span class="text-sm text-ink-muted">Run the free selection wizard with your camera and lens.</span>
        <a href="/tools/wizard/" class="text-sm font-semibold">Open wizard →</a>
      </div>
      <div class="card flex flex-col gap-2 bg-ground-alt p-5">
        <strong class="text-[15px]">Need a custom pattern?</strong>
        <span class="text-sm text-ink-muted">Generate any grid, download the PDF and order as custom.</span>
        <a href="/tools/generator/" class="text-sm font-semibold">Open generator →</a>
      </div>
    </div>
  </section>
</Base>
