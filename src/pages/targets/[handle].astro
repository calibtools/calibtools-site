---
import Base from '@/layouts/Base.astro';
import VariantPicker from '@/islands/VariantPicker';
import { getProducts, getProductByHandle, sanitizeHtml } from '@/lib/shopify';
import { kalibrYaml, ros2Yaml, halconDescr } from '@/lib/exportConfig';
import type { PatternSpec } from '@/lib/patterns';
import { getProductFaq } from '@/lib/faq';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { handle: p.handle } }));
}

const { handle } = Astro.params;
const product = await getProductByHandle(handle!);
if (!product) return Astro.redirect('/targets/');

const m = product.metafields;

// Find add-on variant IDs from all products
const allProducts = await getProducts();
const certProduct = allProducts.find((p) => p.handle === 'certificate-ilac');
const fixtureProduct = allProducts.find((p) => p.handle === 'mounting-fixture');
const certVariantId = certProduct?.variants[0]?.id;
const fixtureVariantId = fixtureProduct?.variants[0]?.id;
const certPrice = certProduct?.variants[0]?.price;
const fixturePrice = fixtureProduct?.variants[0]?.price;

const cleanDescription = sanitizeHtml(product.descriptionHtml);

// Eyebrow: lead_time metafield > availableForSale > "Made to order"
// Never show "In stock" for certificate-ilac (it's a service, not physical stock)
const anyAvailable = product.variants.some((v) => v.availableForSale);
const eyebrow = m.lead_time
  ? m.lead_time
  : handle === 'certificate-ilac'
    ? 'Made to order'
    : anyAvailable
      ? 'In stock \u00B7 ships in 1\u20132 days from Germany'
      : 'Made to order';

// --- Grouped specification table ---
type SpecRow = { label: string; value: string };
type SpecGroup = { title: string; rows: SpecRow[] };

const SPEC_LABELS: Record<string, string> = {
  size_mm: 'Board size', squares: 'Grid', square_size_mm: 'Square size',
  marker_size_mm: 'Marker size', dictionary: 'Dictionary', start_id: 'Start ID',
  material: 'Material', thickness_mm: 'Thickness', weight_g: 'Weight',
  corner_radius_mm: 'Corner radius', finish: 'Finish',
  feature_tolerance: 'Feature tolerance', flatness: 'Flatness',
  cte: 'CTE', operating_temp: 'Operating temperature',
  files_included: 'Files included', lead_time: 'Lead time',
};

const SPEC_UNITS: Record<string, string> = {
  size_mm: 'mm', square_size_mm: 'mm', marker_size_mm: 'mm',
  thickness_mm: 'mm', weight_g: 'g', corner_radius_mm: 'mm',
};

function specRow(key: string): SpecRow | null {
  const raw = m[key];
  if (!raw) return null;
  const unit = SPEC_UNITS[key];
  const value = unit && !raw.includes(unit) ? `${raw} ${unit}` : raw;
  return { label: SPEC_LABELS[key] ?? key, value };
}

function specGroup(title: string, keys: string[]): SpecGroup | null {
  const rows = keys.map(specRow).filter((r): r is SpecRow => r !== null);
  return rows.length > 0 ? { title, rows } : null;
}

const specGroups = [
  specGroup('Geometry', ['size_mm', 'squares', 'square_size_mm', 'marker_size_mm', 'dictionary', 'start_id']),
  specGroup('Physical', ['material', 'thickness_mm', 'weight_g', 'corner_radius_mm', 'finish']),
  specGroup('Accuracy', ['feature_tolerance', 'flatness', 'cte', 'operating_temp']),
  specGroup('Deliverables', ['files_included', 'lead_time']),
].filter((g): g is SpecGroup => g !== null);

// --- Downloads ---
const hasPatternData = !!(m.squares && m.square_size_mm);
let configFiles: Array<{ name: string; content: string; mime: string }> = [];

if (hasPatternData) {
  const [rows, cols] = (m.squares ?? '').split(/[x×]/).map((s: string) => Number(s.trim()));
  const square = Number(m.square_size_mm ?? 0);
  const marker = Number(m.marker_size_mm ?? 0);
  const dict = m.dictionary ?? '';
  const startId = Number(m.start_id ?? 0);
  const patternType = dict ? 'ChArUco' : 'Checkerboard';

  if (rows > 0 && cols > 0 && square > 0) {
    const spec: PatternSpec = {
      type: patternType as PatternSpec['type'],
      rows, cols, square, marker, dict,
      paper: 'A4', startId, scaleBar: false,
    };
    const slug = `${handle}-${rows}x${cols}-${square}mm`;
    configFiles = [
      { name: `${slug}.opencv.json`, content: JSON.stringify({ pattern: patternType, rows, cols, square_mm: square, marker_mm: marker, dictionary: dict, start_id: startId, generator: 'Calib.Tools' }, null, 2), mime: 'application/json' },
      { name: `${slug}.kalibr.yaml`, content: kalibrYaml(spec), mime: 'text/yaml' },
      { name: `${slug}.ros2.yaml`, content: ros2Yaml(spec), mime: 'text/yaml' },
      { name: `${slug}.halcon.descr`, content: halconDescr(spec), mime: 'text/plain' },
    ];
  }
}

// --- FAQ ---
const faqItems = getProductFaq(handle!);
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---
<Base title={product.title} section="targets" description={product.description}>
  <div class="container-x flex gap-2 pt-5 text-sm text-ink-soft">
    <a href="/" class="text-ink-soft no-underline">Home</a><span>/</span>
    <a href="/targets/" class="text-ink-soft no-underline">Calibration targets</a><span>/</span>
    <span>{product.title}</span>
  </div>

  <section class="container-x flex flex-wrap gap-14 py-8 md:pb-16">
    {/* Images */}
    <div class="flex min-w-0 flex-1 basis-[520px] flex-col gap-4">
      <div class="aspect-[4/3] rounded-xl bg-ground-panel flex items-center justify-center overflow-hidden">
        {product.image
          ? <img src={product.image} alt={product.title} class="h-full w-full object-cover" />
          : <span class="font-mono text-xs text-ink-soft">[PRODUCT PHOTO]</span>}
      </div>
      {product.images.length > 1 && (
        <div class="grid grid-cols-4 gap-3">
          {product.images.slice(0, 4).map((img, i) => (
            <div class={`aspect-square overflow-hidden rounded-lg bg-ground-panel ${i === 0 ? 'border-2 border-brand' : ''}`}>
              <img src={img.url} alt={img.altText ?? ''} class="h-full w-full object-cover" loading="lazy" />
            </div>
          ))}
        </div>
      )}
    </div>

    {/* Product info + variant picker */}
    <div class="flex min-w-0 flex-1 basis-[420px] flex-col gap-5">
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="h-display m-0 text-[32px] leading-[1.1] md:text-[40px]">{product.title}</h1>
      <p class="m-0 text-base leading-relaxed text-ink-muted">{product.description}</p>

      <VariantPicker
        client:load
        product={product}
        certVariantId={certVariantId}
        fixtureVariantId={fixtureVariantId}
        certPrice={certPrice}
        fixturePrice={fixturePrice}
      />
    </div>
  </section>

  {/* Specs + description */}
  <section class="container-x flex flex-wrap gap-12 pb-16">
    <div class="flex min-w-0 flex-1 basis-[520px] flex-col gap-6">
      {specGroups.length > 0 ? (
        <>
          <h2 class="h-display m-0 text-2xl">Specifications</h2>
          {specGroups.map((group) => (
            <div>
              <h3 class="m-0 pb-2 text-[13px] font-semibold uppercase tracking-[0.08em] text-ink-soft" data-spec-group>{group.title}</h3>
              <div class="overflow-x-auto">
                <table class="w-full border-collapse text-[15px]">
                  <tbody>
                    {group.rows.map((row, i) => (
                      <tr class={`border-t border-line last:border-b ${i % 2 === 1 ? 'bg-ground-alt' : ''}`}>
                        <td class="w-2/5 py-3 text-ink-soft md:table-cell">{row.label}</td>
                        <td class="py-3">{row.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </>
      ) : cleanDescription ? (
        <>
          <h2 class="h-display m-0 text-2xl">Details</h2>
          <div class="prose" set:html={cleanDescription} />
        </>
      ) : null}
    </div>

    <div class="flex min-w-0 flex-1 basis-[320px] flex-col gap-4">
      <div class="card flex flex-col gap-2 bg-ground-alt p-5">
        <strong class="text-[15px]">Not sure about the size?</strong>
        <span class="text-sm text-ink-muted">Run the free selection wizard with your camera and lens.</span>
        <a href="/tools/wizard/" class="text-sm font-semibold">Open wizard →</a>
      </div>
      <div class="card flex flex-col gap-2 bg-ground-alt p-5">
        <strong class="text-[15px]">Need a custom pattern?</strong>
        <span class="text-sm text-ink-muted">Generate any grid, download the PDF and order as custom.</span>
        <a href="/tools/generator/" class="text-sm font-semibold">Open generator →</a>
      </div>
    </div>
  </section>

  {/* Downloads */}
  {(m.datasheet_url || configFiles.length > 0) && (
    <section class="container-x flex flex-col gap-5 pb-16">
      <h2 class="h-display m-0 text-2xl">Downloads</h2>
      <div class="flex flex-wrap gap-3">
        {m.datasheet_url && (
          <a href={m.datasheet_url} target="_blank" rel="noopener" class="btn-outline gap-2 text-sm no-underline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            Datasheet PDF{m.datasheet_rev ? ` (rev ${m.datasheet_rev})` : ''}
          </a>
        )}
        <a href="/downloads/sample-inspection-report/" class="btn-outline gap-2 text-sm no-underline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="12" y1="18" x2="12" y2="12"/><polyline points="9 15 12 18 15 15"/></svg>
          Sample inspection report
        </a>
      </div>
      {configFiles.length > 0 && (
        <div class="flex flex-col gap-2">
          <span class="text-[13px] font-semibold">Config files for this target</span>
          <div class="flex flex-wrap gap-2 font-mono text-[13px]">
            {configFiles.map((f) => (
              <a
                href={`data:${f.mime};charset=utf-8,${encodeURIComponent(f.content)}`}
                download={f.name}
                class="rounded bg-ground-panel px-2.5 py-1.5 text-ink no-underline hover:bg-line"
              >{f.name.split('.').slice(1).join('.')}</a>
            ))}
          </div>
        </div>
      )}
    </section>
  )}

  {/* FAQ */}
  {faqItems.length > 0 && (
    <section class="container-x flex flex-col gap-5 pb-16">
      <h2 class="h-display m-0 text-2xl">Frequently asked questions</h2>
      <div class="flex flex-col divide-y divide-line border-y border-line">
        {faqItems.map((item) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-[15px] font-semibold [&::-webkit-details-marker]:hidden">
              {item.question}
              <span class="shrink-0 text-ink-soft transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="m-0 pt-3 text-[15px] leading-relaxed text-ink-muted">{item.answer}</p>
          </details>
        ))}
      </div>
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    </section>
  )}
</Base>
