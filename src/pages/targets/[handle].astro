---
import Base from '@/layouts/Base.astro';
import VariantPicker from '@/islands/VariantPicker';
import ImageGallery from '@/islands/ImageGallery';
import type { GalleryImageData } from '@/islands/ImageGallery';
import DownloadPicker from '@/islands/DownloadPicker';
import MobileBottomCluster from '@/islands/MobileBottomCluster';
import ProductCard from '@/components/ProductCard.astro';
import { getProducts, getProductByHandle } from '@/lib/shopify';
import { kalibrYaml, kalibrSupported, ros2Yaml, ros2Supported, halconCode, halconSupported } from '@/lib/exportConfig';
import { checkerboardSvg, type PatternSpec } from '@/lib/patterns';
import { getProductFaq } from '@/lib/faq';
import { findDatasheetUrl } from '@/lib/datasheetManifest';
import { WARRANTY_TEXT, COMPLIANCE, PRODUCT_TO_COLLECTION } from '@/lib/constants';
import { getProductImages } from '@/lib/product-images';
import { getImageMetadata } from '@/lib/productImageImports';
import { optimizeProductImage } from '@/lib/optimizeProductImage';
import { Ruler, Plus, Download, Columns2, ArrowRight, ArrowUp, ChevronDown } from 'lucide-astro';
import { getProductData } from '@/lib/productData';
import ReviewsSection from '@/islands/ReviewsSection';
import { LEAD_TIME } from '@/lib/claims';
import Stars from '@/components/Stars';
import Rating from '@/components/Rating.astro';
import { getReviewsForProduct, summarize } from '@/lib/reviews';
import { getImage, Picture } from 'astro:assets';
import homeSetImage from '@/assets/products/brand/home-set.webp';
import { compositeToleranceAtSize, thermalExpansion, FLATNESS_EXPLAINER, ceramicVsCompositeRatio } from '@/lib/specExplainers';
import pkgOpenImage from '@/assets/products/packaging/CT-PK-M_open.webp';
import pkgExplodedImage from '@/assets/products/packaging/CT-PK-M_exploded.webp';
import { compatRows, digitalFiles } from '@/lib/productCompat';
import { QUOTE_ONLY_HANDLES, LAYOUT_ON_ORDER_HANDLES } from '@/lib/constants';
import { skuAnchor, skuTitleFor } from '@/lib/productLongform';
import { splitSpecValue } from '@/lib/specValue';
import { drawingForPartNumber, representativePartNumber } from '@/lib/boardDrawing';
import { caltabGeometry, caltabSvg } from '@/lib/halconCaltab';

/** The datasheet writes ChArUco rows as …-{DICT}; visitors see the default dictionary instead of the placeholder. */
const shownPn = (pn: string) => pn.replace('{DICT}', 'D6');

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { handle: p.handle } }));
}

const { handle } = Astro.params;
const product = await getProductByHandle(handle!);
if (!product) return Astro.redirect('/targets/');

const m = product.metafields;
const productData = getProductData(handle!, m);

// Find add-on variant IDs
const allProducts = await getProducts();
const fixtureProduct = allProducts.find((p) => p.handle === 'mounting-fixture');
const fixtureVariantId = fixtureProduct?.variants[0]?.id;
const fixturePrice = fixtureProduct?.variants[0]?.price;

// descriptionHtml no longer rendered — story from product content replaces it

// Quote-only products: no price, "Request a quote" CTA
const QUOTE_HANDLES = new Set(QUOTE_ONLY_HANDLES);
const quoteOnly = QUOTE_HANDLES.has(handle!);
/** Has list prices, but the layout is agreed first: show the starting price and send the visitor to the quote form. */
const layoutOnOrder = LAYOUT_ON_ORDER_HANDLES.includes(handle!);

// Lead-time eyebrow
const anyAvailable = product.variants.some((v) => v.availableForSale);
const eyebrow = m.lead_time
  ? m.lead_time
  : anyAvailable
    ? LEAD_TIME
    : 'Made to order';

// Product content from collection
const productContent = await getEntry('products', handle!);
const compat = compatRows(handle!, productContent?.data.compat);

// Summary from product content, fallback to positioning
const positioning = productData?.positioning || product.description;
const displaySummary = productContent?.data.summary || positioning;
// SEO description: prefer content seoDescription, then truncated summary
const metaDescription = productContent?.data.seoDescription || (displaySummary.length > 160 ? displaySummary.slice(0, 157) + '...' : displaySummary);

// Spec groups: prefer datasheet, fall back to metafield-based groups
type SpecRow = { label: string; value: string };
type SpecGroup = { title: string; rows: SpecRow[] };

let specGroups: SpecGroup[] = [];
if (productData && productData.specGroups.length > 0) {
  specGroups = productData.specGroups;
  // Inject "Files included" from metafield if the datasheet table lacks it
  const allLabels = specGroups.flatMap(g => g.rows.map(r => r.label));
  const hasFilesRow = allLabels.some(l => l === 'Files included' || l === 'Files');
  if (!hasFilesRow && m.files_included) {
    // Find or create a Deliverables group
    let deliverables = specGroups.find(g => g.title === 'Deliverables');
    if (!deliverables) {
      deliverables = { title: 'Deliverables', rows: [] };
      specGroups.push(deliverables);
    }
    deliverables.rows.push({ label: 'Files included', value: m.files_included });
  }
} else {
  // Fall back to metafield-based groups (existing logic)
  const SPEC_LABELS: Record<string, string> = {
    size_mm: 'Board size', squares: 'Grid', square_size_mm: 'Square size',
    marker_size_mm: 'Marker size', dictionary: 'Dictionary', start_id: 'Start ID',
    material: 'Material', thickness_mm: 'Thickness', weight_g: 'Weight',
    corner_radius_mm: 'Corner radius', finish: 'Finish',
    feature_tolerance: 'Feature tolerance', flatness: 'Flatness',
    cte: 'CTE', operating_temp: 'Operating temperature',
    files_included: 'Files included', lead_time: 'Lead time',
  };
  const SPEC_UNITS: Record<string, string> = {
    size_mm: 'mm', square_size_mm: 'mm', marker_size_mm: 'mm',
    thickness_mm: 'mm', weight_g: 'g', corner_radius_mm: 'mm',
  };
  function specRow(key: string): SpecRow | null {
    const raw = m[key];
    if (!raw) return null;
    const unit = SPEC_UNITS[key];
    const value = unit && !raw.includes(unit) ? `${raw} ${unit}` : raw;
    return { label: SPEC_LABELS[key] ?? key, value };
  }
  function specGroup(title: string, keys: string[]): SpecGroup | null {
    const rows = keys.map(specRow).filter((r): r is SpecRow => r !== null);
    return rows.length > 0 ? { title, rows } : null;
  }
  specGroups = [
    specGroup('Geometry', ['size_mm', 'squares', 'square_size_mm', 'marker_size_mm', 'dictionary', 'start_id']),
    specGroup('Physical', ['material', 'thickness_mm', 'weight_g', 'corner_radius_mm', 'finish']),
    specGroup('Accuracy', ['feature_tolerance', 'flatness', 'cte', 'operating_temp']),
    specGroup('Deliverables', ['files_included', 'lead_time']),
  ].filter((g): g is SpecGroup => g !== null);
}

// Decide-specs chips: resolve keys against specGroups
type KeySpec = { label: string; value: string };
const keySpecs: KeySpec[] = [];
if (productContent?.data.decideSpecs && specGroups.length > 0) {
  const allRows = specGroups.flatMap(g => g.rows);
  for (const key of productContent.data.decideSpecs) {
    const row = allRows.find(r => r.label === key);
    if (row) keySpecs.push({ label: row.label, value: row.value });
  }
} else {
  if (m.feature_tolerance) keySpecs.push({ label: 'Accuracy', value: m.feature_tolerance });
  const substrate = [m.material, m.thickness_mm ? `${m.thickness_mm} mm` : ''].filter(Boolean).join(' \u00B7 ');
  if (substrate) keySpecs.push({ label: 'Substrate', value: substrate });
  const sizeValues = product.variants
    .map((v) => v.selectedOptions.find((o) => o.name === 'Size')?.value)
    .filter(Boolean) as string[];
  if (sizeValues.length > 1) {
    const nums = sizeValues.map((s) => parseInt(s, 10)).filter((n) => n > 0).sort((a, b) => a - b);
    if (nums.length >= 2) keySpecs.push({ label: 'Sizes', value: `${nums[0]}\u2013${nums[nums.length - 1]} mm` });
  } else if (sizeValues.length === 1) {
    keySpecs.push({ label: 'Size', value: sizeValues[0] });
  }
  if (m.flatness) keySpecs.push({ label: 'Flatness', value: m.flatness });
}

// --- Downloads ---
const hasPatternData = !!(m.squares && m.square_size_mm);
let configFiles: Array<{ name: string; content: string; mime: string }> = [];

if (hasPatternData) {
  const [rows, cols] = (m.squares ?? '').split(/[x×]/).map((s: string) => Number(s.trim()));
  const square = Number(m.square_size_mm ?? 0);
  const marker = Number(m.marker_size_mm ?? 0);
  const dict = m.dictionary ?? '';
  const patternType = dict ? 'ChArUco' : 'Checkerboard';

  if (rows > 0 && cols > 0 && square > 0) {
    const spec: PatternSpec = {
      type: patternType as PatternSpec['type'],
      rows, cols, square, marker, dict,
      paper: 'A4', startId: Number(m.start_id ?? 0), scaleBar: false,
    };
    const slug = `${handle}-${rows}x${cols}-${square}mm`;
    configFiles = [
      { name: `${slug}.opencv.json`, content: JSON.stringify({ pattern: patternType, rows, cols, square_mm: square, marker_mm: marker, dictionary: dict, start_id: Number(m.start_id ?? 0), generator: 'Calib.Tools' }, null, 2), mime: 'application/json' },
      ...(kalibrSupported(spec) ? [{ name: `${slug}.kalibr.yaml`, content: kalibrYaml(spec), mime: 'text/yaml' }] : []),
      ...(ros2Supported(spec) ? [{ name: `${slug}.ros2.yaml`, content: ros2Yaml(spec), mime: 'text/yaml' }] : []),
      ...(halconSupported(spec) ? [{ name: `${slug}.halcon.txt`, content: halconCode(spec), mime: 'text/plain' }] : []),
    ];
  }
}

const datasheetUrl = m.datasheet_url || findDatasheetUrl(handle!) || '';

const downloadFiles = [
  ...(datasheetUrl ? [{ name: `${handle}-datasheet${m.datasheet_rev ? `-rev${m.datasheet_rev}` : ''}.pdf`, url: datasheetUrl, mime: 'application/pdf' }] : []),
  ...configFiles.map((f) => ({
    name: f.name,
    url: `data:${f.mime};charset=utf-8,${encodeURIComponent(f.content)}`,
    mime: f.mime,
  })),
];

// --- Product images ---
const catalogImages = getProductImages(handle!);
const galleryImages: GalleryImageData[] = [];

for (const entry of catalogImages) {
  const meta = getImageMetadata(entry.handle, entry.file);
  if (!meta) continue;
  const optimized = await optimizeProductImage(
    meta,
    entry.alt || `Calib.Tools ${product.title} — ${entry.file.replace(/^\d+-/, '').replace(/\.webp$/, '')}`,
  );
  galleryImages.push({ ...optimized, kind: entry.kind, file: entry.file });
}

const hasLocalImages = galleryImages.length > 0;

// Board set image
const isBoardProduct = handle?.includes('charuco') || handle?.includes('checkerboard');
let boardSetImageData: { src: string; srcset: string; width: number; height: number } | undefined;
if (isBoardProduct) {
  const boardSetVariants = await Promise.all(
    [480, 800].map(async (w) => {
      const result = await getImage({ src: homeSetImage, width: w, format: 'webp' });
      return { w, src: result.src };
    }),
  );
  boardSetImageData = {
    src: boardSetVariants[boardSetVariants.length - 1].src,
    srcset: boardSetVariants.map((v) => `${v.src} ${v.w}w`).join(', '),
    width: homeSetImage.width,
    height: homeSetImage.height,
  };
}

// Placeholder render
let placeholderSvg = '';
if (!hasLocalImages && product.images.length === 0 && hasPatternData) {
  const [pRows, pCols] = (m.squares ?? '').split(/[x×]/).map((s: string) => Number(s.trim()));
  const pSquare = Number(m.square_size_mm ?? 0);
  const pMarker = Number(m.marker_size_mm ?? 0);
  const pDict = m.dictionary ?? '';
  const pType = pDict ? 'ChArUco' : 'Checkerboard';
  if (pRows > 0 && pCols > 0 && pSquare > 0) {
    const previewSpec: PatternSpec = {
      type: pType as PatternSpec['type'],
      rows: pRows, cols: pCols, square: pSquare, marker: pMarker, dict: pDict,
      paper: 'A4', startId: Number(m.start_id ?? 0), scaleBar: false,
    };
    placeholderSvg = checkerboardSvg(previewSpec, pCols * pSquare + 20, pRows * pSquare + 20);
  }
}

// Line drawing shown before any photo (DESIGN.md §4): generated from the board geometry, never hand-drawn
let leadDrawing: { svg: string; caption: string } | null = null;
const drawingPn = representativePartNumber(handle!);
const drawingSvg = drawingPn ? drawingForPartNumber(drawingPn) : undefined;
if (drawingPn && drawingSvg) {
  leadDrawing = { svg: drawingSvg, caption: `${drawingPn.replace('{DICT}', 'D6')}, drawn to scale from the board geometry. Dimensions in mm.` };
} else if (handle === 'halcon-composite') {
  leadDrawing = {
    svg: caltabSvg(caltabGeometry({ xNum: 9, yNum: 7, markDist: 30, diameterRatio: 0.5 }), 400, 300),
    caption: 'Example layout on a 400 × 300 mm board: 9 × 7 marks, 30 mm apart. Your layout is agreed with the order.',
  };
}
const hasGallery = hasLocalImages || product.images.length > 0 || !!placeholderSvg;
const hasVisual = hasGallery || !!leadDrawing;

// --- Reviews ---
const productReviews = await getReviewsForProduct(handle!);
const reviewSummary = summarize(productReviews.filter(r => r.status === 'published'));

// --- JSON-LD ---
const siteUrl = 'https://calib.tools';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Calibration targets', item: `${siteUrl}/targets/` },
    { '@type': 'ListItem', position: 3, name: product.title },
  ],
};
// Compute variesBy from product options
// size → schema.org/size; pattern-changing options → schema.org/pattern; others omitted
const PATTERN_OPTIONS = new Set(['dictionary', 'layout', 'pattern']);
const variesBy = [...new Set(
  product.options
    .map((o) => {
      const key = o.name.toLowerCase();
      if (key === 'size') return 'https://schema.org/size';
      if (PATTERN_OPTIONS.has(key)) return 'https://schema.org/pattern';
      return null;
    })
    .filter((v: string | null): v is string => v !== null),
)];

// Price valid until — 1 year from build date
const priceValidUntil = new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString().slice(0, 10);

const productLd: Record<string, any> = {
  '@context': 'https://schema.org', '@type': 'ProductGroup',
  productGroupID: handle,
  name: product.title, description: product.description,
  url: `${siteUrl}${product.url}`,
  brand: { '@type': 'Brand', name: 'Calib.Tools' },
  image: hasLocalImages ? galleryImages.map((img) => `${siteUrl}${img.src}`) : product.images.length > 0 ? product.images.map((img) => img.url) : `${siteUrl}/og/${handle}.png`,
  ...(variesBy.length > 0 && { variesBy }),
};
if (product.variants.length > 0) {
  // Group-level AggregateOffer
  const amounts = product.variants.map((v) => parseFloat(v.priceAmount)).filter((n) => !isNaN(n));
  if (amounts.length > 0) {
    productLd.offers = {
      '@type': 'AggregateOffer',
      lowPrice: Math.min(...amounts).toFixed(2),
      highPrice: Math.max(...amounts).toFixed(2),
      priceCurrency: product.variants[0].currencyCode,
      offerCount: product.variants.length,
      availability: product.variants.some((v) => v.availableForSale) ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      url: `${siteUrl}${product.url}`,
    };
  }
  productLd.hasVariant = product.variants.map((v) => ({
    '@type': 'Product', name: `${product.title} — ${v.title}`, sku: v.sku || undefined,
    offers: { '@type': 'Offer', price: v.priceAmount, priceCurrency: v.currencyCode, priceValidUntil, availability: v.availableForSale ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock', url: `${siteUrl}${product.url}`, seller: { '@type': 'Organization', name: 'Calib.Tools' } },
  }));
} else {
  productLd.offers = { '@type': 'AggregateOffer', lowPrice: product.priceMinAmount, priceCurrency: product.priceMinCurrency, availability: 'https://schema.org/InStock', url: `${siteUrl}${product.url}` };
}
if (reviewSummary.count > 0) {
  productLd.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: reviewSummary.average.toFixed(1),
    reviewCount: reviewSummary.count,
    bestRating: '5',
    worstRating: '1',
  };
  // Up to 5 most recent published reviews
  const recentReviews = productReviews
    .filter(r => r.status === 'published')
    .sort((a, b) => new Date(b.created).getTime() - new Date(a.created).getTime())
    .slice(0, 5);
  if (recentReviews.length > 0) {
    productLd.review = recentReviews.map(r => ({
      '@type': 'Review',
      author: { '@type': 'Person', name: r.author.initials },
      datePublished: r.created.split('T')[0],
      reviewBody: r.body,
      reviewRating: {
        '@type': 'Rating',
        ratingValue: r.stars,
        bestRating: 5,
      },
    }));
  }
}

// ── Spec explainers ("What this means" lines) ──
const isCeramic = handle?.includes('ceramic');
const isComposite = handle?.includes('composite') || handle?.includes('checkerboard');
// Find the largest board size from variants (long side in mm)
const largestSizeMm = (() => {
  const sizes = product.variants
    .map((v) => v.selectedOptions.find((o) => o.name === 'Size')?.value)
    .filter(Boolean)
    .map((s) => {
      const parts = s!.split(/[×x]/i).map((n) => parseInt(n.trim(), 10)).filter((n) => n > 0);
      return Math.max(...parts);
    })
    .filter((n) => n > 0);
  return sizes.length > 0 ? Math.max(...sizes) : 0;
})();

const specExplainers: Record<string, string> = {};
if (largestSizeMm > 0) {
  if (isComposite) {
    specExplainers['Feature tolerance'] = compositeToleranceAtSize(largestSizeMm);
    specExplainers['CTE'] = thermalExpansion('composite', largestSizeMm);
  }
  if (isCeramic) {
    specExplainers['Feature tolerance'] = ceramicVsCompositeRatio();
    specExplainers['CTE'] = thermalExpansion('ceramic', largestSizeMm);
  }
}
if (isComposite || isCeramic) {
  specExplainers['Flatness'] = FLATNESS_EXPLAINER;
}

// Share image: the drawing-sheet card for this product (scripts/generate-placeholders.ts), not a photo
const ogImage = `/og/${handle}.png`;

// Pairs with / Compare
const isAccessory = handle === 'mounting-fixture';
const pairsWith = isAccessory ? [] : [fixtureProduct].filter(Boolean);
let compareProduct: typeof product | null = null;
if (handle?.includes('-composite')) compareProduct = allProducts.find((p) => p.handle === handle.replace('-composite', '-ceramic')) ?? null;
else if (handle?.includes('-ceramic')) compareProduct = allProducts.find((p) => p.handle === handle.replace('-ceramic', '-composite')) ?? null;

const collectionHandle = PRODUCT_TO_COLLECTION[handle!] ?? '';
const collectionEntry = collectionHandle ? await getEntry('collections', collectionHandle) : undefined;
const collectionTitle = collectionEntry?.data.title ?? (collectionHandle ? collectionHandle.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) : '');

// Pairs-with card data
import { getEntry } from 'astro:content';
const pairsWithCardData = new Map<string, { rating: number; count: number; summary?: string; chips?: string[] }>();
for (const p of pairsWith) {
  if (!p) continue;
  const reviews = await getReviewsForProduct(p.handle);
  const s = summarize(reviews.filter(r => r.status === 'published'));
  const pc = await getEntry('products', p.handle);
  pairsWithCardData.set(p.handle, { rating: s.average, count: s.count, summary: pc?.data.summary, chips: pc?.data.chips });
}

// FAQ
const faqItems = getProductFaq(handle!);
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) };

// Ordering tables as written in the datasheet, each row with its price
const priceFor = (pn: string) => {
  const base = (x: string) => x.split('-').slice(0, 4).join('-');
  const v = product.variants.find((x) => x.sku && pn === x.sku) ?? product.variants.find((x) => x.sku && base(pn) === base(x.sku));
  return v?.price ?? '';
};
const orderingTables = (productData?.orderingTables ?? []).map((t) => {
  const sizeCol = t.header.findIndex((h) => /^size/i.test(h));
  return {
    title: t.title,
    header: t.header,
    rows: t.rows.map((cells) => ({
      pn: cells[0],
      cells,
      price: priceFor(cells[0]),
      selectSize: sizeCol >= 0 ? (cells[sizeCol] ?? '').split(/\s*[×x]\s*/)[0]?.trim() : '',
    })),
  };
});
const anyPrice = orderingTables.some((t) => t.rows.some((r) => r.price));
const isCharuco = handle!.includes('charuco');

// Long-form body (markdown) and on-page links
const longform = productContent ? await productContent.render() : null;
const LongformContent = longform?.Content;
const hasLongform = !!longform && longform.headings.some((h) => h.depth === 2);
const skuNotes = productContent?.data.skus ?? [];
const relatedTargets = productContent?.data.relatedTargets ?? [];
const relatedGuides = productContent?.data.relatedGuides ?? [];
const hasSkuTitles = orderingTables.some((t) => t.rows.some((r) => skuTitleFor(r.pn, skuNotes)));
const quickLinks = hasLongform
  ? [
      ...(orderingTables.length > 0 ? [{ href: '#sizes', text: 'Sizes and part numbers' }] : []),
      ...longform!.headings.filter((h) => h.depth === 2).map((h) => ({ href: `#${h.slug}`, text: h.text })),
      ...(relatedTargets.length + relatedGuides.length > 0 ? [{ href: '#related', text: 'Related targets' }] : []),
      ...(specGroups.length > 0 ? [{ href: '#specifications', text: 'Specifications' }] : []),
      ...(faqItems.length > 0 ? [{ href: '#faq', text: 'FAQ' }] : []),
    ]
  : [];
---
<Base
  title={productContent?.data.seoTitle ?? product.title}
  section="targets"
  description={metaDescription}
  jsonLd={[breadcrumbLd, productLd]}
  ogImage={ogImage}
  preloadImages={hasLocalImages ? [{
    href: galleryImages[0].src,
    type: 'image/avif',
    srcset: galleryImages[0].sources.find((s) => s.type === 'image/avif')?.srcset,
    sizes: '(max-width: 640px) 100vw, (max-width: 1024px) 60vw, 520px',
  }] : undefined}
>
  {/* Breadcrumb */}
  <nav class="container-x flex flex-wrap gap-x-2 gap-y-1 pt-5 text-sm text-ink-soft" aria-label="Breadcrumb">
    <a href="/" class="text-ink-soft no-underline shrink-0 min-h-[44px] md:min-h-[24px] flex items-center">Home</a><span class="flex items-center">/</span>
    <a href="/targets/" class="text-ink-soft no-underline shrink-0 min-h-[44px] md:min-h-[24px] flex items-center">Calibration targets</a><span class="flex items-center">/</span>
    {collectionHandle && (
      <><a href={`/targets/collection/${collectionHandle}/`} class="text-ink-soft no-underline shrink-0 min-h-[44px] md:min-h-[24px] flex items-center">{collectionTitle}</a><span class="flex items-center">/</span></>
    )}
    <span class="text-ink shrink-0 min-h-[44px] md:min-h-[24px] flex items-center">{product.title}</span>
  </nav>

  {/* ── Buy box ── */}
  <section class="container-x flex flex-wrap gap-14 py-8 md:pb-16">
    {/* Gallery */}
    {hasVisual && (
      <div class="flex min-w-0 flex-1 basis-[520px] flex-col gap-4">
        {leadDrawing && (
          <figure class="card bracket m-0 flex flex-col gap-3 p-5" data-lead-drawing>
            <div class="fit-svg flex aspect-[4/3] w-full items-center justify-center" set:html={leadDrawing.svg} />
            <figcaption class="font-mono text-[12px] leading-snug text-ink-soft">{leadDrawing.caption}</figcaption>
          </figure>
        )}
        {hasGallery && (
          <ImageGallery
            client:load
            images={hasLocalImages ? galleryImages : undefined}
            shopifyImages={!hasLocalImages ? product.images : undefined}
            placeholderSvg={placeholderSvg}
            title={product.title}
          />
        )}
      </div>
    )}

    {/* Product info */}
    <div class:list={['flex min-w-0 flex-1 basis-[420px] flex-col gap-5', !hasVisual && 'max-w-[760px]']} data-buy-box>
      {/* Badges */}
      <div class="flex flex-wrap gap-2">
        <span class="badge text-brand-dark">{eyebrow}</span>
        <span class="badge text-ink">Measured before it ships</span>
      </div>

      {/* Arrived from the generator with a matching stock target */}
      <p id="from-generator" class="hidden m-0 rounded border border-line bg-ground-alt px-4 py-3 text-sm">The options below are preselected to match the pattern you made in the generator.</p>
      <script>
        if (new URLSearchParams(location.search).get('from') === 'generator') {
          const el = document.getElementById('from-generator');
          el?.classList.remove('hidden');
        }
      </script>

      {/* h1 */}
      <h1 class="h-display m-0 text-[28px] leading-[1.1] md:text-[36px]">{product.title}</h1>

      {/* Review summary */}
      {reviewSummary.count > 0 ? (
        <Rating average={reviewSummary.average} count={reviewSummary.count} href="#reviews" size={14} />
      ) : (
        <a href="#reviews" class="inline-flex items-center gap-2 text-sm text-ink-muted no-underline hover:text-ink min-h-[24px]">
          <Stars client:load rating={0} size={14} />
          <span>No reviews yet · <span class="text-brand-dark">how reviews work ↓</span></span>
        </a>
      )}

      {/* Summary */}
      <p class="m-0 text-[17px] leading-relaxed text-ink-muted">{displaySummary}</p>

      {/* Key-specs strip */}
      {keySpecs.length > 0 && (
        <dl class:list={['m-0 grid grid-cols-1 gap-px border border-line bg-line sm:grid-cols-2', keySpecs.length === 1 ? 'sm:grid-cols-1' : keySpecs.length === 2 ? 'md:grid-cols-2' : keySpecs.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-4']}>
          {keySpecs.map((ks) => (
            <div class="flex flex-col gap-1 bg-sheet p-3">
              <dt class="spec-label">{ks.label}</dt>
              <dd class="m-0 flex flex-col gap-1">
                <span class="font-mono text-[16px] font-medium leading-snug text-ink">{splitSpecValue(ks.value).value}</span>
                {splitSpecValue(ks.value).cond && <span class="spec-cond">{splitSpecValue(ks.value).cond}</span>}
              </dd>
            </div>
          ))}
        </dl>
      )}

      {/* VariantPicker (price, selectors, add-ons, qty, cart, assurances) */}
      {quoteOnly ? (
        <div class="flex flex-col gap-4 rounded-xl border border-line bg-ground-alt p-6">
          {layoutOnOrder ? (
            <p class="m-0 text-sm text-ink-muted">{product.priceFrom ? `From ${product.priceFrom}, depending on size. ` : ''}The number of marks and their spacing are agreed with you before the plate is made, so this plate is ordered through a quote.</p>
          ) : (
            <p class="m-0 text-sm text-ink-muted">Specifications shown are target values. Contact us for pricing and lead times.</p>
          )}
          <a href={`/quote/?product=${encodeURIComponent(product.title)}`} class="btn-md btn-primary text-center no-underline">Request a quote</a>
        </div>
      ) : (
        <VariantPicker
          client:load
          product={product}
          fixtureVariantId={fixtureVariantId}
          fixturePrice={fixturePrice}
          boardSetImage={boardSetImageData}
        />
      )}
    </div>
  </section>

  {/* ── Story ── */}
  {productContent?.data.story && (
    <div class="container-x pb-8 md:pb-12">
      <div class="max-w-[640px] text-[15px] leading-relaxed text-ink-muted whitespace-pre-line">
        {productContent.data.story}
      </div>
    </div>
  )}

  {/* ── On this page: collapsed on mobile, open grid on desktop ── */}
  {quickLinks.length > 0 && (
    <nav class="container-x pb-8 md:pb-12" aria-label="On this page">
      <details class="group border-b border-line md:hidden">
        <summary class="flex min-h-[48px] cursor-pointer list-none items-center justify-between font-mono text-[12px] uppercase tracking-[0.16em] text-brand-dark [&::-webkit-details-marker]:hidden">
          On this page · {quickLinks.length} sections
          <ChevronDown size={20} stroke-width={2} class="text-ink transition-transform group-open:rotate-180" aria-hidden="true" />
        </summary>
        <ol class="m-0 list-none p-0 pb-3">
          {quickLinks.map((l, i) => (
            <li><a href={l.href} class="flex min-h-[40px] items-center gap-3 text-[15px] text-ink no-underline">{l.text}</a></li>
          ))}
        </ol>
      </details>
      <div class="hidden md:block">
        <h2 class="m-0 pb-3 font-mono text-[12px] uppercase tracking-[0.16em] text-brand-dark">On this page</h2>
        <ol class="m-0 grid list-none grid-cols-2 gap-x-8 gap-y-1 p-0 lg:grid-cols-3">
          {quickLinks.map((l, i) => (
            <li><a href={l.href} class="flex min-h-[32px] items-center gap-3 text-[15px] text-ink no-underline hover:text-brand-dark">{l.text}</a></li>
          ))}
        </ol>
      </div>
    </nav>
  )}

  {/* ── Sizes and part numbers ── */}
  {orderingTables.length > 0 && (
    <section id="sizes" class="container-x flex scroll-mt-24 flex-col gap-5 pb-12 md:pb-16">
      <h2 class="h-display m-0 text-[20px] md:text-2xl">Sizes and part numbers</h2>
      {orderingTables.map((t) => (
        <div class="flex flex-col gap-3">
          {t.title && <h3 class="m-0 text-[16px] font-semibold">{t.title}</h3>}
          {/* Mobile: one card per part number */}
          <ul class="m-0 flex list-none flex-col p-0 md:hidden">
            {t.rows.map((row) => (
              <li id={`m-${skuAnchor(row.pn)}`} class="flex items-start justify-between gap-4 border-t border-line py-4 last:border-b" data-select-size={row.selectSize}>
                <div class="flex min-w-0 flex-col gap-1">
                  <span class="font-mono text-[13px] font-semibold text-brand-dark">{shownPn(row.pn)}</span>
                  {skuTitleFor(row.pn, skuNotes) && <span class="text-[14px] text-ink">{skuTitleFor(row.pn, skuNotes)}</span>}
                  <span class="text-[13px] text-ink-muted">{row.cells.slice(1).filter(Boolean).join(' · ')}</span>
                </div>
                {row.price && <span class="shrink-0 font-mono text-[14px] font-semibold">{row.price}</span>}
              </li>
            ))}
          </ul>
          <div class="hidden overflow-x-auto md:block">
            <table class={`w-full ${hasSkuTitles ? 'min-w-[900px]' : 'min-w-[640px]'} border-collapse border border-line bg-sheet text-[14px]`}>
              <thead>
                <tr class="bg-brand-tint text-left font-mono text-[12px] font-medium uppercase tracking-[0.04em] text-brand-dark">
                  <th class="py-2.5 px-3 font-medium">{t.header[0]}</th>
                  {hasSkuTitles && <th class="py-2.5 px-3 font-medium">Description</th>}
                  {t.header.slice(1).map((h) => <th class="py-2.5 px-3 font-medium">{h}</th>)}
                  {anyPrice && <th class="py-2.5 px-3 text-right font-medium">Price</th>}
                </tr>
              </thead>
              <tbody>
                {t.rows.map((row, i) => (
                  <tr id={skuAnchor(row.pn)} class={`scroll-mt-24 border-t border-line cursor-pointer hover:bg-ground-alt/60 target:bg-brand/10 ${i % 2 === 1 ? 'bg-ground-alt/50' : ''}`} data-select-size={row.selectSize}>
                    <td class="whitespace-nowrap py-3 px-3 font-mono text-[13px] text-brand-dark">{shownPn(row.pn)}</td>
                    {hasSkuTitles && <td class="py-3 px-3 text-[14px] text-ink">{skuTitleFor(row.pn, skuNotes) ?? ''}</td>}
                    {row.cells.slice(1).map((c, ci) => <td class={`py-3 px-3 ${ci === 0 ? 'whitespace-nowrap' : 'font-mono text-[13px]'}`}>{c}</td>)}
                    {anyPrice && <td class="py-3 px-3 text-right font-mono text-[13px] font-semibold">{row.price}</td>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
      <p class="m-0 text-[13px] text-ink-muted">{isCharuco ? 'Part numbers are shown with the default dictionary, D6 (DICT_6X6_250). Replace D6 with D5 (DICT_5X5_100), D4 (DICT_4X4_50) or T36 (AprilTag 36h11) for the others. Start ID 0, row-major, OpenCV ≥ 4.6 placement. ' : ''}Larger sizes and other grids on request.</p>
    </section>
  )}

  {/* Part-number links (#CT-…) point at table rows; on mobile the table is hidden, so jump to the matching card. */}
  <script>
    function jumpToCard() {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id.startsWith('CT-')) return;
      const row = document.getElementById(id);
      const card = document.getElementById(`m-${id}`);
      if (!card || (row && row.offsetParent !== null)) return;
      document.querySelectorAll('[data-sku-hit]').forEach((el) => { el.classList.remove('bg-brand/10'); el.removeAttribute('data-sku-hit'); });
      card.classList.add('bg-brand/10');
      card.setAttribute('data-sku-hit', '');
      card.scrollIntoView({ block: 'center' });
    }
    window.addEventListener('hashchange', jumpToCard);
    jumpToCard();
  </script>

  {/* ── Long-form product content: article + related column (after the article on mobile) ── */}
  {hasLongform && LongformContent && (
    <section id="overview" class="container-x flex flex-wrap items-start gap-x-20 gap-y-12 pb-12 md:pb-16">
      <article class="prose-calib flex min-w-0 max-w-[760px] flex-1 basis-[560px] flex-col gap-5 [&_h2]:scroll-mt-24">
        <LongformContent />
      </article>
      {(relatedTargets.length > 0 || relatedGuides.length > 0) && (
        <aside id="related" class="flex w-full scroll-mt-24 flex-col gap-8 lg:w-[360px] lg:shrink-0">
          {[{ title: 'Related targets', items: relatedTargets }, { title: 'Guides', items: relatedGuides }].filter((g) => g.items.length > 0).map((g) => (
            <div>
              <h2 class="m-0 pb-1 font-mono text-[12px] uppercase tracking-[0.16em] text-brand-dark">{g.title}</h2>
              <ul class="m-0 list-none p-0">
                {g.items.map((it) => (
                  <li class="border-b border-line">
                    <a href={it.href} class="flex flex-col gap-1 py-3.5 no-underline">
                      <span class="text-[16px] font-medium text-brand-dark">{it.label} →</span>
                      <span class="text-[13px] text-ink-muted">{it.note}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </aside>
      )}
    </section>
  )}

  {/* ── Details accordion + sidebar ── */}
  <section class="container-x flex flex-wrap gap-12 pb-16">
    {/* Left column: accordions */}
    <div class="flex min-w-0 flex-[2] basis-[520px] flex-col divide-y divide-line border-y border-line">

      {/* 1. Specifications — always visible, never in disclosure */}
      {specGroups.length > 0 && (
        <section id="specifications" class="flex flex-col gap-6 pb-6 border-b border-line">
          <h2 class="flex items-center gap-3 pt-5 text-[20px] font-semibold">
            <Ruler size={22} stroke-width={1.6} class="text-ink-soft" aria-hidden="true" />
            Specifications
          </h2>
          {specGroups.map((group) => (
            <div>
              <h3 class="m-0 pb-2 font-mono text-[12px] uppercase tracking-[0.16em] text-brand-dark">{group.title}</h3>
              <table class="w-full border-collapse text-[14px]">
                <tbody>
                  {group.rows.map((row, i) => (
                    <>
                      <tr class={`border-t border-line ${i % 2 === 1 ? 'bg-ground-alt' : ''}`}>
                        <td class="w-[38%] py-2.5 pr-3 text-ink-muted">{row.label}</td>
                        <td class="py-2.5 font-mono text-[14px]">{row.value}</td>
                      </tr>
                      {specExplainers[row.label] && (
                        <tr class={i % 2 === 1 ? 'bg-ground-alt' : ''}>
                          <td colspan="2" class="px-3 pb-2.5 text-[12px] italic text-ink-muted" data-explainer>{specExplainers[row.label]}</td>
                        </tr>
                      )}
                    </>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
          {productData && (
            <p class="m-0 text-[13px] text-ink-soft">
              Values at 20&nbsp;&deg;C unless stated. Full tolerances in datasheet <code class="text-[12px]">{productData.datasheetCode}</code> rev&nbsp;{productData.rev}.
            </p>
          )}
        </section>
      )}

      {/* 2. What's in the box & files */}
      <details class="group" id="in-the-box">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[20px] font-semibold [&::-webkit-details-marker]:hidden">
          <span>What&rsquo;s in the box &amp; files</span>
          <Plus size={22} stroke-width={1.6} class="shrink-0 text-ink-soft transition-transform group-open:rotate-45" aria-hidden="true" />
        </summary>
        <div class="flex flex-col gap-6 pb-6">
          {isBoardProduct && (
            <div class="grid grid-cols-2 gap-3">
              <button type="button" class="overflow-hidden rounded border border-line" data-lightbox-trigger data-lightbox-src={pkgOpenImage.src}>
                <Picture
                  src={pkgOpenImage}
                  widths={[280, 400]}
                  formats={['avif', 'webp']}
                  alt="Calib.Tools packaging — mailer box open, showing the board in closed-cell foam insert"
                  class="w-full"
                />
              </button>
              <button type="button" class="overflow-hidden rounded border border-line" data-lightbox-trigger data-lightbox-src={pkgExplodedImage.src}>
                <Picture
                  src={pkgExplodedImage}
                  widths={[280, 400]}
                  formats={['avif', 'webp']}
                  alt="Calib.Tools packaging — exploded view showing box, foam inserts and board"
                  class="w-full"
                />
              </button>
            </div>
          )}
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="flex flex-col gap-2 text-[15px]">
              <strong class="text-[13px] uppercase tracking-[0.08em] text-ink-muted">In the box</strong>
              <ul class="m-0 flex flex-col gap-1.5 pl-4 text-[15px]">
                {quoteOnly ? (
                  <>
                    <li>Target as specified in your quote</li>
                    <li>Datasheet with the target geometry</li>
                  </>
                ) : isBoardProduct ? (
                  <>
                    <li>Calibration board</li>
                    <li>Datasheet</li>
                    <li>Download card for pattern files</li>
                    <li>Tamper seal with the serial number</li>
                  </>
                ) : (
                  <>
                    <li>Calibration board in protective case</li>
                    <li>Edge label with serial number</li>
                  </>
                )}
              </ul>
              {isBoardProduct && (
                <p class="m-0 text-[14px] leading-relaxed text-ink-muted">
                  Self-locking mailer with closed-cell foam inserts. Box size S/M/L by board size.
                </p>
              )}
            </div>
            <div class="flex flex-col gap-2 text-[15px]">
              <strong class="text-[13px] uppercase tracking-[0.08em] text-ink-muted">Digital files</strong>
              <ul class="m-0 flex flex-col gap-1.5 pl-4 text-[15px]">
                {digitalFiles(handle!).map((f) => <li>{f}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </details>

      {/* 3. Compatibility */}
      {compat.length > 0 && (
      <details class="group" id="compatibility">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[20px] font-semibold [&::-webkit-details-marker]:hidden">
          <span>Compatibility</span>
          <Plus size={22} stroke-width={1.6} class="shrink-0 text-ink-soft transition-transform group-open:rotate-45" aria-hidden="true" />
        </summary>
        <table class="mb-6 w-full border-collapse text-[14px]">
          <tbody>
            {compat.map(({ tool, note }, i) => (
              <tr class={`border-t border-line last:border-b ${i % 2 === 1 ? 'bg-ground-alt' : ''}`}>
                <td class="w-[38%] py-2.5 pr-3 font-semibold">{tool}</td>
                <td class="py-2.5 font-mono text-[14px] text-ink-muted">{note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
      )}

      {/* 4. Measurement & certificate */}
      <details class="group" id="inspection">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[20px] font-semibold [&::-webkit-details-marker]:hidden">
          <span>Measurement &amp; certificate</span>
          <Plus size={22} stroke-width={1.6} class="shrink-0 text-ink-soft transition-transform group-open:rotate-45" aria-hidden="true" />
        </summary>
        <div class="flex flex-col gap-4 pb-6 text-[15px] leading-relaxed text-ink-muted">
          <p class="m-0">
            <strong class="text-ink">Measured before it ships</strong> &mdash; every board is measured on equipment checked against a golden-sample reference for its material and process. Tolerances on the datasheet are what we measure against.
          </p>
          <div class="flex flex-col gap-2 rounded border border-line bg-ground-alt p-4 text-[13px] text-ink-soft">
            <p class="m-0"><strong>Measurement uncertainty</strong> &mdash; a quantified range within which the true value lies at a stated confidence level. An uncertainty can be stated for any properly performed measurement, including in-house inspections.</p>
          </div>
        </div>
      </details>

      {/* 5. Shipping, returns & warranty */}
      <details class="group" id="shipping">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[20px] font-semibold [&::-webkit-details-marker]:hidden">
          <span>Shipping, returns &amp; warranty</span>
          <Plus size={22} stroke-width={1.6} class="shrink-0 text-ink-soft transition-transform group-open:rotate-45" aria-hidden="true" />
        </summary>
        <table class="mb-6 w-full border-collapse text-[14px]">
          <tbody>
            {([
              ['Lead time', m.lead_time || LEAD_TIME],
              ['Shipping', 'Tracked express from the factory. Import VAT and duties are settled at import (DAP) unless agreed otherwise.'],
              ['Returns', '30 days, unused, in original case.'],
              ['Warranty', '2 years against manufacturing defects.'],
            ] as [string, string][]).map(([label, value], i) => (
              <tr class={`border-t border-line last:border-b ${i % 2 === 1 ? 'bg-ground-alt' : ''}`}>
                <td class="w-[38%] py-2.5 pr-3 text-ink-muted">{label}</td>
                <td class="py-2.5 text-[14px]">{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>

      {/* 6. FAQ */}
      {faqItems.length > 0 && (
        <details class="group" id="faq">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[20px] font-semibold [&::-webkit-details-marker]:hidden">
            <span>Frequently asked questions</span>
            <Plus size={22} stroke-width={1.6} class="shrink-0 text-ink-soft transition-transform group-open:rotate-45" aria-hidden="true" />
          </summary>
          <div class="flex flex-col divide-y divide-line pb-6">
            {faqItems.map((item) => (
              <div class="py-3">
                <strong class="text-[15px]">{item.question}</strong>
                <p class="m-0 pt-2 text-[15px] leading-relaxed text-ink-muted">{item.answer}</p>
              </div>
            ))}
          </div>
          <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
        </details>
      )}
    </div>

    {/* Right column: sidebar cards */}
    <div class="flex min-w-0 flex-1 basis-[280px] flex-col gap-4">
      {/* Downloads */}
      {downloadFiles.length > 0 && (
        <div class="card flex flex-col gap-3 bg-ground-alt p-5">
          <strong class="flex items-center gap-2 text-[15px]"><Download size={20} stroke-width={1.6} class="text-brand" aria-hidden="true" />Downloads</strong>
          <DownloadPicker client:load files={downloadFiles} />
        </div>
      )}

      {/* Size wizard */}
      <div class="card flex flex-col gap-2 bg-ground-alt p-5">
        <strong class="flex items-center gap-2 text-[15px]">Not sure about the size?</strong>
        <span class="text-sm text-ink-muted">Run the free selection wizard with your camera and lens.</span>
        <a href="/tools/wizard/" class="text-sm font-semibold min-h-[44px] md:min-h-[24px] inline-flex items-center">Open wizard <ArrowRight size={14} stroke-width={1.6} class="inline" aria-hidden="true" /></a>
      </div>

      {/* Compare material */}
      {compareProduct && (
        <div class="card flex flex-col gap-2 bg-ground-alt p-5">
          <strong class="flex items-center gap-2 text-[15px]"><Columns2 size={20} stroke-width={1.6} class="text-brand" aria-hidden="true" />Compare with {compareProduct.title}</strong>
          <span class="text-sm text-ink-muted">{handle?.includes('composite') ? 'Higher accuracy, smaller sizes.' : `Larger sizes from ${compareProduct!.priceFrom}, more affordable.`}</span>
          <a href={compareProduct.url} class="text-sm font-semibold min-h-[44px] md:min-h-[24px] inline-flex items-center">View {compareProduct.title} <ArrowRight size={14} stroke-width={1.6} class="inline" aria-hidden="true" /></a>
        </div>
      )}

      {/* Request a quote */}
      <div class="card flex flex-col gap-2 bg-ground-alt p-5">
        <strong class="flex items-center gap-2 text-[15px]">Need a quote?</strong>
        <span class="text-sm text-ink-muted">Reply within one business day.</span>
        <a href="/quote/" class="text-sm font-semibold min-h-[44px] md:min-h-[24px] inline-flex items-center">Request a quote <ArrowRight size={14} stroke-width={1.6} class="inline" aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  {/* ── Reviews ── */}
  <ReviewsSection client:load reviews={productReviews} handle={handle!} />

  {/* ── Pairs with ── */}
  {pairsWith.length > 0 && (
    <section class="container-x flex flex-col gap-5 pb-16">
      <h2 class="h-display m-0 text-2xl">Pairs with</h2>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        {pairsWith.map((p) => p && (() => {
          const cd = pairsWithCardData.get(p.handle);
          return (
            <ProductCard
              href={p.url}
              title={p.title}
              summary={cd?.summary}
              sub={p.description}
              from={p.priceFrom}
              image={p.image}
              placeholder={p.title}
              rating={cd?.rating}
              reviewCount={cd?.count}
              chips={cd?.chips}
            />
          );
        })())}
      </div>
    </section>
  )}

  {/* Back to family */}
  {collectionHandle && (
    <section class="container-x pb-16">
      <a href={`/targets/collection/${collectionHandle}/`} class="text-sm font-semibold no-underline min-h-[44px] md:min-h-[24px] inline-flex items-center"><ArrowUp size={14} stroke-width={1.6} class="inline" aria-hidden="true" /> All {collectionTitle.toLowerCase()}</a>
    </section>
  )}

  {!quoteOnly && (
    <MobileBottomCluster slot="mobile-cluster" client:load mode="add-to-cart" defaultPrice={product.priceFrom} />
  )}
</Base>

<script>
  // Update URL hash when a disclosure is toggled
  document.querySelectorAll('details[id]').forEach((d) => {
    d.addEventListener('toggle', () => {
      if ((d as HTMLDetailsElement).open) {
        history.replaceState(null, '', `#${d.id}`);
      }
    });
  });

  // Ordering table row click → select size in VariantPicker
  document.querySelectorAll('[data-select-size]').forEach((row) => {
    row.addEventListener('click', () => {
      const size = (row as HTMLElement).dataset.selectSize;
      if (size) {
        window.dispatchEvent(new CustomEvent('select-size', { detail: { size } }));
      }
    });
  });
</script>
