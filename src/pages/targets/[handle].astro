---
import Base from '@/layouts/Base.astro';
import VariantPicker from '@/islands/VariantPicker';
import ImageGallery from '@/islands/ImageGallery';
import type { GalleryImageData } from '@/islands/ImageGallery';
import DownloadPicker from '@/islands/DownloadPicker';
import MobileBottomCluster from '@/islands/MobileBottomCluster';
import ProductCard from '@/components/ProductCard.astro';
import { getProducts, getProductByHandle, sanitizeHtml } from '@/lib/shopify';
import { kalibrYaml, ros2Yaml, halconDescr } from '@/lib/exportConfig';
import { checkerboardSvg, type PatternSpec } from '@/lib/patterns';
import { getProductFaq } from '@/lib/faq';
import { findDatasheetUrl } from '@/lib/datasheetManifest';
import { WARRANTY_TEXT, COMPLIANCE, PRODUCT_TO_COLLECTION } from '@/lib/constants';
import { getProductImages } from '@/lib/product-images';
import { getImageMetadata } from '@/lib/productImageImports';
import { optimizeProductImage } from '@/lib/optimizeProductImage';
import { Ruler, Package, Plug, CircleDot, Truck, HelpCircle, Plus, Download, Wand2, Columns2, MessageSquare, ArrowRight, ArrowUp, Clock, FileCheck as FileCheckIcon } from 'lucide-astro';
import { getProductData } from '@/lib/productData';
import ReviewsSection from '@/islands/ReviewsSection';
import Stars from '@/components/Stars';
import { getReviewsForProduct, summarize } from '@/lib/reviews';
import { getImage } from 'astro:assets';
import homeSetImage from '@/assets/products/brand/home-set.webp';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((p) => ({ params: { handle: p.handle } }));
}

const { handle } = Astro.params;
const product = await getProductByHandle(handle!);
if (!product) return Astro.redirect('/targets/');

const m = product.metafields;
const productData = getProductData(handle!, m);

// Find add-on variant IDs
const allProducts = await getProducts();
const certProduct = allProducts.find((p) => p.handle === 'certificate-ilac');
const fixtureProduct = allProducts.find((p) => p.handle === 'mounting-fixture');
const certVariantId = certProduct?.variants[0]?.id;
const fixtureVariantId = fixtureProduct?.variants[0]?.id;
const certPrice = certProduct?.variants[0]?.price;
const fixturePrice = fixtureProduct?.variants[0]?.price;

const cleanDescription = sanitizeHtml(product.descriptionHtml);

// Lead-time eyebrow
const anyAvailable = product.variants.some((v) => v.availableForSale);
const eyebrow = m.lead_time
  ? m.lead_time
  : handle === 'certificate-ilac'
    ? 'Made to order'
    : anyAvailable
      ? 'Made to order \u00B7 ships in 2\u20133 weeks'
      : 'Made to order';

// Positioning: datasheet first sentence → product.description
const positioning = productData?.positioning || product.description;

// Key-specs strip cells
type KeySpec = { label: string; value: string };
const keySpecs: KeySpec[] = [];
if (m.feature_tolerance) keySpecs.push({ label: 'Accuracy', value: m.feature_tolerance });
const substrate = [m.material, m.thickness_mm ? `${m.thickness_mm} mm` : ''].filter(Boolean).join(' \u00B7 ');
if (substrate) keySpecs.push({ label: 'Substrate', value: substrate });
// Sizes: min–max from variant size options
const sizeValues = product.variants
  .map((v) => v.selectedOptions.find((o) => o.name === 'Size')?.value)
  .filter(Boolean) as string[];
if (sizeValues.length > 1) {
  const nums = sizeValues.map((s) => parseInt(s, 10)).filter((n) => n > 0).sort((a, b) => a - b);
  if (nums.length >= 2) keySpecs.push({ label: 'Sizes', value: `${nums[0]}\u2013${nums[nums.length - 1]} mm` });
} else if (sizeValues.length === 1) {
  keySpecs.push({ label: 'Size', value: sizeValues[0] });
}
if (m.flatness) keySpecs.push({ label: 'Flatness', value: m.flatness });

// Spec groups: prefer datasheet, fall back to metafield-based groups
type SpecRow = { label: string; value: string };
type SpecGroup = { title: string; rows: SpecRow[] };

let specGroups: SpecGroup[] = [];
if (productData && productData.specGroups.length > 0) {
  specGroups = productData.specGroups;
} else {
  // Fall back to metafield-based groups (existing logic)
  const SPEC_LABELS: Record<string, string> = {
    size_mm: 'Board size', squares: 'Grid', square_size_mm: 'Square size',
    marker_size_mm: 'Marker size', dictionary: 'Dictionary', start_id: 'Start ID',
    material: 'Material', thickness_mm: 'Thickness', weight_g: 'Weight',
    corner_radius_mm: 'Corner radius', finish: 'Finish',
    feature_tolerance: 'Feature tolerance', flatness: 'Flatness',
    cte: 'CTE', operating_temp: 'Operating temperature',
    files_included: 'Files included', lead_time: 'Lead time',
  };
  const SPEC_UNITS: Record<string, string> = {
    size_mm: 'mm', square_size_mm: 'mm', marker_size_mm: 'mm',
    thickness_mm: 'mm', weight_g: 'g', corner_radius_mm: 'mm',
  };
  function specRow(key: string): SpecRow | null {
    const raw = m[key];
    if (!raw) return null;
    const unit = SPEC_UNITS[key];
    const value = unit && !raw.includes(unit) ? `${raw} ${unit}` : raw;
    return { label: SPEC_LABELS[key] ?? key, value };
  }
  function specGroup(title: string, keys: string[]): SpecGroup | null {
    const rows = keys.map(specRow).filter((r): r is SpecRow => r !== null);
    return rows.length > 0 ? { title, rows } : null;
  }
  specGroups = [
    specGroup('Geometry', ['size_mm', 'squares', 'square_size_mm', 'marker_size_mm', 'dictionary', 'start_id']),
    specGroup('Physical', ['material', 'thickness_mm', 'weight_g', 'corner_radius_mm', 'finish']),
    specGroup('Accuracy', ['feature_tolerance', 'flatness', 'cte', 'operating_temp']),
    specGroup('Deliverables', ['files_included', 'lead_time']),
  ].filter((g): g is SpecGroup => g !== null);
}

// --- Downloads ---
const hasPatternData = !!(m.squares && m.square_size_mm);
let configFiles: Array<{ name: string; content: string; mime: string }> = [];

if (hasPatternData) {
  const [rows, cols] = (m.squares ?? '').split(/[x×]/).map((s: string) => Number(s.trim()));
  const square = Number(m.square_size_mm ?? 0);
  const marker = Number(m.marker_size_mm ?? 0);
  const dict = m.dictionary ?? '';
  const patternType = dict ? 'ChArUco' : 'Checkerboard';

  if (rows > 0 && cols > 0 && square > 0) {
    const spec: PatternSpec = {
      type: patternType as PatternSpec['type'],
      rows, cols, square, marker, dict,
      paper: 'A4', startId: Number(m.start_id ?? 0), scaleBar: false,
    };
    const slug = `${handle}-${rows}x${cols}-${square}mm`;
    configFiles = [
      { name: `${slug}.opencv.json`, content: JSON.stringify({ pattern: patternType, rows, cols, square_mm: square, marker_mm: marker, dictionary: dict, start_id: Number(m.start_id ?? 0), generator: 'Calib.Tools' }, null, 2), mime: 'application/json' },
      { name: `${slug}.kalibr.yaml`, content: kalibrYaml(spec), mime: 'text/yaml' },
      { name: `${slug}.ros2.yaml`, content: ros2Yaml(spec), mime: 'text/yaml' },
      { name: `${slug}.halcon.descr`, content: halconDescr(spec), mime: 'text/plain' },
    ];
  }
}

const datasheetUrl = m.datasheet_url || findDatasheetUrl(handle!) || '';

const downloadFiles = [
  ...(datasheetUrl ? [{ name: `${handle}-datasheet${m.datasheet_rev ? `-rev${m.datasheet_rev}` : ''}.pdf`, url: datasheetUrl, mime: 'application/pdf' }] : []),
  { name: 'sample-inspection-report.pdf', url: '/downloads/sample-inspection-report.pdf', mime: 'application/pdf' },
  ...configFiles.map((f) => ({
    name: f.name,
    url: `data:${f.mime};charset=utf-8,${encodeURIComponent(f.content)}`,
    mime: f.mime,
  })),
];

// --- Product images ---
const catalogImages = getProductImages(handle!);
const galleryImages: GalleryImageData[] = [];

for (const entry of catalogImages) {
  const meta = getImageMetadata(entry.handle, entry.file);
  if (!meta) continue;
  const optimized = await optimizeProductImage(
    meta,
    entry.alt || `Calib.Tools ${product.title} — ${entry.file.replace(/^\d+-/, '').replace(/\.webp$/, '')}`,
  );
  galleryImages.push({ ...optimized, kind: entry.kind, file: entry.file });
}

const hasLocalImages = galleryImages.length > 0;

// Board set image
const isBoardProduct = handle?.includes('charuco') || handle?.includes('checkerboard');
let boardSetImageData: { src: string; srcset: string; width: number; height: number } | undefined;
if (isBoardProduct) {
  const boardSetVariants = await Promise.all(
    [480, 800].map(async (w) => {
      const result = await getImage({ src: homeSetImage, width: w, format: 'webp' });
      return { w, src: result.src };
    }),
  );
  boardSetImageData = {
    src: boardSetVariants[boardSetVariants.length - 1].src,
    srcset: boardSetVariants.map((v) => `${v.src} ${v.w}w`).join(', '),
    width: homeSetImage.width,
    height: homeSetImage.height,
  };
}

// Placeholder render
let placeholderSvg = '';
if (!hasLocalImages && product.images.length === 0 && hasPatternData) {
  const [pRows, pCols] = (m.squares ?? '').split(/[x×]/).map((s: string) => Number(s.trim()));
  const pSquare = Number(m.square_size_mm ?? 0);
  const pMarker = Number(m.marker_size_mm ?? 0);
  const pDict = m.dictionary ?? '';
  const pType = pDict ? 'ChArUco' : 'Checkerboard';
  if (pRows > 0 && pCols > 0 && pSquare > 0) {
    const previewSpec: PatternSpec = {
      type: pType as PatternSpec['type'],
      rows: pRows, cols: pCols, square: pSquare, marker: pMarker, dict: pDict,
      paper: 'A4', startId: Number(m.start_id ?? 0), scaleBar: false,
    };
    placeholderSvg = checkerboardSvg(previewSpec, pCols * pSquare + 20, pRows * pSquare + 20);
  }
}

// --- Reviews ---
const productReviews = await getReviewsForProduct(handle!);
const reviewSummary = summarize(productReviews.filter(r => r.status === 'published'));

// --- JSON-LD ---
const siteUrl = 'https://calib.tools';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Calibration targets', item: `${siteUrl}/targets/` },
    { '@type': 'ListItem', position: 3, name: product.title },
  ],
};
const productLd: Record<string, any> = {
  '@context': 'https://schema.org', '@type': 'ProductGroup',
  name: product.title, description: product.description,
  url: `${siteUrl}${product.url}`,
  brand: { '@type': 'Brand', name: 'Calib.Tools' },
  image: hasLocalImages ? galleryImages.map((img) => `${siteUrl}${img.src}`) : product.images.length > 0 ? product.images.map((img) => img.url) : undefined,
};
if (product.variants.length > 0) {
  productLd.hasVariant = product.variants.map((v) => ({
    '@type': 'Product', name: `${product.title} — ${v.title}`, sku: v.sku || undefined,
    offers: { '@type': 'Offer', price: v.priceAmount, priceCurrency: v.currencyCode, availability: v.availableForSale ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock', url: `${siteUrl}${product.url}?variant=${encodeURIComponent(v.id)}`, seller: { '@type': 'Organization', name: 'Calib.Tools' } },
  }));
} else {
  productLd.offers = { '@type': 'AggregateOffer', lowPrice: product.priceMinAmount, priceCurrency: product.priceMinCurrency, availability: 'https://schema.org/InStock', url: `${siteUrl}${product.url}` };
}
if (reviewSummary.count > 0) {
  productLd.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: reviewSummary.average.toFixed(1),
    reviewCount: reviewSummary.count,
    bestRating: '5',
    worstRating: '1',
  };
}

const ogImage = hasLocalImages ? galleryImages[0].src : product.images[0]?.url ?? `/og/${handle}.png`;

// Pairs with / Compare
const isAccessory = handle === 'mounting-fixture' || handle === 'certificate-ilac';
const pairsWith = isAccessory ? [] : [fixtureProduct, certProduct].filter(Boolean);
let compareProduct: typeof product | null = null;
if (handle?.includes('-composite')) compareProduct = allProducts.find((p) => p.handle === handle.replace('-composite', '-ceramic')) ?? null;
else if (handle?.includes('-ceramic')) compareProduct = allProducts.find((p) => p.handle === handle.replace('-ceramic', '-composite')) ?? null;

const collectionHandle = PRODUCT_TO_COLLECTION[handle!] ?? '';
const collectionTitle = collectionHandle ? collectionHandle.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) : '';

// FAQ
const faqItems = getProductFaq(handle!);
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) };

// Ordering rows with prices from Shopify variants
const orderingRows = (productData?.orderingRows ?? []).map((row) => {
  const matchedVariant = product.variants.find((v) => v.sku && row.partNumber.startsWith(v.sku.replace(/-6X6$|-5X5$|-4X4$|-AT36$/, '')));
  return { ...row, price: matchedVariant?.price ?? '' };
});
---
<Base
  title={product.title}
  section="targets"
  description={product.description}
  jsonLd={[breadcrumbLd, productLd]}
  ogImage={ogImage}
  preloadImages={hasLocalImages ? [{
    href: galleryImages[0].src,
    type: 'image/avif',
    srcset: galleryImages[0].sources.find((s) => s.type === 'image/avif')?.srcset,
    sizes: '(max-width: 640px) 100vw, (max-width: 1024px) 60vw, 520px',
  }] : undefined}
>
  {/* Breadcrumb */}
  <nav class="container-x flex gap-2 overflow-x-auto whitespace-nowrap pt-5 text-sm text-ink-soft scrollbar-none" aria-label="Breadcrumb">
    <a href="/" class="text-ink-soft no-underline shrink-0">Home</a><span>/</span>
    <a href="/targets/" class="text-ink-soft no-underline shrink-0">Calibration targets</a><span>/</span>
    {collectionHandle && (
      <><a href={`/targets/collection/${collectionHandle}/`} class="text-ink-soft no-underline shrink-0">{collectionTitle}</a><span>/</span></>
    )}
    <span class="text-ink shrink-0">{product.title}</span>
  </nav>

  {/* ── Buy box ── */}
  <section class="container-x flex flex-wrap gap-14 py-8 md:pb-16">
    {/* Gallery */}
    <div class="flex min-w-0 flex-1 basis-[520px] flex-col gap-4">
      <ImageGallery
        client:load
        images={hasLocalImages ? galleryImages : undefined}
        shopifyImages={!hasLocalImages ? product.images : undefined}
        placeholderSvg={placeholderSvg}
        title={product.title}
      />
    </div>

    {/* Product info */}
    <div class="flex min-w-0 flex-1 basis-[420px] flex-col gap-5" data-buy-box>
      {/* Badges */}
      <div class="flex flex-wrap gap-2">
        <span class="badge bg-brand/10 text-brand-dark inline-flex items-center gap-1.5"><Clock size={14} stroke-width={1.6} aria-hidden="true" />{eyebrow}</span>
        <span class="badge bg-ink text-white inline-flex items-center gap-1.5"><FileCheckIcon size={14} stroke-width={1.6} aria-hidden="true" />Report included</span>
      </div>

      {/* h1 */}
      <h1 class="h-display m-0 text-[28px] leading-[1.1] md:text-[36px]">{product.title}</h1>

      {/* Review summary link */}
      <a href="#reviews" class="inline-flex items-center gap-2 text-sm text-ink-muted no-underline hover:text-ink">
        <Stars client:load rating={Math.round(reviewSummary.average)} size={14} />
        {reviewSummary.count === 0
          ? <span>No reviews yet · <span class="text-brand-dark">how reviews work ↓</span></span>
          : <span>{reviewSummary.average.toFixed(1)} · {reviewSummary.count} review{reviewSummary.count !== 1 ? 's' : ''}</span>
        }
      </a>

      {/* One-line positioning */}
      <p class="m-0 text-[17px] leading-relaxed text-ink-muted">{positioning}</p>

      {/* Key-specs strip */}
      {keySpecs.length > 0 && (
        <dl class="m-0 grid grid-cols-2 gap-px rounded border border-line bg-line md:grid-cols-4">
          {keySpecs.map((ks) => (
            <div class="flex flex-col gap-1 bg-ground p-3">
              <dt class="text-[12px] uppercase tracking-[0.08em] text-ink-muted">{ks.label}</dt>
              <dd class="m-0 font-mono text-[15px] font-medium">{ks.value}</dd>
            </div>
          ))}
        </dl>
      )}

      {/* VariantPicker (price, selectors, add-ons, qty, cart, assurances) */}
      <VariantPicker
        client:load
        product={product}
        certVariantId={certVariantId}
        fixtureVariantId={fixtureVariantId}
        certPrice={certPrice}
        fixturePrice={fixturePrice}
        boardSetImage={boardSetImageData}
      />
    </div>
  </section>

  {/* ── Sizes and part numbers ── */}
  {orderingRows.length > 0 && (
    <section class="container-x flex flex-col gap-5 pb-12 md:pb-16">
      <h2 class="h-display m-0 text-[20px] md:text-2xl">Sizes and part numbers</h2>
      <div class="overflow-x-auto -mx-5 px-5 md:mx-0 md:px-0">
        <table class="w-full min-w-[640px] border-collapse text-[14px]">
          <thead>
            <tr class="border-b border-line bg-ground-alt text-left text-[12px] font-semibold uppercase tracking-wider text-ink-muted">
              <th class="py-2.5 px-3">Part number</th>
              <th class="py-2.5 px-3">Size W × H</th>
              <th class="py-2.5 px-3">Squares</th>
              <th class="py-2.5 px-3">Square · marker</th>
              <th class="py-2.5 px-3">Corners</th>
              <th class="py-2.5 px-3">Markers</th>
              {orderingRows.some((r) => r.weight) && <th class="py-2.5 px-3">Weight</th>}
              <th class="py-2.5 px-3 text-right">Price</th>
            </tr>
          </thead>
          <tbody>
            {orderingRows.map((row, i) => (
              <tr
                class={`border-b border-line cursor-pointer hover:bg-ground-alt/50 ${i % 2 === 1 ? 'bg-ground-alt' : ''}`}
                data-select-size={row.size.split(/\s*[×x]\s*/)[0]?.trim()}
              >
                <td class="py-3 px-3 font-mono text-[13px] text-brand-dark">{row.partNumber}</td>
                <td class="py-3 px-3 whitespace-nowrap">{row.size}</td>
                <td class="py-3 px-3 font-mono text-[13px]">{row.squares}</td>
                <td class="py-3 px-3 font-mono text-[13px]">{row.squareMarker}</td>
                <td class="py-3 px-3 font-mono text-[13px]">{row.corners}</td>
                <td class="py-3 px-3 font-mono text-[13px]">{row.markers}</td>
                {orderingRows.some((r) => r.weight) && <td class="py-3 px-3 font-mono text-[13px]">{row.weight}</td>}
                <td class="py-3 px-3 font-mono text-[13px] font-semibold text-right">{row.price}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      {productData && (
        <p class="m-0 text-[13px] text-ink-soft">Start ID 0, row-major, OpenCV &ge; 4.6 placement. Larger sizes on request.</p>
      )}
    </section>
  )}

  {/* ── Details accordion + sidebar ── */}
  <section class="container-x flex flex-wrap gap-12 pb-16">
    {/* Left column: accordions */}
    <div class="flex min-w-0 flex-[2] basis-[520px] flex-col divide-y divide-line border-y border-line">

      {/* 1. Specifications */}
      {specGroups.length > 0 && (
        <details class="group" id="specs-accordion" open>
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[20px] font-semibold [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-3"><Ruler size={22} stroke-width={1.6} class="text-ink-soft" aria-hidden="true" />Specifications</span>
            <Plus size={22} stroke-width={1.6} class="shrink-0 text-ink-soft transition-transform group-open:rotate-45" aria-hidden="true" />
          </summary>
          <div class="flex flex-col gap-6 pb-6">
            {specGroups.map((group) => (
              <div>
                <h3 class="m-0 pb-2 font-mono text-[12px] uppercase tracking-[0.16em] text-brand-dark">{group.title}</h3>
                <table class="w-full border-collapse text-[14px]">
                  <tbody>
                    {group.rows.map((row, i) => (
                      <tr class={`border-t border-line last:border-b ${i % 2 === 1 ? 'bg-ground-alt' : ''}`}>
                        <td class="w-[38%] py-2.5 pr-3 text-ink-muted">{row.label}</td>
                        <td class="py-2.5 font-mono text-[14px]">{row.value}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
            {productData && (
              <p class="m-0 text-[13px] text-ink-soft">
                Values at 20&nbsp;&deg;C unless stated. Full tolerances in datasheet <code class="text-[12px]">{productData.datasheetCode}</code> rev&nbsp;{productData.rev}.
              </p>
            )}
          </div>
        </details>
      )}

      {/* 2. What's in the box & files */}
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[20px] font-semibold [&::-webkit-details-marker]:hidden">
          <span class="flex items-center gap-3"><Package size={22} stroke-width={1.6} class="text-ink-soft" aria-hidden="true" />What&rsquo;s in the box &amp; files</span>
          <Plus size={22} stroke-width={1.6} class="shrink-0 text-ink-soft transition-transform group-open:rotate-45" aria-hidden="true" />
        </summary>
        <div class="grid grid-cols-1 gap-4 pb-6 sm:grid-cols-2">
          <div class="flex flex-col gap-2 text-[15px]">
            <strong class="text-[13px] uppercase tracking-[0.08em] text-ink-muted">In the box</strong>
            <ul class="m-0 flex flex-col gap-1.5 pl-4 text-[15px]">
              <li>Calibration board in protective case</li>
              <li>Dimensional inspection report (PDF)</li>
              <li>Edge label with serial number</li>
            </ul>
          </div>
          <div class="flex flex-col gap-2 text-[15px]">
            <strong class="text-[13px] uppercase tracking-[0.08em] text-ink-muted">Digital files</strong>
            <ul class="m-0 flex flex-col gap-1.5 pl-4 text-[15px]">
              <li>Datasheet PDF &middot; DXF drawing</li>
              <li>OpenCV JSON &middot; Kalibr YAML</li>
              <li>HALCON .descr &middot; ROS 2 YAML</li>
              <li>Per-feature coordinates CSV</li>
            </ul>
          </div>
        </div>
      </details>

      {/* 3. Compatibility */}
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[20px] font-semibold [&::-webkit-details-marker]:hidden">
          <span class="flex items-center gap-3"><Plug size={22} stroke-width={1.6} class="text-ink-soft" aria-hidden="true" />Compatibility</span>
          <Plus size={22} stroke-width={1.6} class="shrink-0 text-ink-soft transition-transform group-open:rotate-45" aria-hidden="true" />
        </summary>
        <table class="mb-6 w-full border-collapse text-[14px]">
          <tbody>
            {([
              ['OpenCV', '\u2265 4.6 \u00B7 cv::aruco::CharucoBoard'],
              ['Kalibr', 'YAML config file supplied'],
              ['HALCON', 'Plate description file supplied'],
              ['MATLAB', 'Camera Calibrator app'],
              ['ROS 2', 'camera_calibration package'],
            ] as [string, string][]).map(([tool, note], i) => (
              <tr class={`border-t border-line last:border-b ${i % 2 === 1 ? 'bg-ground-alt' : ''}`}>
                <td class="w-[38%] py-2.5 pr-3 font-semibold">{tool}</td>
                <td class="py-2.5 font-mono text-[14px] text-ink-muted">{note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>

      {/* 4. Inspection report & certificate */}
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[20px] font-semibold [&::-webkit-details-marker]:hidden">
          <span class="flex items-center gap-3"><CircleDot size={22} stroke-width={1.6} class="text-ink-soft" aria-hidden="true" />Inspection report &amp; certificate</span>
          <Plus size={22} stroke-width={1.6} class="shrink-0 text-ink-soft transition-transform group-open:rotate-45" aria-hidden="true" />
        </summary>
        <div class="flex flex-col gap-4 pb-6 text-[15px] leading-relaxed text-ink-muted">
          <p class="m-0">
            Every board ships with a manufacturer inspection report: feature positions measured on a coordinate system, flatness check, and visual inspection. The report PDF and measured-coordinates CSV are available via the serial-number lookup at <a href="/verify/">calib.tools/verify</a>.
          </p>
          <p class="m-0">
            For traceable measurement uncertainty, add an ILAC-MRA calibration certificate issued by an accredited third-party laboratory. This is a separate service (SVC-X-CERT-ILAC) and adds 1&ndash;3 weeks to lead time. A manufacturer inspection is not a substitute for accredited calibration.
          </p>
        </div>
      </details>

      {/* 5. Shipping, returns & warranty */}
      <details class="group">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[20px] font-semibold [&::-webkit-details-marker]:hidden">
          <span class="flex items-center gap-3"><Truck size={22} stroke-width={1.6} class="text-ink-soft" aria-hidden="true" />Shipping, returns &amp; warranty</span>
          <Plus size={22} stroke-width={1.6} class="shrink-0 text-ink-soft transition-transform group-open:rotate-45" aria-hidden="true" />
        </summary>
        <table class="mb-6 w-full border-collapse text-[14px]">
          <tbody>
            {([
              ['Lead time', m.lead_time || 'Ships in 1\u20132 business days'],
              ['Shipping', 'Tracked express from the factory. Import VAT and duties are settled at import (DAP) unless agreed otherwise.'],
              ['Returns', '30 days, unused, in original case.'],
              ['Warranty', '2 years against manufacturing defects.'],
            ] as [string, string][]).map(([label, value], i) => (
              <tr class={`border-t border-line last:border-b ${i % 2 === 1 ? 'bg-ground-alt' : ''}`}>
                <td class="w-[38%] py-2.5 pr-3 text-ink-muted">{label}</td>
                <td class="py-2.5 text-[14px]">{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>

      {/* 6. FAQ */}
      {faqItems.length > 0 && (
        <details class="group">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 text-[20px] font-semibold [&::-webkit-details-marker]:hidden">
            <span class="flex items-center gap-3"><HelpCircle size={22} stroke-width={1.6} class="text-ink-soft" aria-hidden="true" />Frequently asked questions</span>
            <Plus size={22} stroke-width={1.6} class="shrink-0 text-ink-soft transition-transform group-open:rotate-45" aria-hidden="true" />
          </summary>
          <div class="flex flex-col divide-y divide-line pb-6">
            {faqItems.map((item) => (
              <div class="py-3">
                <strong class="text-[15px]">{item.question}</strong>
                <p class="m-0 pt-2 text-[15px] leading-relaxed text-ink-muted">{item.answer}</p>
              </div>
            ))}
          </div>
          <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
        </details>
      )}
    </div>

    {/* Right column: sidebar cards */}
    <div class="flex min-w-0 flex-1 basis-[280px] flex-col gap-4">
      {/* Downloads */}
      {downloadFiles.length > 0 && (
        <div class="card flex flex-col gap-3 bg-ground-alt p-5">
          <strong class="flex items-center gap-2 text-[15px]"><Download size={20} stroke-width={1.6} class="text-brand" aria-hidden="true" />Downloads</strong>
          <DownloadPicker client:load files={downloadFiles} />
        </div>
      )}

      {/* Size wizard */}
      <div class="card flex flex-col gap-2 bg-ground-alt p-5">
        <strong class="flex items-center gap-2 text-[15px]"><Wand2 size={20} stroke-width={1.6} class="text-brand" aria-hidden="true" />Not sure about the size?</strong>
        <span class="text-sm text-ink-muted">Run the free selection wizard with your camera and lens.</span>
        <a href="/tools/wizard/" class="text-sm font-semibold">Open wizard <ArrowRight size={14} stroke-width={1.6} class="inline" aria-hidden="true" /></a>
      </div>

      {/* Compare material */}
      {compareProduct && (
        <div class="card flex flex-col gap-2 bg-ground-alt p-5">
          <strong class="flex items-center gap-2 text-[15px]"><Columns2 size={20} stroke-width={1.6} class="text-brand" aria-hidden="true" />Compare with {compareProduct.title}</strong>
          <span class="text-sm text-ink-muted">{handle?.includes('composite') ? 'Higher accuracy, smaller sizes.' : 'Larger sizes from \u20AC79, more affordable.'}</span>
          <a href={compareProduct.url} class="text-sm font-semibold">View {compareProduct.title} <ArrowRight size={14} stroke-width={1.6} class="inline" aria-hidden="true" /></a>
        </div>
      )}

      {/* Request a quote */}
      <div class="card flex flex-col gap-2 bg-ground-alt p-5">
        <strong class="flex items-center gap-2 text-[15px]"><MessageSquare size={20} stroke-width={1.6} class="text-brand" aria-hidden="true" />Need a quote?</strong>
        <span class="text-sm text-ink-muted">Reply within one business day.</span>
        <a href="/quote/" class="text-sm font-semibold">Request a quote <ArrowRight size={14} stroke-width={1.6} class="inline" aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  {/* ── Reviews ── */}
  <ReviewsSection client:load reviews={productReviews} handle={handle!} />

  {/* ── Pairs with ── */}
  {pairsWith.length > 0 && (
    <section class="container-x flex flex-col gap-5 pb-16">
      <h2 class="h-display m-0 text-2xl">Pairs with</h2>
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        {pairsWith.map((p) => p && (
          <ProductCard href={p.url} title={p.title} sub={p.description} from={p.priceFrom} image={p.image} placeholder={p.title.toUpperCase()} />
        ))}
      </div>
    </section>
  )}

  {/* Back to family */}
  {collectionHandle && (
    <section class="container-x pb-16">
      <a href={`/targets/collection/${collectionHandle}/`} class="text-sm font-semibold no-underline"><ArrowUp size={14} stroke-width={1.6} class="inline" aria-hidden="true" /> All {collectionTitle.toLowerCase()}</a>
    </section>
  )}

  <MobileBottomCluster slot="mobile-cluster" client:load mode="add-to-cart" defaultPrice={product.priceFrom} />
</Base>

<script>
  // Close specs accordion on mobile by default
  if (window.innerWidth < 768) {
    const specs = document.getElementById('specs-accordion');
    if (specs) specs.removeAttribute('open');
  }

  // Ordering table row click → select size in VariantPicker
  document.querySelectorAll('[data-select-size]').forEach((row) => {
    row.addEventListener('click', () => {
      const size = (row as HTMLElement).dataset.selectSize;
      if (size) {
        window.dispatchEvent(new CustomEvent('select-size', { detail: { size } }));
      }
    });
  });
</script>
