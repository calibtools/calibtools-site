---
import Base from '@/layouts/Base.astro';
import CollectionTabs from '@/islands/CollectionTabs';
import PurchaseTable from '@/islands/PurchaseTable';
import { getCollections, getCollectionProducts, getProducts } from '@/lib/shopify';
import { getEntry } from 'astro:content';
import { cornersCount } from '@/lib/collectionSpecs';
import { idRange } from '@/lib/idRange';
import { COLLECTION_SIBLINGS } from '@/lib/constants';
import { checkerboardSvg, type PatternSpec } from '@/lib/patterns';

export async function getStaticPaths() {
  const collections = await getCollections();
  return collections.map((c) => ({ params: { collection: c.handle } }));
}

const { collection: handle } = Astro.params;
const collectionData = await getCollectionProducts(handle!);
if (!collectionData) return Astro.redirect('/targets/');
const collection = collectionData;

// Content collection entry for editorial data
const entry = await getEntry('collections', handle!);
const allProducts = await getProducts();

// Render markdown body and parse into sections
let specsTable: Array<{ label: string; value: string }> = [];
let sellingPoints: string[] = [];
let pairsWith: string[] = [];
let collectionColor: string = 'brand';
let founderQuote: string | undefined;
let ContentComponent: any = null;

if (entry) {
  specsTable = entry.data.specsTable;
  sellingPoints = entry.data.sellingPoints;
  pairsWith = entry.data.pairsWith;
  collectionColor = entry.data.color;
  founderQuote = entry.data.founderQuote;
  const rendered = await entry.render();
  ContentComponent = rendered.Content;
}

// Resolve "pairs with" products
const pairedProducts = pairsWith
  .map((h) => allProducts.find((p) => p.handle === h))
  .filter(Boolean);

// Collection colour class mapping
const colorClasses: Record<string, string> = {
  brand: 'bg-collection-brand text-white',
  'slate-blue': 'bg-collection-slate-blue text-white',
  amber: 'bg-collection-amber text-white',
  grey: 'bg-collection-grey text-white',
};
const pillClass = colorClasses[collectionColor] ?? colorClasses.brand;

// Generate preview thumbnails for products
function productPreview(p: typeof collection.products[0]) {
  if (p.image) return { type: 'image' as const, src: p.image };
  const m = p.metafields;
  if (m.squares && m.square_size_mm) {
    const [rows, cols] = m.squares.split(/[x×]/).map((s: string) => Number(s.trim()));
    const square = Number(m.square_size_mm);
    const marker = Number(m.marker_size_mm ?? 0);
    const dict = m.dictionary ?? '';
    const pType = dict ? 'ChArUco' : 'Checkerboard';
    if (rows > 0 && cols > 0 && square > 0) {
      const spec: PatternSpec = {
        type: pType as PatternSpec['type'],
        rows, cols, square, marker, dict,
        paper: 'A4', startId: Number(m.start_id ?? 0), scaleBar: false,
      };
      const w = cols * square + 20;
      const h = rows * square + 20;
      return { type: 'svg' as const, svg: checkerboardSvg(spec, w, h) };
    }
  }
  return { type: 'placeholder' as const };
}

// Build spec bullets for a product
function specBullets(p: typeof collection.products[0]): string[] {
  const m = p.metafields;
  const bullets: string[] = [];
  if (m.squares) bullets.push(`Grid: ${m.squares}`);
  if (m.square_size_mm) bullets.push(`Square: ${m.square_size_mm} mm`);
  if (m.marker_size_mm) bullets.push(`Marker: ${m.marker_size_mm} mm`);
  if (m.feature_tolerance) bullets.push(`Tolerance: ${m.feature_tolerance}`);
  if (m.thickness_mm) bullets.push(`Thickness: ${m.thickness_mm} mm`);
  // Corners count
  if (m.squares) {
    const [rows, cols] = m.squares.split(/[x×]/).map((s: string) => Number(s.trim()));
    if (rows > 0 && cols > 0) {
      const dict = m.dictionary;
      if (dict) {
        // ChArUco: show marker count from idRange
        const spec: PatternSpec = {
          type: 'ChArUco', rows, cols, square: 1, marker: 0.5, dict,
          paper: 'A4', startId: 0, scaleBar: false,
        };
        const range = idRange(spec);
        if (range) bullets.push(`${range.count} markers`);
      } else {
        bullets.push(`${cornersCount(rows, cols)} inner corners`);
      }
    }
  }
  return bullets.slice(0, 6);
}

const siteUrl = 'https://calib.tools';
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Calibration targets', item: `${siteUrl}/targets/` },
    { '@type': 'ListItem', position: 3, name: collection.title },
  ],
};
---
<Base title={collection.title} section="targets" description={collection.description} jsonLd={[breadcrumbLd]}>
  {/* --- Family page header --- */}
  <section class="container-x py-8 md:py-12">
    {/* Breadcrumb */}
    <nav class="flex gap-2 overflow-x-auto whitespace-nowrap text-sm text-ink-soft pb-4 scrollbar-none" aria-label="Breadcrumb">
      <a href="/" class="text-ink-soft no-underline shrink-0">Home</a><span>/</span>
      <a href="/targets/" class="text-ink-soft no-underline shrink-0">Calibration targets</a><span>/</span>
      <span class="text-ink shrink-0">{collection.title}</span>
    </nav>

    <div class="flex flex-col gap-8 lg:flex-row lg:gap-12">
      {/* Left column */}
      <div class="flex flex-col gap-5 flex-1 min-w-0">
        {/* Colour pill + H1 */}
        <div class="flex items-center gap-3">
          <span class={`badge ${pillClass}`}>{collection.title}</span>
        </div>
        <h1 class="h-display m-0 text-[36px] md:text-[48px]">{collection.title}</h1>

        {/* Selling points */}
        {sellingPoints.length > 0 && (
          <ul class="m-0 flex flex-col gap-2 pl-0 list-none">
            {sellingPoints.map((sp) => (
              <li class="flex items-start gap-2 text-[15px] text-ink-muted">
                <span class="text-brand mt-0.5 shrink-0">&#10003;</span>
                <span>{sp}</span>
              </li>
            ))}
          </ul>
        )}

        {/* Preview strip */}
        {collection.products.length > 0 && (
          <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-none">
            {collection.products.map((p) => {
              const preview = productPreview(p);
              return (
                <a
                  href={`#product-${p.handle}`}
                  class="shrink-0 w-[100px] h-[75px] rounded border border-line bg-ground-panel flex items-center justify-center overflow-hidden no-underline hover:border-brand transition-colors"
                  title={p.title}
                >
                  {preview.type === 'image' ? (
                    <img src={preview.src} alt={p.title} class="h-full w-full object-contain" loading="lazy" />
                  ) : preview.type === 'svg' ? (
                    <div class="h-full w-full flex items-center justify-center p-1" set:html={preview.svg} />
                  ) : (
                    <span class="font-mono text-[10px] text-ink-soft">{p.title.slice(0, 12)}</span>
                  )}
                </a>
              );
            })}
          </div>
        )}

        {/* Action buttons */}
        <div class="flex flex-wrap gap-3">
          <a href="#product-groups" class="btn-primary text-sm no-underline">Go to products &darr;</a>
          <a href="/tools/wizard/" class="btn-outline text-sm no-underline">Not sure? Open the wizard &rarr;</a>
        </div>
      </div>

      {/* Right rail: Pairs with */}
      {pairedProducts.length > 0 && (
        <aside class="lg:w-[300px] shrink-0 flex flex-col gap-4">
          <h2 class="m-0 text-[15px] font-semibold text-ink-soft uppercase tracking-[0.06em]">Pairs with</h2>
          <div class="flex flex-col gap-3">
            {pairedProducts.map((p) => p && (
              <a href={p.url} class="card flex gap-3 p-3 no-underline text-ink hover:text-ink hover:border-ink/40">
                <div class="w-14 h-14 rounded bg-ground-panel flex items-center justify-center shrink-0">
                  {p.image ? (
                    <img src={p.image} alt="" class="h-full w-full object-contain rounded" loading="lazy" />
                  ) : (
                    <span class="font-mono text-[9px] text-ink-soft">{p.title.slice(0, 6)}</span>
                  )}
                </div>
                <div class="flex flex-col gap-0.5 min-w-0">
                  <strong class="text-sm truncate">{p.title}</strong>
                  <span class="text-xs text-ink-muted truncate">{p.description}</span>
                  <span class="text-xs font-semibold text-brand-dark">from {p.priceFrom}</span>
                </div>
              </a>
            ))}
          </div>
        </aside>
      )}
    </div>
  </section>

  {/* Hidden content source for CollectionTabs island to parse */}
  {ContentComponent && (
    <div id={`collection-content-${handle}`} class="hidden" aria-hidden="true">
      <ContentComponent />
    </div>
  )}

  {/* --- Tab bar --- */}
  {entry && (
    <CollectionTabs
      client:load
      collectionHandle={handle!}
      specsTable={specsTable}
      founderQuote={founderQuote}
    />
  )}

  {/* --- Sibling navigation --- */}
  <nav class="container-x py-4 border-b border-line" aria-label="Sibling collections">
    <div class="flex items-center gap-2 text-sm flex-wrap">
      <span class="text-ink-soft">Also in targets:</span>
      {COLLECTION_SIBLINGS.map((sib, i) => (
        <>
          {i > 0 && <span class="text-line">|</span>}
          {sib.handle === handle ? (
            <span class="font-semibold text-ink">{sib.label}</span>
          ) : (
            <a href={`/targets/collection/${sib.handle}/`} class="text-ink-muted no-underline hover:text-brand">{sib.label}</a>
          )}
        </>
      ))}
    </div>
  </nav>

  {/* --- Product groups --- */}
  <section id="product-groups" class="container-x flex flex-col gap-12 py-10 md:py-14">
    {collection.products.length > 0 ? (
      collection.products.map((p) => {
        const preview = productPreview(p);
        const bullets = specBullets(p);
        return (
          <div id={`product-${p.handle}`} class="flex flex-col gap-6 scroll-mt-20">
            {/* Group title */}
            <h2 class="h-display m-0 text-2xl text-brand">{p.title}</h2>

            {/* Render + spec bullets */}
            <div class="flex flex-col md:flex-row gap-6">
              {/* Product render */}
              <div class="w-full md:w-[280px] shrink-0 aspect-[4/3] rounded border border-line bg-ground-panel flex items-center justify-center overflow-hidden">
                {preview.type === 'image' ? (
                  <img src={preview.src} alt={p.title} class="h-full w-full object-contain" loading="lazy" />
                ) : preview.type === 'svg' ? (
                  <div class="h-full w-full flex items-center justify-center p-4" set:html={preview.svg} />
                ) : (
                  <span class="font-mono text-xs text-ink-soft">[{p.title}]</span>
                )}
              </div>

              {/* Spec bullets + description */}
              <div class="flex flex-col gap-3 flex-1 min-w-0">
                {bullets.length > 0 && (
                  <ul class="m-0 pl-0 list-none flex flex-col gap-1.5">
                    {bullets.map((b) => (
                      <li class="flex items-start gap-2 text-[15px]">
                        <span class="text-brand mt-0.5 shrink-0">&#8226;</span>
                        <span class="spec">{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <p class="m-0 text-[15px] text-ink-muted leading-relaxed">{p.description}</p>
              </div>
            </div>

            {/* Purchase table */}
            <PurchaseTable client:load product={p} />
          </div>
        );
      })
    ) : (
      <div class="card p-8 text-center text-ink-muted">
        <p class="m-0">Products in this category are coming soon.</p>
        <a href="/targets/" class="text-sm font-semibold">Back to all targets</a>
      </div>
    )}
  </section>
</Base>
