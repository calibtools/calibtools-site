---
import Base from '@/layouts/Base.astro';
import ProductCard from '@/components/ProductCard.astro';
import type { ImageMetadata } from 'astro';
import { getCollections, getProducts } from '@/lib/shopify';
import { getProductImages } from '@/lib/product-images';
import { getImageMetadata } from '@/lib/productImageImports';
import { breadcrumbLd } from '@/lib/seo';
import { getEntry } from 'astro:content';
import { IN_DEVELOPMENT } from '@/lib/claims';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Calibration targets' }]);

const collections = await getCollections();
/* Overlay local title + description from content collection */
const localCollectionData = new Map<string, { title: string; description: string }>();
for (const c of collections) {
  const entry = await getEntry('collections', c.handle);
  if (entry) localCollectionData.set(c.handle, { title: entry.data.title, description: entry.data.description });
}
const products = await getProducts();

// Build hero image map for all products
const heroImageMap = new Map<string, ImageMetadata>();
for (const p of products) {
  const images = getProductImages(p.handle);
  const hero = images.find((img) => img.file === '01-hero.webp');
  if (hero) {
    const meta = getImageMetadata(hero.handle, hero.file);
    if (meta) heroImageMap.set(p.handle, meta);
  }
}
---
<Base title="Calibration targets" section="targets" description="Checkerboard, ChArUco, AprilGrid, ceramic and glass calibration targets with inspection report. Made to order, shipped worldwide." jsonLd={bcLd}>
  <section class="container-x flex flex-col gap-9 py-12 md:py-16">
    <div class="flex flex-col gap-2.5">
      <span class="eyebrow">Calibration targets</span>
      <h1 class="h-display m-0 text-[36px] md:text-[48px]">From checkerboard to certificate.</h1>
    </div>

    {/* Collections */}
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {collections.map((c) => {
        const firstProduct = c.products[0];
        const localHero = firstProduct ? heroImageMap.get(firstProduct.handle) : undefined;
        const local = localCollectionData.get(c.handle);
        const displayTitle = local?.title ?? c.title;
        const displayDesc = local?.description ?? c.description;
        const hasPurchasable = c.products.length > 0;
        return (
          <ProductCard
            href={`/targets/collection/${c.handle}/`}
            title={displayTitle}
            sub={displayDesc}
            from={hasPurchasable ? (firstProduct?.priceFrom ?? '') : ''}
            tag={!hasPurchasable ? IN_DEVELOPMENT : undefined}
            localImage={localHero}
            image={!localHero ? (c.image ?? firstProduct?.image) : undefined}
            placeholder={displayTitle.toUpperCase()}
          />
        );
      })}
    </div>

    {/* All products */}
    {products.length > 0 && (
      <>
        <h2 class="h-display m-0 mt-4 text-[28px]">All targets</h2>
        <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
          {products.map((p) => {
            const localHero = heroImageMap.get(p.handle);
            return (
              <ProductCard
                href={p.url}
                title={p.title}
                sub={p.description}
                from={p.priceFrom}
                localImage={localHero}
                image={!localHero ? p.image : undefined}
              />
            );
          })}
        </div>
      </>
    )}
  </section>
</Base>
