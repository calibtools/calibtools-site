---
import Base from '@/layouts/Base.astro';
import { breadcrumbLd } from '@/lib/seo';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Privacy policy' }]);
---
<Base title="Privacy policy" description="Privacy policy for calib.tools. No analytics, no tracking, no cookies. Browser tools run entirely client-side." jsonLd={bcLd}>
  <div class="container-x py-10 md:py-16">
    <div class="prose-calib mx-auto flex max-w-[720px] flex-col gap-5">
      <h1 class="h-display m-0 text-[32px] md:text-[40px]">Privacy policy</h1>

      <h2>Controller</h2>
      <p>
        <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[COMPANY LEGAL NAME]</span><br />
        <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[STREET ADDRESS, POSTAL CODE, CITY]</span><br />
        Email: <a href="mailto:hello@calib.tools">hello@calib.tools</a>
      </p>

      <h2>What we collect</h2>
      <p>This website does not use analytics, tracking scripts or cookies. The browser tools run entirely in your browser — no images, calibration files or personal data are uploaded to our servers.</p>

      <h2>Hosting</h2>
      <p>The site is hosted on Cloudflare Pages. Cloudflare may process your IP address and browser metadata to deliver the pages. See <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener">Cloudflare's privacy policy</a>.</p>

      <h2>Shop &amp; checkout</h2>
      <p>When you place an order, checkout is handled by Shopify on <code>shop.calib.tools</code>. Shopify processes your name, address, email and payment details to fulfil the order. See <a href="https://www.shopify.com/legal/privacy" target="_blank" rel="noopener">Shopify's privacy policy</a>.</p>

      <h2>Email</h2>
      <p>If you subscribe to the newsletter, your email address is stored by Shopify. You can unsubscribe at any time via the link in every email.</p>

      <h2>Fonts</h2>
      <p>This site uses Geist Sans, Geist Mono and Geist Pixel by Vercel, SIL Open Font License 1.1, self-hosted. No external font services are loaded — all font files are served from our own domain.</p>

      <h2>Your rights</h2>
      <p>Under the GDPR you have the right to access, rectify, erase or port your data, and to object to or restrict processing. Contact <a href="mailto:hello@calib.tools">hello@calib.tools</a>.</p>

      <h2>Data protection authority</h2>
      <p>
        <span class="inline-block rounded bg-brand-tint px-2 py-0.5 font-semibold text-brand-dark">[SUPERVISORY AUTHORITY NAME AND CONTACT]</span>
      </p>
    </div>
  </div>
</Base>
