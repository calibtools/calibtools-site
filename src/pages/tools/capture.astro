---
import Base from '@/layouts/Base.astro';
import ToolTabs from '@/components/ToolTabs.astro';
import CaptureAssistant from '@/islands/CaptureAssistant';
---
<Base title="Capture assistant" section="tools" description="Guided calibration image capture with 15 poses for optimal coverage. Uses your camera directly in the browser — nothing is uploaded.">
  <ToolTabs current="capture" />
  <div class="container-x py-7 md:pb-16">
    <CaptureAssistant client:load />
  </div>
</Base>
