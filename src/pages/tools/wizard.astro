---
import Base from '@/layouts/Base.astro';
import ToolTabs from '@/components/ToolTabs.astro';
import Wizard from '@/islands/Wizard';
---
<Base title="Selection wizard" section="tools" description="Answer five questions about your camera setup and get a calibration pattern recommendation. Covers OpenCV, Kalibr, ROS, HALCON, and MATLAB workflows.">
  <ToolTabs current="wizard" />
  <div class="container-x py-7 md:pb-16">
    <Wizard client:load />
  </div>
</Base>
