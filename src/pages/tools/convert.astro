---
import Base from '@/layouts/Base.astro';
import ToolTabs from '@/components/ToolTabs.astro';
import Converter from '@/islands/Converter';
---
<Base title="Format converter" section="tools" description="Convert calibration configs between OpenCV JSON, Kalibr YAML, ROS 2 YAML, and HALCON .descr formats. Paste, convert, download. Runs in your browser.">
  <ToolTabs current="convert" />
  <div class="container-x py-7 md:pb-16">
    <Converter client:load />
  </div>
</Base>
