---
import Base from '@/layouts/Base.astro';
import ToolTabs from '@/components/ToolTabs.astro';
import DetectionCheck from '@/islands/DetectionCheck';
---
<Base title="Detection check" section="tools" description="Upload a photo of your calibration pattern and verify that OpenCV detects all expected corners. Runs entirely in your browser using OpenCV.js WebAssembly.">
  <ToolTabs current="check" />
  <div class="container-x py-7 md:pb-16">
    <DetectionCheck client:load />
  </div>
</Base>
