---
import Base from '@/layouts/Base.astro';
import ToolTabs from '@/components/ToolTabs.astro';
---
<Base title="check" section="tools">
  <ToolTabs current="check" />
  <div class="container-x py-7 md:pb-16">
    <div class="card flex flex-col gap-3 p-8">
      <h1 class="h-display m-0 text-2xl">Coming soon</h1>
      <p class="m-0 text-ink-muted">This tool is on the roadmap. See <a href="https://github.com/calibtools/calibtools">the repository</a> for progress, or try the <a href="/tools/generator/">pattern generator</a>.</p>
    </div>
  </div>
</Base>
