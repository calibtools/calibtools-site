---
import Base from '@/layouts/Base.astro';
import ToolCard from '@/components/ToolCard.astro';
import { tools } from '@/lib/tools';
---
<Base title="Free calibration tools" section="tools" description="Free browser tools for camera calibration: pattern generator, FOV calculator, selection wizard, format converter, detection check and quality analyzer.">
  <section class="container-x flex flex-col gap-9 py-12 md:py-16">
    <div class="flex flex-col gap-2.5">
      <span class="eyebrow">Free tools · runs in your browser · open source</span>
      <h1 class="h-display m-0 text-[36px] md:text-[48px]">Free tools. Serious targets.</h1>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {tools.map((t) => (
        <ToolCard href={t.href} title={t.title} body={t.body} cta={t.live ? t.cta : `${t.cta} (coming soon)`} />
      ))}
    </div>
  </section>
</Base>
