---
import Base from '@/layouts/Base.astro';
import ToolCard from '@/components/ToolCard.astro';
import { tools } from '@/lib/tools';
import { breadcrumbLd } from '@/lib/seo';
const bcLd = breadcrumbLd([{ name: 'Home', url: '/' }, { name: 'Free tools' }]);
---
<Base title="Free calibration tools" section="tools" description="Free browser tools for camera calibration: pattern generator, FOV calculator, selection wizard, format converter, detection check and quality analyzer." jsonLd={bcLd}>
  <section class="container-x flex flex-col gap-9 py-[var(--section-y)]">
    <div class="flex flex-col gap-2.5">
      <span class="eyebrow">Free tools · open source</span>
      <h1 class="m-0 text-[32px] font-semibold leading-[1.12] md:text-[40px]">Free calibration tools that run in your browser</h1>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {tools.map((t) => (
        <ToolCard href={t.href} title={t.title} body={t.body} cta={t.cta} />
      ))}
    </div>
  </section>
</Base>
