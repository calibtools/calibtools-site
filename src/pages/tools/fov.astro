---
import Base from '@/layouts/Base.astro';
import ToolTabs from '@/components/ToolTabs.astro';
import FovCalculator from '@/islands/FovCalculator';
---
<Base title="FOV calculator" section="tools" description="Calculate field of view, coverage area and ground sample distance for any camera and lens combination. Sensor presets for common machine vision cameras.">
  <ToolTabs current="fov" />
  <div class="container-x py-7 md:pb-16">
    <FovCalculator client:load />
  </div>
</Base>
