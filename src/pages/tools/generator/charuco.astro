---
import Base from '@/layouts/Base.astro';
import ToolTabs from '@/components/ToolTabs.astro';
import ToolContent from '@/components/ToolContent.astro';
import Generator from '@/islands/Generator';
import { getEntry } from 'astro:content';
import { toolJsonLd } from '@/lib/toolJsonLd';

const entry = (await getEntry('tools', 'generator-charuco'))!;
const { Content } = await entry.render();
const jsonLd = toolJsonLd(entry.data.h1, '/tools/generator/charuco/', entry.data.seoDescription, entry.data.faq);
---
<Base title={entry.data.seoTitle} section="tools" description={entry.data.seoDescription} jsonLd={jsonLd}>
  <ToolTabs current="generator" />
  <div class="container-x py-7 md:pb-16">
    <Generator client:load heading={entry.data.h1} initialSpec={{ type: 'ChArUco', dict: 'DICT_6X6_250' }} />
    <p class="mt-6 text-[15px] text-ink-muted">
      Printing your own pattern has accuracy limits — see <a href="/files/datasheets/CT-DS-CHA-P.pdf" class="text-brand-dark font-medium">feature tolerance and flatness in the datasheet</a>.
      For sub-pixel reprojection error, the <a href="/targets/charuco-composite/" class="text-brand-dark font-medium">ChArUco aluminium composite board</a> or
      <a href="/targets/charuco-ceramic/" class="text-brand-dark font-medium">ChArUco ceramic target</a> are UV-printed or lithographed to tighter tolerances than any office printer.
    </p>
  </div>
  <ToolContent Content={Content} faq={entry.data.faq} />
</Base>
