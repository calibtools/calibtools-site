---
import Base from '@/layouts/Base.astro';
import ToolTabs from '@/components/ToolTabs.astro';
import ToolContent from '@/components/ToolContent.astro';
import Generator from '@/islands/Generator';
import { getEntry } from 'astro:content';
import { toolJsonLd } from '@/lib/toolJsonLd';

const entry = (await getEntry('tools', 'generator-circles'))!;
const { Content } = await entry.render();
const jsonLd = toolJsonLd(entry.data.h1, '/tools/generator/circles/', entry.data.seoDescription, entry.data.faq);
---
<Base title={entry.data.seoTitle} section="tools" description={entry.data.seoDescription} jsonLd={jsonLd}>
  <ToolTabs current="generator" />
  <div class="container-x py-7 md:pb-16">
    <Generator client:load initialSpec={{ type: 'Asymmetric circles' }} />
    <p class="mt-6 text-[15px] text-ink-muted">
      Printing your own pattern has accuracy limits — see <a href="/files/datasheets/CT-DS-CHA-P.pdf" class="text-brand-dark font-medium">feature tolerance and flatness in the composite datasheet</a>.
      The <a href="/targets/circlegrid-composite/" class="text-brand-dark font-medium">circle grid aluminium composite board</a> is UV-printed with controlled tolerances, available in symmetric and asymmetric layouts.
    </p>
  </div>
  <ToolContent Content={Content} faq={entry.data.faq} />
</Base>
