---
import Base from '@/layouts/Base.astro';
import ToolTabs from '@/components/ToolTabs.astro';
import ToolContent from '@/components/ToolContent.astro';
import Generator from '@/islands/Generator';
import { getEntry } from 'astro:content';
import { toolJsonLd } from '@/lib/toolJsonLd';

const entry = (await getEntry('tools', 'generator-aruco'))!;
const { Content } = await entry.render();
const jsonLd = toolJsonLd(entry.data.h1, '/tools/generator/aruco/', entry.data.seoDescription, entry.data.faq);
---
<Base title={entry.data.seoTitle} section="tools" description={entry.data.seoDescription} jsonLd={jsonLd}>
  <ToolTabs current="generator" />
  <div class="container-x py-7 md:pb-16">
    <Generator client:load heading={entry.data.h1} initialSpec={{ type: 'Marker sheet', rows: 1, cols: 1, square: 120, marker: 100, dict: 'DICT_6X6_250', startId: 0 }} />
    <p class="mt-6 text-[15px] text-ink-muted">
      Free for any use, including commercial work. For camera calibration, a rigid board is more accurate than paper: the <a href="/targets/charuco-composite/" class="text-brand-dark font-medium">ChArUco aluminum composite board</a> is UV-printed with controlled tolerances and is measured before it ships.
    </p>
  </div>
  <ToolContent Content={Content} faq={entry.data.faq} />
</Base>
