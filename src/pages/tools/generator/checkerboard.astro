---
import Base from '@/layouts/Base.astro';
import ToolTabs from '@/components/ToolTabs.astro';
import ToolContent from '@/components/ToolContent.astro';
import Generator from '@/islands/Generator';
import { getEntry } from 'astro:content';
import { toolJsonLd } from '@/lib/toolJsonLd';

const entry = (await getEntry('tools', 'generator-checkerboard'))!;
const { Content } = await entry.render();
const jsonLd = toolJsonLd(entry.data.h1, '/tools/generator/checkerboard/', entry.data.seoDescription, entry.data.faq);
---
<Base title={entry.data.seoTitle} section="tools" description={entry.data.seoDescription} jsonLd={jsonLd}>
  <ToolTabs current="generator" />
  <div class="container-x py-7 md:pb-16">
    <Generator client:load initialSpec={{ type: 'Checkerboard', rows: 9, cols: 6, square: 30 }} />
    <p class="mt-6 text-[15px] text-ink-muted">
      Printing your own pattern has <a href="/guides/printed-target-costs-half-a-pixel/" class="text-brand-dark font-medium">measurable accuracy limits</a>.
      For the highest corner accuracy, the <a href="/targets/checkerboard-composite/" class="text-brand-dark font-medium">checkerboard aluminium composite board</a> is UV-printed with ±0.3 mm tolerances and ships with a dimensional inspection report.
    </p>
  </div>
  <ToolContent Content={Content} faq={entry.data.faq} />
</Base>
