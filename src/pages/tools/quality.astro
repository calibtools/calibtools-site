---
import Base from '@/layouts/Base.astro';
import ToolTabs from '@/components/ToolTabs.astro';
import QualityAnalyzer from '@/islands/QualityAnalyzer';
---
<Base title="Quality analyzer" section="tools" description="Analyze your camera calibration results: intrinsics, distortion, reprojection errors, and outlier detection. Paste OpenCV JSON and get an instant quality score.">
  <ToolTabs current="quality" />
  <div class="container-x py-7 md:pb-16">
    <QualityAnalyzer client:load />
  </div>
</Base>
