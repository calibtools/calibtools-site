---
import Base from '@/layouts/Base.astro';
import NewsletterForm from '@/islands/NewsletterForm';
import { tools } from '@/lib/tools';
import { getCollections } from '@/lib/shopify';
import { getCollection } from 'astro:content';
import { getAllPublishedReviews } from '@/lib/reviews';
import { TAGLINE, HOME_HEADLINE, RETURNS_LINE, COMPOSITE_TOLERANCE, COMPOSITE_FLATNESS, CERAMIC_ACCURACY, LEAD_TIME_WEEKS, RETURN_WINDOW_DAYS } from '@/lib/claims';
import CollectionTiles from '@/components/CollectionTiles.astro';
import { drawingForPartNumber } from '@/lib/boardDrawing';
import { partNumberIndex } from '@/lib/partNumberLookup';
import partNumbersCsv from '../../data/part-numbers.csv?raw';
import Stars from '@/components/Stars';

const collections = await getCollections();
const allGuides = await getCollection('guides');

const isReady = (g: typeof allGuides[number]) => !g.data.draft && !g.body?.includes('[BODY COPY');
const guides = allGuides.filter(isReady).slice(0, 3);

/* Three tools on the home page */
const featuredTools = tools.slice(0, 3);

/* Part numbers → product pages, for the "Have a part number?" box */
const pnIndex = partNumberIndex(partNumbersCsv);
const PN_EXAMPLE = 'CT-CHA-P-400X300-D5';

/* Shortcuts by pattern */
const patternChips = [
  ['Checkerboard', '/targets/checkerboard-composite/'],
  ['ChArUco', '/targets/charuco-composite/'],
  ['AprilGrid', '/targets/aprilgrid-composite/'],
  ['Circle grid', '/targets/circlegrid-composite/'],
  ['HALCON', '/targets/halcon-composite/'],
];

/* Key numbers: values from claims.ts, each with its condition */
const [flatValue, flatCond = ''] = COMPOSITE_FLATNESS.replace(')', '').split(' (');
const keyNumbers = [
  { label: 'Feature position, composite', value: COMPOSITE_TOLERANCE, cond: 'any corner to nominal grid, at 20 °C' },
  { label: 'Flatness, composite', value: flatValue, cond: flatCond },
  { label: 'Feature accuracy, ceramic', value: CERAMIC_ACCURACY, cond: 'target value at 20 °C; method to be published' },
  { label: 'Lead time', value: `${LEAD_TIME_WEEKS}`, cond: 'made to order' },
];

/* What comes with a board (wording follows the collection pages) */
const deliverables = [
  ['On the board', 'Its own pattern parameters, printed in the margin', 'print'],
  ['Config files', 'OpenCV JSON and ROS 2 YAML; Kalibr YAML where Kalibr supports the pattern; HALCON point tuples', '.json .yaml'],
  ['Datasheet', 'Dimensions, tolerances with their conditions, material', '.pdf'],
  ['Check before shipping', 'Dimensional, flatness and visual check on every board', 'per board'],
];
const drawing = drawingForPartNumber(PN_EXAMPLE)!;

const allReviews = await getAllPublishedReviews();
const showReviews = allReviews.length >= 3;
const featuredReviews = allReviews
  .sort((a, b) => {
    const aScore = (a.tags.camera || a.tags.lensOrFov || a.tags.software ? 1 : 0) + (a.photos.length > 0 ? 1 : 0);
    const bScore = (b.tags.camera || b.tags.lensOrFov || b.tags.software ? 1 : 0) + (b.photos.length > 0 ? 1 : 0);
    return bScore - aScore || new Date(b.created).getTime() - new Date(a.created).getTime();
  })
  .slice(0, 3);
---
<Base title={HOME_HEADLINE} bareTitle description={`${TAGLINE}. Measured before they ship, made to order. Free browser tools for your machine-vision work.`}>

  {/* ── Find a target ── */}
  <section id="top" class="container-x flex flex-col gap-8 pb-12 pt-10 md:gap-10 md:pb-14 md:pt-12">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:gap-6">
      <div class="flex min-w-0 flex-col gap-4 lg:w-[58%]">
        <h1 class="m-0 text-[32px] font-semibold leading-[1.12] md:text-[40px]" data-hero-h1>{HOME_HEADLINE}</h1>
        <p class="m-0 max-w-[640px] text-[17px] leading-[1.55] text-ink-muted md:text-[18px]">
          {TAGLINE}. Checkerboard, ChArUco, AprilGrid, circle-grid and HALCON boards for OpenCV, Kalibr, ROS and HALCON, each printed from the same geometry as the config files you download.
        </p>
      </div>
      <div class="flex min-w-0 flex-col gap-2 lg:w-[42%]">
        <label for="pn-input" class="spec-label">Have a part number?</label>
        <form id="pn-form" class="flex h-12 items-center gap-1 rounded border border-line-strong bg-sheet p-1 focus-within:border-ink" data-index={JSON.stringify(pnIndex)} novalidate>
          <input id="pn-input" name="pn" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder={PN_EXAMPLE} class="h-full min-w-0 flex-1 bg-transparent px-3 font-mono text-[14px] uppercase text-ink placeholder:text-ink-soft placeholder:normal-case focus:outline-none" aria-describedby="pn-msg" />
          <button type="submit" class="btn-md btn-primary shrink-0">Go</button>
        </form>
        <p id="pn-msg" class="m-0 hidden text-[13px] text-ink-muted" role="status" aria-live="polite">No stock target has that part number. <a href="/targets/" class="underline decoration-1 underline-offset-[3px]">See all targets</a> or <a href="/quote/" class="underline decoration-1 underline-offset-[3px]">ask for a quote</a>.</p>
        <div class="flex flex-wrap gap-2 pt-1">
          {patternChips.map(([label, href]) => (
            <a href={href} class="badge min-h-[28px] text-ink no-underline hover:bg-ink hover:text-white">{label}</a>
          ))}
        </div>
      </div>
    </div>

    <CollectionTiles collections={collections} />
  </section>

  {/* ── Key numbers (spec strip) ── */}
  <section aria-label="Key numbers" class="border-y border-line bg-sheet">
    <dl class="container-x my-0 grid grid-cols-2 lg:grid-cols-4">
      {keyNumbers.map((k, i) => (
        <div class:list={['flex flex-col gap-1.5 py-5 pr-4', i % 2 === 1 && 'border-l border-line pl-4 md:pl-6', i >= 2 && 'border-t border-line lg:border-t-0', i === 2 && 'lg:border-l lg:pl-6']}>
          <dt class="spec-label">{k.label}</dt>
          <dd class="m-0 flex flex-col gap-1"><span class="spec-value">{k.value}</span><span class="spec-cond">{k.cond}</span></dd>
        </div>
      ))}
    </dl>
  </section>

  {/* ── Free tools ── */}
  <section id="tools" class="border-b border-line bg-ground-alt">
    <div class="container-x flex flex-col gap-8 py-[var(--section-y)] lg:flex-row lg:gap-6">
      <div class="flex flex-col gap-4 lg:w-[42%]">
        <span class="section-no !text-ink-muted">Free tools</span>
        <span class="section-rule"></span>
        <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">Size the board before you buy it</h2>
        <p class="m-0 max-w-[400px] text-[15px] leading-relaxed text-ink-muted">Seven tools that run in your browser. No images or calibration files leave your computer.</p>
        <a href="/tools/" class="text-[14px] font-medium underline decoration-1 underline-offset-[3px]">All tools</a>
      </div>
      <ol class="m-0 flex list-none flex-col border-t border-line-strong p-0 lg:w-[58%]">
        {featuredTools.map((t) => (
          <li class="border-b border-line-strong">
            <a href={t.href} class="flex items-start gap-4 py-5 text-ink no-underline hover:text-ink md:gap-6">
              <span class="flex min-w-0 flex-1 flex-col gap-1">
                <strong class="text-[17px] font-medium">{t.title}</strong>
                <span class="text-[15px] leading-relaxed text-ink-muted">{t.body}</span>
              </span>
              <span class="shrink-0 pt-1 font-mono text-[12px] font-semibold uppercase tracking-[0.04em] text-brand-dark">Open</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ── What comes with the board ── */}
  <section id="with-the-board" class="container-x flex flex-col gap-8 py-[var(--section-y)]">
    <div class="flex flex-col gap-4">
      <span class="section-no">What comes with the board</span>
      <span class="section-rule"></span>
      <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">The board, its files and the checks behind it</h2>
    </div>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <figure class="card bracket m-0 flex flex-col gap-3 p-3 md:p-5">
        <div class="[&>svg]:h-auto [&>svg]:w-full" set:html={drawing} />
        <figcaption class="spec-label leading-relaxed">{PN_EXAMPLE} &middot; DICT_5X5_100 &middot; drawn from the same geometry we print &middot; mm</figcaption>
      </figure>
      <div class="flex flex-col gap-5">
        <table class="w-full border-collapse border border-line bg-sheet text-[15px]">
          <thead>
            <tr class="bg-brand-tint text-left font-mono text-[12px] uppercase tracking-[0.04em] text-brand-dark">
              <th class="px-4 py-3 font-medium">Item</th><th class="px-4 py-3 font-medium">What it is</th><th class="hidden px-4 py-3 font-medium sm:table-cell">Format</th>
            </tr>
          </thead>
          <tbody>
            {deliverables.map(([item, what, format]) => (
              <tr class="border-t border-line align-top">
                <th scope="row" class="px-4 py-3.5 text-left font-medium">{item}</th>
                <td class="px-4 py-3.5 text-ink-muted">{what}</td>
                <td class="hidden whitespace-nowrap px-4 py-3.5 font-mono text-[14px] sm:table-cell">{format}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="m-0 text-[15px] leading-relaxed text-ink-muted">{RETURN_WINDOW_DAYS}-day returns: {RETURNS_LINE} <a href="/returns/" class="underline decoration-1 underline-offset-[3px]">Returns and warranty</a></p>
        <div class="flex flex-wrap gap-3">
          <a href={`/targets/charuco-composite/?size=400x300&dictionary=DICT_5X5_100`} class="btn-md btn-primary">See this board</a>
          <a href="/files/" class="btn-md btn-secondary">Sample files</a>
        </div>
      </div>
    </div>
  </section>

  {/* ── From the bench (reviews) — only when >= 3 published reviews ── */}
  {showReviews && (
    <section id="reviews-home" class="border-t border-line">
      <div class="container-x flex flex-col gap-8 py-[var(--section-y)]">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="flex flex-col gap-2.5">
            <span class="section-no">Reviews</span>
            <span class="section-rule"></span>
            <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">What engineers measured</h2>
          </div>
          <p class="m-0 max-w-[460px] text-sm text-ink-muted">
            We publish every review unedited and disclose material connections.
          </p>
        </div>

        <div class="flex gap-5 overflow-x-auto pb-2 scrollbar-none md:grid md:grid-cols-3 md:overflow-visible md:pb-0">
          {featuredReviews.map((r) => (
            <article class="flex w-[85vw] shrink-0 flex-col gap-2.5 card p-5 md:w-auto">
              <div class="flex items-center justify-between gap-2.5">
                <Stars client:load rating={r.stars} />
                <span class="font-mono text-xs text-ink-muted">
                  {new Date(r.created).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              </div>
              {r.title && <h4 class="m-0 text-[16px] font-semibold">{r.title}</h4>}
              <p class="m-0 line-clamp-3 text-[15px] leading-relaxed text-ink-muted">{r.body}</p>
              {(r.tags.camera || r.tags.lensOrFov || r.tags.software) && (
                <div class="flex flex-wrap gap-1.5">
                  {r.tags.camera && <span class="rounded border border-line bg-ground px-2 py-0.5 font-mono text-[12px] text-ink-muted">{r.tags.camera}</span>}
                  {r.tags.lensOrFov && <span class="rounded border border-line bg-ground px-2 py-0.5 font-mono text-[12px] text-ink-muted">{r.tags.lensOrFov}</span>}
                  {r.tags.software && <span class="rounded border border-line bg-ground px-2 py-0.5 font-mono text-[12px] text-ink-muted">{r.tags.software}</span>}
                </div>
              )}
              <div class="flex items-center gap-2 pt-1 text-xs text-ink-muted">
                <span class="font-semibold text-ink">{r.author.initials}</span>
                {r.author.companyType && <span>· {r.author.companyType}</span>}
              </div>
            </article>
          ))}
        </div>

        <a href="/targets/" class="text-[15px] font-medium underline decoration-1 underline-offset-[3px]">
          Read all reviews on the product pages
        </a>
      </div>
    </section>
  )}

  {/* ── Learn + subscribe ── */}
  <section id="learn" class="border-t border-line">
  <div class="container-x flex flex-wrap gap-12 py-[var(--section-y)]">
    {guides.length > 0 && (
      <div class="flex min-w-0 flex-1 basis-[520px] flex-col gap-5">
        <span class="section-no">Guides</span>
        <span class="section-rule"></span>
        <h2 class="m-0 text-[24px] font-semibold md:text-[28px]">How to calibrate, with the numbers</h2>
        <div class="flex flex-col border-t border-line">
          {guides.map((g) => (
            <a href={`/guides/${g.slug}/`} class="flex justify-between gap-4 border-b border-line py-4 text-ink no-underline hover:text-ink">
              <span class="font-medium">{g.data.title}</span><span class="shrink-0 font-mono text-[12px] font-semibold uppercase tracking-[0.04em] text-brand-dark">Read</span>
            </a>
          ))}
        </div>
      </div>
    )}
    <div class="min-w-0 flex-1 basis-[360px] flex flex-col gap-5">
      <NewsletterForm client:load />
    </div>
  </div>
  </section>

  <script>
    import { resolvePartNumber } from '@/lib/partNumberLookup';
    const form = document.getElementById('pn-form') as HTMLFormElement | null;
    const input = document.getElementById('pn-input') as HTMLInputElement | null;
    const msg = document.getElementById('pn-msg');
    if (form && input && msg) {
      const index: Record<string, string> = JSON.parse(form.dataset.index ?? '{}');
      input.addEventListener('input', () => msg.classList.add('hidden'));
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const value = input.value.trim();
        if (!value) { input.focus(); return; }
        const href = resolvePartNumber(value, index);
        if (href) window.location.href = href;
        else msg.classList.remove('hidden');
      });
    }
  </script>
</Base>
