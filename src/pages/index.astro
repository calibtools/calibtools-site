---
import Base from '@/layouts/Base.astro';
import ProductCard from '@/components/ProductCard.astro';
import ToolCard from '@/components/ToolCard.astro';
import NewsletterForm from '@/islands/NewsletterForm';
import { Picture } from 'astro:assets';
import { tools } from '@/lib/tools';
import { stats } from '@/lib/site';
import { getCollections } from '@/lib/shopify';
import { getCollection } from 'astro:content';
import { getProductImages } from '@/lib/product-images';
import { getImageMetadata } from '@/lib/productImageImports';
import { Tag, Truck, FileCheck, Files, RotateCcw, Grid2x2 as Grid2X2, ScanLine, ListChecks, Package, Ruler, CircleDot, Plug, ArrowRight, Mail } from 'lucide-astro';
import { getAllPublishedReviews, HOW_REVIEWS_WORK_SHORT } from '@/lib/reviews';
import { TAGLINE } from '@/lib/claims';
import Stars from '@/components/Stars';
import heroTight from '@/assets/products/brand/dark/hero-boards-tight.webp';
import heroTightMobile from '@/assets/products/brand/dark/hero-boards-tight-mobile.webp';
import familyComposite from '@/assets/products/brand/dark/family-composite.webp';
import familyCeramic from '@/assets/products/brand/dark/family-ceramic.webp';
import familySet from '@/assets/products/brand/dark/family-set.webp';
import familyMounts from '@/assets/products/brand/dark/family-mounts.webp';
import type { ImageMetadata } from 'astro';

/* Override collection card images on the dark home page */
const collectionHeroOverrides: Record<string, ImageMetadata> = {
  'composite-boards': familyComposite,
  'ceramic-glass': familyCeramic,
  'lidar-image-quality': familySet,       // TODO: proper multi-board-sets collection
  'mounts-accessories': familyMounts,
};
/* Override titles where needed */
const collectionTitleOverrides: Record<string, string> = {
  'lidar-image-quality': 'Multi-board sets', // TODO: update when collection handle changes
};

const collections = await getCollections();
const allGuides = await getCollection('guides');

const heroImageMap = new Map<string, ImageMetadata>();
for (const col of collections) {
  for (const p of col.products) {
    const images = getProductImages(p.handle);
    const hero = images.find((img) => img.file === '01-hero.webp');
    if (hero) {
      const meta = getImageMetadata(hero.handle, hero.file);
      if (meta) heroImageMap.set(p.handle, meta);
    }
  }
}

const isReady = (g: typeof allGuides[number]) => !g.body?.includes('[BODY COPY');
const guides = allGuides.filter(isReady).slice(0, 3);

const why = [
  ['Transparent pricing', 'Every size and material priced on the page. No quote forms for standard parts.'],
  ['Lead time you can plan with', 'Made to order, ships in 2\u20133 weeks. Tracked express worldwide.'],
  ['Inspection report included', 'Dimensional check on every board. ILAC-recognised calibration certificate as an add-on.'],
  ['Files you can use', 'Datasheet, CAD and pattern JSON for OpenCV, Kalibr and HALCON with every target.'],
  ['30-day returns', 'Not flat, not accurate, not what you ordered\u2009\u2014\u2009send it back.'],
];

/* Show 3 featured tools on the home page */
const featuredTools = tools.slice(0, 3);

const allReviews = await getAllPublishedReviews();
const showReviews = allReviews.length >= 3;
const featuredReviews = allReviews
  .sort((a, b) => {
    const aScore = (a.tags.camera || a.tags.lensOrFov || a.tags.software ? 1 : 0) + (a.photos.length > 0 ? 1 : 0);
    const bScore = (b.tags.camera || b.tags.lensOrFov || b.tags.software ? 1 : 0) + (b.photos.length > 0 ? 1 : 0);
    return bScore - aScore || new Date(b.created).getTime() - new Date(a.created).getTime();
  })
  .slice(0, 3);
---
<Base title={TAGLINE} theme="dark" ogImage="/og/boards.png" description={`${TAGLINE}. Precision checkerboards, ChArUco, AprilGrid and metrology-grade glass targets, plus free browser tools to generate, size and verify your calibration. Made to order, shipped worldwide.`}>

  {/* ── Hero ── */}
  <section id="top" class="pb-[72px] md:pb-0">
    {/* Desktop: two-column */}
    <div class="container-x hidden items-stretch gap-0 py-10 md:flex lg:py-14">
      {/* Left column 44 % — text */}
      <div class="flex w-[44%] shrink-0 flex-col justify-center gap-6 pr-8">
        <span class="font-mono text-[13px] uppercase tracking-[0.18em] text-brand-text">
          Calibration targets &amp; tools for machine vision
        </span>
        <h1 class="m-0 text-[52px] font-[800] uppercase leading-[1.02] tracking-[-0.02em]" data-hero-h1>
          Measured before<br /><span class="text-brand">it ships</span>
        </h1>
        <p class="m-0 max-w-[460px] text-[18px] leading-[1.5] text-ink-muted">
          Precision checkerboards, ChArUco, AprilGrid and metrology-grade glass targets &mdash; with free browser tools to generate, size and verify your calibration. Made to order, shipped worldwide.
        </p>
        <div class="flex flex-wrap gap-3.5 pt-2">
          <a href="/targets/" class="btn-primary uppercase tracking-[0.1em]">Shop targets</a>
          <a href="/tools/" class="btn-outline uppercase tracking-[0.1em]">Open free tools</a>
        </div>
        <p class="m-0 pt-3 font-mono text-[14px] tracking-[0.1em] text-ink-soft">
          OpenCV &middot; ROS &middot; HALCON &middot; MATLAB &middot; Kalibr
        </p>
      </div>
      {/* Right column 56 % — tight crop image */}
      <div class="relative w-[56%]" data-hero-col>
        <Picture
          src={heroTight}
          widths={[480, 700, 900]}
          formats={['avif', 'webp', 'jpeg']}
          alt="Calib.Tools three calibration boards cropped tight — checkerboard, ChArUco composite and ceramic plate with brand markings, on a dark surface."
          class="w-full hero-fade"
          loading="eager"
          data-hero-img
        />
      </div>
    </div>

    {/* Mobile: stacked */}
    <div class="container-x flex flex-col gap-8 py-12 md:hidden">
      <div class="flex flex-col gap-6">
        <span class="font-mono text-[12px] uppercase tracking-[0.18em] text-brand-text">
          Calibration targets &amp; tools for machine vision
        </span>
        <h1 class="m-0 text-[38px] font-[800] uppercase leading-[1.02] tracking-[-0.02em]">
          Measured before<br /><span class="text-brand">it ships</span>
        </h1>
        <p class="m-0 max-w-[480px] text-[17px] leading-[1.5] text-ink-muted">
          Precision checkerboards, ChArUco, AprilGrid and metrology-grade glass targets &mdash; with free browser tools to generate, size and verify your calibration. Made to order, shipped worldwide.
        </p>
        <div class="flex flex-wrap gap-3.5 pt-2">
          <a href="/targets/" class="btn-primary uppercase tracking-[0.1em]">Shop targets</a>
          <a href="/tools/" class="btn-outline uppercase tracking-[0.1em]">Open free tools</a>
        </div>
        <p class="m-0 pt-3 font-mono text-[13px] tracking-[0.1em] text-ink-soft">
          OpenCV &middot; ROS &middot; HALCON &middot; MATLAB &middot; Kalibr
        </p>
      </div>
      <div class="relative">
        <Picture
          src={heroTightMobile}
          widths={[390, 640, 768]}
          formats={['avif', 'webp', 'jpeg']}
          alt="Calib.Tools three calibration boards in a tight horizontal crop for mobile, with brand markings and coordinate axes."
          class="w-full object-contain hero-fade"
          loading="eager"
        />
      </div>
    </div>
  </section>

  {/* ── Free tools ── */}
  <section id="tools" class="border-y border-line bg-ground-alt">
    <div class="container-x flex flex-col gap-9 py-12 md:py-[72px]">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="flex flex-col gap-2.5">
          <span class="font-mono text-[12px] uppercase tracking-[0.18em] text-brand-text md:text-[13px]">Free tools &middot; runs in your browser</span>
          <h2 class="h-display m-0 text-[28px] md:text-[36px]">Free tools. Serious targets.</h2>
        </div>
        <a href="/tools/" class="inline-flex items-center gap-1 text-[15px] font-semibold">See all tools <ArrowRight size={20} stroke-width={1.6} class="text-brand" aria-hidden="true" /></a>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
        <ToolCard href={featuredTools[0].href} title={featuredTools[0].title} cta={featuredTools[0].live ? featuredTools[0].cta : `${featuredTools[0].cta} (coming soon)`} body={featuredTools[0].body}>
          <Grid2X2 slot="icon" size={20} stroke-width={1.6} class="text-brand" aria-hidden="true" />
        </ToolCard>
        <ToolCard href={featuredTools[1].href} title={featuredTools[1].title} cta={featuredTools[1].live ? featuredTools[1].cta : `${featuredTools[1].cta} (coming soon)`} body={featuredTools[1].body}>
          <ScanLine slot="icon" size={20} stroke-width={1.6} class="text-brand" aria-hidden="true" />
        </ToolCard>
        <ToolCard href={featuredTools[2].href} title={featuredTools[2].title} cta={featuredTools[2].live ? featuredTools[2].cta : `${featuredTools[2].cta} (coming soon)`} body={featuredTools[2].body}>
          <ListChecks slot="icon" size={20} stroke-width={1.6} class="text-brand" aria-hidden="true" />
        </ToolCard>
      </div>
    </div>
  </section>

  {/* ── Targets ── */}
  <section id="products" class="container-x flex flex-col gap-9 py-12 md:py-[72px]">
    <div class="flex flex-col gap-2.5">
      <span class="font-mono text-[12px] uppercase tracking-[0.18em] text-brand-text md:text-[13px]">Calibration targets</span>
      <h2 class="h-display m-0 text-[28px] md:text-[36px]">From checkerboard to certificate.</h2>
    </div>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {collections.map((c) => {
        const firstProduct = c.products[0];
        const overrideImage = collectionHeroOverrides[c.handle];
        const localHero = overrideImage ?? (firstProduct ? heroImageMap.get(firstProduct.handle) : undefined);
        const displayTitle = collectionTitleOverrides[c.handle] ?? c.title;
        return (
          <ProductCard
            href={`/targets/collection/${c.handle}/`}
            title={displayTitle}
            sub={c.description}
            from={firstProduct?.priceFrom ?? ''}
            localImage={localHero}
            image={!localHero ? (c.image ?? firstProduct?.image) : undefined}
            placeholder={displayTitle.toUpperCase()}
          />
        );
      })}
    </div>
  </section>

  {/* ── Why us ── */}
  <section id="why" class="border-y border-[#262626] bg-[#0A0A0A]">
    <div class="container-x flex flex-col gap-10 py-12 md:py-[72px]">
      <h2 class="h-display m-0 max-w-[720px] text-[28px] md:text-[36px]">Built flat. Checked twice.</h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-5">
        {why.map(([title, desc], i) => {
          const icons = [Tag, Truck, FileCheck, Files, RotateCcw];
          const Icon = icons[i];
          return (
            <div class="flex flex-col gap-2 pt-4">
              <div class="mb-1 flex h-[2px]">
                <span class="block h-full w-6 bg-brand"></span>
                <span class="block h-full flex-1 bg-[#333333]"></span>
              </div>
              <div class="relative flex h-10 w-10 items-center justify-center rounded-lg bg-white/[0.06]">
                <Icon size={22} stroke-width={1.6} class="text-white" aria-hidden="true" />
                <span class="absolute -bottom-0.5 -right-0.5 block h-1.5 w-1.5 rounded-full bg-brand"></span>
              </div>
              <strong class="text-[17px]">{title}</strong>
              <span class="text-sm leading-relaxed text-[#A3A3A3]">{desc}</span>
            </div>
          );
        })}
      </div>
      <div class="grid grid-cols-2 gap-8 pt-4 md:grid-cols-4">
        {stats.map((s) => (
          <div class="flex flex-col gap-1">
            <span class="stat text-white">{s.value}</span>
            <span class="text-[13px] text-[#A3A3A3]">{s.caption}</span>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-10 pt-2 font-mono text-sm text-[#A3A3A3]">
        <span>OpenCV</span><span>ROS 2</span><span>MVTec HALCON</span><span>MATLAB</span><span>Kalibr</span><span>COLMAP</span>
      </div>
    </div>
  </section>

  {/* ── From the bench (reviews) — only when >= 3 published reviews ── */}
  {showReviews && (
    <section id="reviews-home" class="border-t border-line">
      <div class="container-x flex flex-col gap-8 py-12 md:py-[72px]">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div class="flex flex-col gap-2.5">
            <span class="font-mono text-[12px] uppercase tracking-[0.18em] text-brand-text md:text-[13px]">From the bench</span>
            <h2 class="h-display m-0 text-[28px] md:text-[36px]">What engineers measured.</h2>
          </div>
          <p class="m-0 max-w-[460px] text-sm text-ink-muted">{HOW_REVIEWS_WORK_SHORT}</p>
        </div>

        <div class="flex gap-5 overflow-x-auto pb-2 scrollbar-none md:grid md:grid-cols-3 md:overflow-visible md:pb-0">
          {featuredReviews.map((r) => (
            <article class="flex w-[85vw] shrink-0 flex-col gap-2.5 rounded border border-line bg-ground-alt p-5 md:w-auto">
              <div class="flex items-center justify-between gap-2.5">
                <Stars client:load rating={r.stars} />
                <span class="font-mono text-xs text-ink-muted">
                  {new Date(r.created).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              </div>
              {r.title && <h4 class="m-0 text-[16px] font-semibold">{r.title}</h4>}
              <p class="m-0 line-clamp-3 text-[15px] leading-relaxed text-ink-muted">{r.body}</p>
              {(r.tags.camera || r.tags.lensOrFov || r.tags.software) && (
                <div class="flex flex-wrap gap-1.5">
                  {r.tags.camera && <span class="rounded border border-line bg-ground px-2 py-0.5 font-mono text-[11px] text-ink-muted">{r.tags.camera}</span>}
                  {r.tags.lensOrFov && <span class="rounded border border-line bg-ground px-2 py-0.5 font-mono text-[11px] text-ink-muted">{r.tags.lensOrFov}</span>}
                  {r.tags.software && <span class="rounded border border-line bg-ground px-2 py-0.5 font-mono text-[11px] text-ink-muted">{r.tags.software}</span>}
                </div>
              )}
              <div class="flex items-center gap-2 pt-1 text-xs text-ink-muted">
                <span class="font-semibold text-ink">{r.author.initials}</span>
                {r.author.companyType && <span>· {r.author.companyType}</span>}
              </div>
            </article>
          ))}
        </div>

        <a href="/targets/" class="text-[15px] font-medium text-brand-dark">
          Read all reviews on the product pages
        </a>
      </div>
    </section>
  )}

  {/* ── Learn + subscribe ── */}
  <section id="learn" class="container-x flex flex-wrap gap-12 py-12 pb-[72px] md:py-[72px]">
    {guides.length > 0 && (
      <div class="flex min-w-0 flex-1 basis-[520px] flex-col gap-5">
        <span class="font-mono text-[12px] uppercase tracking-[0.18em] text-brand-text md:text-[13px]">Knowledge base</span>
        <h2 class="h-display m-0 text-[26px] md:text-[32px]">Where calibration starts.</h2>
        <div class="flex flex-col border-t border-line">
          {guides.map((g) => (
            <a href={`/guides/${g.slug}/`} class="flex justify-between gap-4 border-b border-line py-4 text-ink no-underline hover:text-ink">
              <span class="font-semibold">{g.data.title}</span><ArrowRight size={20} stroke-width={1.6} class="text-brand-dark" aria-hidden="true" />
            </a>
          ))}
        </div>
      </div>
    )}
    <div class="min-w-0 flex-1 basis-[360px] flex flex-col gap-5">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-ground-alt">
        <Mail size={22} stroke-width={1.6} class="text-brand" aria-hidden="true" />
      </div>
      <NewsletterForm client:load />
    </div>
  </section>
</Base>
