---
import Base from '@/layouts/Base.astro';
import ProductCard from '@/components/ProductCard.astro';
import ToolCard from '@/components/ToolCard.astro';
import NewsletterForm from '@/islands/NewsletterForm';
import { tools } from '@/lib/tools';
import { getCollections } from '@/lib/shopify';
import { getCollection } from 'astro:content';
const collections = await getCollections();
const allGuides = await getCollection('guides');
/** Hide guides whose body still contains placeholder copy. */
const isReady = (g: typeof allGuides[number]) => !g.body?.includes('[BODY COPY');
const guides = allGuides.filter(isReady).slice(0, 3);
const why = [
  ['Transparent pricing', 'Every size and material priced on the page. No quote forms for standard parts.'],
  ['EU stock, 2–4 days', 'Core targets ship from Germany. DDP to the US on request.'],
  ['Inspection report included', 'Dimensional check on every board. ILAC-recognised calibration certificate as an add-on.'],
  ['Files you can use', 'Datasheet, CAD and pattern JSON for OpenCV, Kalibr and HALCON with every target.'],
  ['30-day returns', 'Not flat, not accurate, not what you ordered — send it back.'],
];
---
<Base title="Calibrate with confidence" description="Precision checkerboards, ChArUco, AprilGrid and metrology-grade glass targets, plus free browser tools to generate, size and verify your calibration. Shipped from Europe in 2–4 days.">
  <!-- Hero -->
  <section class="container-x flex flex-wrap items-center gap-12 py-12 md:py-20" id="top">
    <div class="flex min-w-0 flex-1 basis-[520px] flex-col gap-6">
      <span class="eyebrow">Calibration targets &amp; tools for machine vision</span>
      <h1 class="h-display m-0 text-[40px] leading-[1.08] md:text-[68px] md:leading-[1.02]">Calibrate with <span class="text-brand">confidence.</span></h1>
      <p class="m-0 max-w-[560px] text-lg leading-relaxed text-ink-muted md:text-xl">Precision checkerboards, ChArUco, AprilGrid and metrology-grade glass targets — with free browser tools to generate, size and verify your calibration. Shipped from Europe in 2–4 days.</p>
      <div class="flex flex-wrap gap-3.5 pt-2">
        <a href="/targets/" class="btn-primary">Shop targets</a>
        <a href="/tools/" class="btn-outline">Open free tools</a>
      </div>
      <p class="m-0 pt-3 text-sm text-ink-muted">Works with OpenCV · ROS · HALCON · MATLAB · Kalibr</p>
    </div>
    <div class="flex min-w-0 flex-1 basis-[440px] justify-center">
      <div class="relative aspect-[4/3] w-full max-w-[520px] overflow-hidden rounded-xl bg-ground-panel flex items-center justify-center">
        <!-- TODO: replace with real product photo -->
        <div class="grid grid-cols-10 -rotate-6 shadow-[0_24px_60px_rgba(0,0,0,0.18)]" aria-hidden="true">
          {Array.from({ length: 70 }).map((_, i) => <span class={`h-9 w-9 ${(Math.floor(i / 10) + i) % 2 === 0 ? 'bg-ink' : 'bg-white'}`}></span>)}
        </div>
        <span class="absolute bottom-3.5 right-4 font-mono text-xs text-ink-soft">[PRODUCT PHOTO]</span>
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section id="tools" class="border-y border-line-light bg-ground-alt">
    <div class="container-x flex flex-col gap-9 py-12 md:py-[72px]">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="flex flex-col gap-2.5">
          <span class="eyebrow">Free tools · runs in your browser</span>
          <h2 class="h-display m-0 text-[28px] md:text-[40px]">Free tools. Serious targets.</h2>
        </div>
        <a href="/tools/" class="text-[15px] font-semibold">See all tools →</a>
      </div>
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-4">
        {tools.map((t) => (
          <ToolCard href={t.href} title={t.title} cta={t.live ? t.cta : `${t.cta} (coming soon)`} body={t.body} />
        ))}
      </div>
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="container-x flex flex-col gap-9 py-12 md:py-[72px]">
    <div class="flex flex-col gap-2.5">
      <span class="eyebrow">Calibration targets</span>
      <h2 class="h-display m-0 text-[28px] md:text-[40px]">From checkerboard to certificate.</h2>
    </div>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {collections.map((c) => {
        const firstProduct = c.products[0];
        return (
          <ProductCard
            href={`/targets/collection/${c.handle}/`}
            title={c.title}
            sub={c.description}
            from={firstProduct?.priceFrom ?? ''}
            image={c.image ?? firstProduct?.image}
            placeholder={c.title.toUpperCase()}
          />
        );
      })}
    </div>
  </section>

  <!-- Why -->
  <section id="why" class="bg-ink text-white">
    <div class="container-x flex flex-col gap-10 py-12 md:py-[72px]">
      <h2 class="h-display m-0 max-w-[720px] text-[28px] md:text-[40px]">Built flat. Measured twice. Shipped fast.</h2>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-5">
        {why.map(([t, b]) => (
          <div class="flex flex-col gap-2 border-t-2 border-brand pt-4">
            <strong class="text-[17px]">{t}</strong>
            <span class="text-sm leading-relaxed text-[#CFCFCF]">{b}</span>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-10 pt-2 font-mono text-sm text-[#9A9A9A]">
        <span>OpenCV</span><span>ROS 2</span><span>MVTec HALCON</span><span>MATLAB</span><span>Kalibr</span><span>COLMAP</span>
      </div>
    </div>
  </section>

  <!-- Learn + subscribe -->
  <section id="learn" class="container-x flex flex-wrap gap-12 py-12 md:py-[72px]">
    {guides.length > 0 && (
      <div class="flex min-w-0 flex-1 basis-[520px] flex-col gap-5">
        <span class="eyebrow">Knowledge base</span>
        <h2 class="h-display m-0 text-[26px] md:text-[32px]">Where calibration starts.</h2>
        <div class="flex flex-col border-t border-line">
          {guides.map((g) => (
            <a href={`/guides/${g.slug}/`} class="flex justify-between gap-4 border-b border-line py-4 text-ink no-underline hover:text-ink">
              <span class="font-semibold">{g.data.title}</span><span class="text-brand-dark">→</span>
            </a>
          ))}
        </div>
      </div>
    )}
    <div class="min-w-0 flex-1 basis-[360px]">
      <NewsletterForm client:load />
    </div>
  </section>
</Base>
