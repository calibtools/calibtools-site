---
/**
 * Cookie banner and tag loader. Rendered by Base.astro only when a tag is configured (src/lib/tags.ts).
 * Tags are on by default for every visitor, with a way out under "Options"; visitors in the United States
 * also see the "Do not sell or share" link. The choice is kept in localStorage; "Privacy settings" in the footer reopens it.
 */
---
<div id="ct-consent" hidden class="fixed inset-x-0 bottom-0 z-[70] border-t border-ink bg-sheet" role="region" aria-label="Cookie choices">
  <div class="container-x flex flex-col gap-4 py-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex max-w-[640px] flex-col gap-2">
      <p class="m-0 text-[14px]">We use analytics and marketing cookies to see which pages help and to show our ads to people who visited. You can switch them off under Options.</p>
      <fieldset class="m-0 hidden flex-wrap gap-x-6 gap-y-2 border-0 p-0" data-consent-detail>
        <legend class="sr-only">Cookie categories</legend>
        <label class="flex min-h-[44px] items-center gap-2 text-[14px] md:min-h-0"><input type="checkbox" checked disabled /> Necessary (cart, sign-in)</label>
        <label class="flex min-h-[44px] items-center gap-2 text-[14px] md:min-h-0"><input type="checkbox" data-consent-box="analytics" /> Analytics</label>
        <label class="flex min-h-[44px] items-center gap-2 text-[14px] md:min-h-0"><input type="checkbox" data-consent-box="marketing" /> Marketing</label>
      </fieldset>
      <div class="flex flex-wrap gap-x-6 gap-y-1 text-[13px]">
        <a href="/privacy/">Privacy policy</a>
        <button type="button" class="text-left text-brand-dark underline underline-offset-[3px]" data-consent-act="reject" data-consent-us hidden>Do not sell or share my personal information</button>
      </div>
    </div>
    <div class="flex flex-wrap gap-3">
      <button type="button" class="btn btn-md btn-secondary" data-consent-act="choose">Options</button>
      <button type="button" class="btn btn-md btn-secondary hidden" data-consent-act="save">Save choices</button>
      <button type="button" class="btn btn-md btn-secondary" data-consent-act="reject">Turn off</button>
      <button type="button" class="btn btn-md btn-secondary" data-consent-act="accept">Accept</button>
    </div>
  </div>
</div>
<script>
  import { STORAGE_KEY, SHOPIFY_SYNC_KEY, shopifyConsent, regionFor, parseChoice, serializeChoice, effectiveChoice, bannerNeeded, consentMode, type Choice, type Region } from '@/lib/consent';
  import { TAG_IDS, tagsToLoad, SHOPIFY_CONSENT_SCRIPT, CHECKOUT_DOMAIN, STOREFRONT_DOMAIN, STOREFRONT_TOKEN } from '@/lib/tags';

  const el = document.getElementById('ct-consent')!;
  const gpc = (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true;
  const read = (): Choice | null => { try { return parseChoice(localStorage.getItem(STORAGE_KEY)); } catch { return null; } };
  const write = (c: Choice) => { try { localStorage.setItem(STORAGE_KEY, serializeChoice(c)); } catch { /* private mode: applies to this page only */ } };
  const loaded = new Set<string>();
  type W = Window & { dataLayer?: unknown[]; gtag?: (...a: unknown[]) => void; _linkedin_partner_id?: string; _linkedin_data_partner_ids?: string[] };
  const w = window as W;

  function apply(choice: Choice) {
    const tags = tagsToLoad(TAG_IDS, choice);
    const google = tags.filter((t) => t.key === 'ga4' || t.key === 'googleAds');
    if (google.length) {
      if (!w.gtag) {
        w.dataLayer = w.dataLayer ?? [];
        // gtag expects the arguments object itself
        w.gtag = function () { w.dataLayer!.push(arguments); } as W['gtag'];
        w.gtag!('consent', 'default', consentMode({ v: 1, analytics: false, marketing: false, t: 0 }));
        w.gtag!('js', new Date());
      }
      w.gtag!('consent', 'update', consentMode(choice));
    }
    for (const t of tags) {
      if (loaded.has(t.key)) continue;
      loaded.add(t.key);
      if (t.key === 'ga4' || t.key === 'googleAds') w.gtag!('config', t.id);
      if (t.key === 'linkedin') { w._linkedin_partner_id = t.id; (w._linkedin_data_partner_ids = w._linkedin_data_partner_ids ?? []).push(t.id); }
      if ((t.key === 'ga4' || t.key === 'googleAds') && document.querySelector('script[data-ct-tag="google"]')) continue;
      const s = document.createElement('script');
      s.async = true;
      s.src = t.src;
      s.dataset.ctTag = t.key === 'ga4' || t.key === 'googleAds' ? 'google' : t.key;
      document.head.appendChild(s);
    }
  }

  /** Remove Google Analytics cookies already on the device once analytics is switched off. */
  function dropAnalyticsCookies() {
    const host = location.hostname;
    const domains = ['', `; domain=${host}`, `; domain=.${host.split('.').slice(-2).join('.')}`];
    for (const name of document.cookie.split('; ').map((c) => c.split('=')[0]).filter((n) => n === '_ga' || n.startsWith('_ga_'))) {
      for (const d of domains) document.cookie = `${name}=; Max-Age=0; path=/${d}`;
    }
  }

  /** Pass an explicit choice on to Shopify once, so the checkout on the shop domain follows it. */
  function syncShopify(c: Choice) {
    try {
      if (!STOREFRONT_TOKEN || localStorage.getItem(SHOPIFY_SYNC_KEY) === String(c.t)) return;
    } catch { return; }
    type Privacy = { setTrackingConsent: (o: Record<string, unknown>, cb: (r?: { error?: unknown }) => void) => void };
    const send = () => {
      const api = (window as Window & { Shopify?: { customerPrivacy?: Privacy } }).Shopify?.customerPrivacy;
      api?.setTrackingConsent(
        { ...shopifyConsent(c), headlessStorefront: true, checkoutRootDomain: CHECKOUT_DOMAIN, storefrontRootDomain: STOREFRONT_DOMAIN, storefrontAccessToken: STOREFRONT_TOKEN },
        (r) => { if (!r?.error) { try { localStorage.setItem(SHOPIFY_SYNC_KEY, String(c.t)); } catch { /* next page tries again */ } } },
      );
    };
    if (document.querySelector('script[data-ct-tag="shopify-consent"]')) { send(); return; }
    const s = document.createElement('script');
    s.async = true;
    s.src = SHOPIFY_CONSENT_SCRIPT;
    s.dataset.ctTag = 'shopify-consent';
    s.onload = send;
    document.head.appendChild(s);
  }

  function show(region: Region, current: Choice) {
    el.querySelectorAll<HTMLElement>('[data-consent-us]').forEach((n) => { n.hidden = region !== 'us'; });
    el.querySelectorAll<HTMLInputElement>('[data-consent-box]').forEach((b) => { b.checked = current[b.dataset.consentBox as 'analytics' | 'marketing']; });
    // First view: "Options" and "Accept". "Turn off" sits behind "Options"; in the United States the
    // "Do not sell or share" link also stays in view.
    el.querySelector<HTMLElement>('button.btn[data-consent-act="reject"]')!.classList.add('hidden');
    el.hidden = false;
  }

  function decide(c: Choice) {
    const had = loaded.size > 0;
    write(c);
    el.hidden = true;
    if (!c.analytics) dropAnalyticsCookies();
    // Scripts that already ran cannot be unloaded: start clean when something was switched off
    if (had && tagsToLoad(TAG_IDS, c).length < loaded.size) location.reload();
    else { apply(c); syncShopify(c); }
  }

  async function start(reopen = false) {
    const stored = read();
    if (stored && !reopen) { apply(effectiveChoice(stored, gpc)); syncShopify(effectiveChoice(stored, gpc)); return; }
    const current = effectiveChoice(stored, gpc);
    if (!reopen) apply(current);
    let country = '';
    try { country = (await (await fetch('/api/geo', { headers: { Accept: 'application/json' } })).json()).country ?? ''; } catch { /* unknown: no United States link */ }
    const region = regionFor(country);
    if (reopen || bannerNeeded(stored)) show(region, current);
    el.onclick = (e) => {
      const act = (e.target as HTMLElement).closest<HTMLElement>('[data-consent-act]')?.dataset.consentAct;
      if (!act) return;
      const now = Date.now();
      if (act === 'accept') decide({ v: 1, analytics: true, marketing: !gpc, t: now });
      if (act === 'reject') decide({ v: 1, analytics: false, marketing: false, t: now });
      if (act === 'save') {
        const box = (k: string) => el.querySelector<HTMLInputElement>(`[data-consent-box="${k}"]`)!.checked;
        decide({ v: 1, analytics: box('analytics'), marketing: box('marketing'), t: now });
      }
      if (act === 'choose') {
        el.querySelector<HTMLElement>('[data-consent-detail]')!.classList.replace('hidden', 'flex');
        el.querySelector<HTMLElement>('[data-consent-act="save"]')!.classList.remove('hidden');
        el.querySelector<HTMLElement>('[data-consent-act="choose"]')!.classList.add('hidden');
        el.querySelector<HTMLElement>('button.btn[data-consent-act="reject"]')!.classList.remove('hidden');
      }
    };
  }

  start();
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-consent-open]')) start(true);
  });
</script>
