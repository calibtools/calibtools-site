---
/**
 * Site logo for header (and the same files in Footer.astro).
 * Rule (2026-11-08): header and footer use only the framed wordmark —
 * positive on light grounds, negative on dark grounds, red dot in both, with ™
 * (the -tm files are generated by scripts/brand-tm.ts from the brand-kit originals).
 * The C.T icon is used only as the favicon.
 */
interface Props { theme?: 'dark' | 'light' }
const { theme = 'light' } = Astro.props;
const dark = theme === 'dark';
---
<a href="/" class="flex items-center" aria-label="Calib.Tools home">
  <img
    src={dark ? '/brand/wordmark-framed-dark-tm.svg' : '/brand/wordmark-framed-light-tm.svg'}
    alt="Calib.Tools"
    width="180"
    height="40"
    class="h-8 w-auto lg:h-10"
  />
</a>
