---
interface Props { theme?: 'dark' | 'light' }
const { theme = 'light' } = Astro.props;
const src = theme === 'dark' ? '/brand/logo-circle-dark.svg' : '/brand/logo-circle-light.svg';
---
<a href="/" class="flex items-center" aria-label="Calib.Tools home">
  <img src={src} alt="Calib.Tools" class="h-14 w-14 md:h-[76px] md:w-[76px]" />
</a>
