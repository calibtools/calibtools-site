---
import { ArrowRight } from 'lucide-astro';
interface Props { href: string; title: string; body: string; cta: string }
const { href, title, body, cta } = Astro.props;
---
<!-- Three shared rows (title, copy, action) so cards in one row line up: DESIGN.md §3 "Card rows" -->
<div class="card rows-3 gap-y-3.5 p-7">
  <h3 class="m-0 text-xl font-bold">{title}</h3>
  <p class="m-0 text-[15px] leading-relaxed text-ink-muted">{body}</p>
  <a href={href} class="self-end justify-self-start inline-flex items-center gap-1 text-[15px] font-semibold min-h-[24px] [html[data-theme=dark]_&]:text-brand-on-dark">{cta} <ArrowRight size={16} stroke-width={1.6} aria-hidden="true" /></a>
</div>
