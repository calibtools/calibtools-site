---
import { ArrowRight } from 'lucide-astro';
interface Props { href: string; title: string; body: string; cta: string }
const { href, title, body, cta } = Astro.props;
---
<div class="card flex flex-col gap-3.5 p-7">
  <slot name="icon" />
  <h3 class="m-0 text-xl font-bold">{title}</h3>
  <p class="m-0 text-[15px] leading-relaxed text-ink-muted">{body}</p>
  <a href={href} class="mt-auto inline-flex items-center gap-1 text-[15px] font-semibold">{cta} <ArrowRight size={16} stroke-width={1.6} aria-hidden="true" /></a>
</div>
