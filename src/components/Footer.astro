---
import { FOOTER_LINE } from '@/lib/claims';
import { footerGroups } from '@/lib/nav';
---
<footer class="border-t border-line">
  <div class="container-x grid grid-cols-2 gap-[var(--nav-space-8)] py-[var(--nav-space-10)] md:grid-cols-4 md:py-[var(--nav-space-12)]">
    {footerGroups.map((group) => (
      <div class="flex flex-col">
        <span class="font-mono text-[length:var(--nav-text-sm)] font-bold uppercase tracking-[0.10em] text-ink mb-[var(--nav-space-4)]">{group.heading}</span>
        <div class="flex flex-col gap-[var(--nav-space-3)]">
          {group.items.map((item) => (
            <a href={item.href} class="text-[length:var(--nav-text-base)] leading-[20px] text-ink-soft no-underline hover:text-ink min-h-[44px] md:min-h-[24px] flex items-center">{item.label}</a>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="container-x flex flex-col gap-[var(--nav-space-5)] border-t border-line pb-[var(--nav-space-8)] pt-[var(--nav-space-6)]">
    <div class="flex items-center gap-[var(--nav-space-3)]">
      <img src="/brand/wordmark-framed-light.svg" alt="Calib.Tools" width="126" height="28" class="h-7" />
      <span class="text-[length:var(--nav-text-sm)] text-ink-soft">{FOOTER_LINE}</span>
    </div>
  </div>
</footer>
