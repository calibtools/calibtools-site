---
import { FOOTER_LINE } from '@/lib/claims';
import { footerGroups } from '@/lib/nav';
---
<footer class="border-t border-line-strong">
  <div class="container-x grid grid-cols-2 gap-8 py-10 md:grid-cols-4 md:py-14">
    {footerGroups.map((group) => (
      <div class="flex flex-col gap-3">
        <span class="font-mono text-[12px] uppercase tracking-[0.08em] text-ink-soft">{group.heading}</span>
        {group.items.map((item) => (
          <a href={item.href} class="text-sm text-ink-soft no-underline hover:text-ink">{item.label}</a>
        ))}
      </div>
    ))}
  </div>
  <div class="container-x border-t border-line-strong py-6">
    <div class="flex items-center gap-3">
      <img src="/brand/wordmark-framed-light.svg" alt="Calib.Tools" class="h-7 [html[data-theme=dark]_&]:hidden" />
      <img src="/brand/wordmark-framed-dark.svg" alt="" class="h-7 hidden [html[data-theme=dark]_&]:block" aria-hidden="true" />
      <span class="text-sm text-ink-soft">{FOOTER_LINE}</span>
    </div>
  </div>
</footer>
