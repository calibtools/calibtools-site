---
import { FOOTER_LINE } from '@/lib/claims';
import { MISSION_LINE } from '@/lib/brand';
import { footerGroups } from '@/lib/nav';
import { TAG_IDS, anyTagConfigured } from '@/lib/tags';
const tagsOn = anyTagConfigured(TAG_IDS);
---
<footer class="border-t border-line">
  <div class="container-x grid grid-cols-2 gap-[var(--nav-space-8)] py-[var(--nav-space-10)] md:grid-cols-3 lg:grid-cols-5 md:py-[var(--nav-space-12)]">
    {footerGroups.map((group) => (
      <div class="rows-2 gap-y-0">
        <span class="font-mono text-[length:var(--nav-text-sm)] font-bold uppercase tracking-[0.10em] text-ink mb-[var(--nav-space-4)]">{group.heading}</span>
        <div class="flex flex-col gap-[var(--nav-space-3)]">
          {group.items.map((item) => (
            <a href={item.href} class="text-[length:var(--nav-text-base)] leading-[20px] text-ink-soft no-underline hover:text-ink min-h-[44px] md:min-h-[24px] flex items-center">{item.label}</a>
          ))}
        </div>
      </div>
    ))}
  </div>
  <div class="container-x grid grid-cols-1 gap-[var(--nav-space-6)] border-t border-line pb-[var(--nav-space-8)] pt-[var(--nav-space-6)] md:grid-cols-[1fr_auto] md:items-end md:gap-[var(--nav-space-10)]">
    <section aria-label="Our mission" class="border border-line-strong bg-sheet md:order-2 md:w-[330px] lg:w-[500px]">
      <p class="m-0 flex items-start gap-3 px-4 py-4 text-[18px] font-semibold leading-[26px] tracking-[-0.01em] text-ink md:text-[20px] md:leading-[28px]"><span class="mt-[8px] inline-block h-[10px] w-[10px] shrink-0 bg-brand md:mt-[9px]" aria-hidden="true"></span>{MISSION_LINE}</p>
    </section>
    <div class="flex flex-wrap items-center gap-x-[var(--nav-space-3)] gap-y-[var(--nav-space-2)] md:order-1">
      <img src="/brand/wordmark-framed-light.svg" alt="Calib.Tools" width="126" height="28" class="h-7" />
      <span class="text-[length:var(--nav-text-sm)] text-ink-soft">{FOOTER_LINE}</span>
      {tagsOn && <button type="button" data-consent-open class="min-h-[44px] text-[length:var(--nav-text-sm)] text-ink-soft underline underline-offset-[3px] md:min-h-0">Privacy settings</button>}
    </div>
  </div>
</footer>
