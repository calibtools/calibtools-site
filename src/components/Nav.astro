---
import Logo from './Logo.astro';
import CartBadge from '@/islands/CartBadge';
import { ShoppingCart, Menu, X, ChevronDown } from 'lucide-astro';
import { headerGroups } from '@/lib/nav';

interface Props { section?: string; theme?: 'dark' | 'light' }
const { section, theme = 'light' } = Astro.props;
const dark = theme === 'dark';

/** Separate live items from coming-soon items for the "Coming:" line. */
function splitLive(items: { label: string; href: string; live?: boolean }[]) {
  const live = items.filter(i => i.live !== false);
  const coming = items.filter(i => i.live === false);
  return { live, coming };
}
---

<nav
  class:list={[
    'sticky top-0 z-50 backdrop-blur-[14px]',
    dark
      ? 'bg-[rgba(10,10,10,0.82)] border-b border-white/[0.08]'
      : 'bg-[rgba(255,255,255,0.86)] border-b border-black/[0.08]',
  ]}
  aria-label="Main"
  data-nav-bar
>
  <div class="container-x flex items-center h-[var(--nav-header-h)] transition-[height] duration-150">
    {/* ── Desktop header ── */}
    <div class="hidden lg:flex items-center justify-between gap-[var(--nav-space-2)] w-full">
      <Logo theme={theme} />

      <div class="flex items-center gap-[var(--nav-space-1)]">
        {headerGroups.map((group) => {
          const isDropdown = group.items || group.columns;
          const isCurrent = section === group.key;
          if (!isDropdown) {
            return (
              <a
                href={group.href}
                class:list={[
                  'inline-flex items-center gap-0.5 px-[var(--nav-space-3)] py-[var(--nav-space-2)] text-[length:var(--nav-text-base)] font-medium whitespace-nowrap no-underline rounded transition-colors',
                  isCurrent ? 'text-brand' : 'text-ink hover:text-brand',
                ]}
              >
                {group.label}
              </a>
            );
          }
          return (
            <div class="relative" data-nav-disclosure>
              <button
                type="button"
                class:list={[
                  'inline-flex items-center gap-0.5 px-[var(--nav-space-3)] py-[var(--nav-space-2)] text-[length:var(--nav-text-base)] font-medium whitespace-nowrap rounded transition-colors',
                  isCurrent ? 'text-brand' : 'text-ink hover:text-brand',
                ]}
                aria-expanded="false"
                data-nav-trigger
              >
                {group.label}
                <ChevronDown size={12} stroke-width={2} aria-hidden="true" class="ml-0.5 transition-transform duration-150" data-chevron />
              </button>

              {group.columns ? (
                /* ── Mega-menu (Targets) ── */
                <div
                  class="absolute left-1/2 -translate-x-1/2 top-full pt-1 hidden w-[660px]"
                  data-nav-panel
                >
                  <div class="rounded-lg border border-line bg-ground shadow-lg">
                  <div class="grid grid-cols-3 gap-0 p-[var(--nav-space-5)]" data-mega-grid>
                    {group.columns.map((col) => {
                      const { live: liveItems, coming } = splitLive(col.items);
                      return (
                        <div data-mega-col>
                          <div class="font-mono text-[length:var(--nav-text-xs)] font-medium uppercase tracking-[0.06em] text-ink-soft mb-[var(--nav-space-2)] whitespace-nowrap">{col.heading}</div>
                          <div class="flex flex-col gap-px">
                            {liveItems.map((item) => (
                              <a
                                href={item.href}
                                class="block rounded px-[var(--nav-space-2)] py-[6px] text-[length:var(--nav-text-base)] whitespace-nowrap no-underline transition-colors text-ink hover:bg-brand-tint hover:text-brand"
                              >
                                {item.label}
                              </a>
                            ))}
                            {coming.length > 0 && (
                              <div class="max-w-full px-[var(--nav-space-2)] py-[6px] text-[length:var(--nav-text-sm)] leading-[1.5] text-ink-soft/50" data-coming-line>
                                Coming: {coming.map(c => c.label).join(', ')}
                              </div>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                  </div>
                </div>
              ) : (
                /* ── Regular dropdown (Tools / Support) ── */
                <div
                  class="absolute left-0 top-full pt-1 hidden w-[280px]"
                  data-nav-panel
                >
                  <div class="rounded-lg border border-line bg-ground shadow-lg">
                  <div class="flex flex-col p-[var(--nav-space-1)]">
                    {group.items!.map((item, idx) => (
                      <a
                        href={item.href}
                        class:list={[
                          'flex flex-col gap-0.5 rounded px-[var(--nav-space-3)] py-[var(--nav-space-2)] no-underline transition-colors text-ink hover:bg-brand-tint hover:text-brand',
                          idx === 0 && group.key === 'tools' ? 'mb-[var(--nav-space-2)] pb-[var(--nav-space-3)] border-b border-line' : '',
                        ]}
                      >
                        <span class:list={[
                          'text-[length:var(--nav-text-base)] whitespace-nowrap',
                          idx === 0 && group.key === 'tools' ? 'font-semibold' : 'font-medium',
                        ]}>{item.label}</span>
                        {item.description && (
                          <span class="text-[length:var(--nav-text-sm)] text-ink-soft leading-snug line-clamp-2">{item.description}</span>
                        )}
                      </a>
                    ))}
                  </div>
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>

      <div class="flex items-center gap-[var(--nav-space-6)]">
        <a
          href="/quote/"
          class="text-[length:var(--nav-text-base)] font-medium whitespace-nowrap no-underline text-ink hover:text-brand hover:underline underline-offset-4 decoration-brand"
        >
          Request a quote
        </a>
        <div class="flex items-center gap-[var(--nav-space-2)]">
          <a href="/targets/" class="btn-md btn-primary whitespace-nowrap">
            Shop targets
          </a>
          <button
            type="button"
            class:list={[
              'relative flex items-center justify-center rounded',
              'h-[var(--nav-cart-h)] w-[var(--nav-cart-h)]',
              dark
                ? 'border-[1.5px] border-white/20 hover:border-white/40'
                : 'border-[1.5px] border-line hover:border-ink',
            ]}
            aria-label="Open cart"
            data-open-cart
          >
            <ShoppingCart size={18} stroke-width={1.6} aria-hidden="true" />
            <span class="absolute -right-1.5 -top-1.5"><CartBadge client:load /></span>
          </button>
        </div>
      </div>
    </div>

    {/* ── Mobile header ── */}
    <div class="flex lg:hidden items-center justify-between w-full">
      <button
        type="button"
        class:list={[
          'flex items-center justify-center rounded',
          'h-[var(--nav-cart-h)] w-[var(--nav-cart-h)]',
          dark ? 'border-[1.5px] border-white/20' : 'border-[1.5px] border-ink',
        ]}
        aria-label="Open menu"
        aria-expanded="false"
        data-mobile-toggle
      >
        <Menu size={18} stroke-width={1.6} aria-hidden="true" data-menu-icon />
        <X size={18} stroke-width={1.6} aria-hidden="true" class="hidden" data-close-icon />
      </button>

      <div class="absolute left-1/2 -translate-x-1/2">
        <Logo theme={theme} />
      </div>

      <div class="h-[var(--nav-cart-h)] w-[var(--nav-cart-h)]" aria-hidden="true"></div>
    </div>
  </div>

  {/* ── Mobile drawer ── */}
  <div
    class:list={[
      'hidden lg:!hidden overflow-y-auto',
      dark ? 'border-t border-white/[0.08]' : 'border-t border-black/[0.08]',
    ]}
    style="max-height: calc(100dvh - var(--nav-header-h));"
    data-mobile-drawer
    role="dialog"
    aria-label="Navigation menu"
  >
    <div class="container-x py-[var(--nav-space-2)] flex flex-col gap-0">
      {headerGroups.map((group) => {
        const isDropdown = group.items || group.columns;
        if (!isDropdown) {
          return (
            <a
              href={group.href}
              class="flex items-center min-h-[48px] px-[var(--nav-space-3)] text-[length:var(--nav-text-base)] font-medium no-underline text-ink hover:text-brand rounded"
            >
              {group.label}
            </a>
          );
        }
        const allItems = group.columns
          ? group.columns.flatMap((col) => {
              const { live: liveItems, coming } = splitLive(col.items);
              return [
                { label: col.heading, isHeading: true, href: '', live: true, items: [] as any[] },
                ...liveItems.map((i) => ({ ...i, isHeading: false })),
                ...(coming.length > 0 ? [{ label: 'Coming: ' + coming.map(c => c.label).join(', '), isHeading: false, href: '', live: false, isComing: true }] : []),
              ];
            })
          : (group.items || []).map((i, idx) => ({ ...i, isHeading: false, isFirst: idx === 0 && group.key === 'tools' }));
        return (
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between min-h-[48px] px-[var(--nav-space-3)] text-[length:var(--nav-text-base)] font-medium select-none text-ink hover:text-brand rounded [&::-webkit-details-marker]:hidden list-none">
              <span>{group.label}</span>
              <ChevronDown size={14} stroke-width={2} aria-hidden="true" class="text-ink-soft transition-transform duration-150 group-open:rotate-180" />
            </summary>
            <div class="flex flex-col gap-0 pb-[var(--nav-space-2)] pl-[var(--nav-space-3)]">
              {allItems.map((item) => {
                if (item.isHeading) {
                  return (
                    <div class="font-mono text-[length:var(--nav-text-sm)] font-bold uppercase tracking-[0.10em] text-ink mt-[var(--nav-space-3)] mb-[var(--nav-space-1)] px-[var(--nav-space-3)]">{item.label}</div>
                  );
                }
                if ('isComing' in item && item.isComing) {
                  return (
                    <div class="min-h-[44px] flex items-center px-[var(--nav-space-3)] text-[length:var(--nav-text-sm)] text-ink-soft/50">{item.label}</div>
                  );
                }
                const isPromoted = 'isFirst' in item && item.isFirst;
                return (
                  <a
                    href={item.href}
                    class:list={[
                      'flex items-center min-h-[44px] rounded px-[var(--nav-space-3)] text-[length:var(--nav-text-base)] no-underline text-ink hover:text-brand hover:bg-brand-tint',
                      isPromoted ? 'font-semibold' : '',
                    ]}
                  >
                    {item.label}
                  </a>
                );
              })}
            </div>
          </details>
        );
      })}

      {/* Request a quote in mobile drawer */}
      <div class="mt-[var(--nav-space-2)] border-t border-line pt-[var(--nav-space-2)]">
        <a href="/quote/" class="flex items-center min-h-[48px] px-[var(--nav-space-3)] text-[length:var(--nav-text-base)] font-medium no-underline text-ink hover:text-brand rounded">
          Request a quote
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  // ── Scroll-aware header height ──
  const navBar = document.querySelector('[data-nav-bar]') as HTMLElement;
  let lastScroll = 0;
  function onScroll() {
    const y = window.scrollY;
    if (y > 20 && lastScroll <= 20) {
      navBar?.style.setProperty('--nav-header-h', 'var(--nav-header-h-scrolled)');
    } else if (y <= 20 && lastScroll > 20) {
      navBar?.style.removeProperty('--nav-header-h');
    }
    lastScroll = y;
  }
  window.addEventListener('scroll', onScroll, { passive: true });

  // ── Desktop disclosure navigation (APG pattern + menu-aim) ──
  const disclosures = document.querySelectorAll('[data-nav-disclosure]');
  const hoverEnabled = matchMedia('(hover: hover)').matches;

  // Menu-aim: ray-cast from prev→curr against panel rect
  function shouldKeepOpen(prev: {x:number;y:number}, curr: {x:number;y:number}, r: DOMRect): boolean {
    const dx = curr.x - prev.x, dy = curr.y - prev.y;
    if (dx === 0 && dy === 0) return false;
    let tMin = 0, tMax = Infinity;
    if (dx !== 0) {
      const t1 = (r.left - curr.x) / dx, t2 = (r.right - curr.x) / dx;
      tMin = Math.max(tMin, Math.min(t1, t2));
      tMax = Math.min(tMax, Math.max(t1, t2));
    } else if (curr.x < r.left || curr.x > r.right) return false;
    if (dy !== 0) {
      const t1 = (r.top - curr.y) / dy, t2 = (r.bottom - curr.y) / dy;
      tMin = Math.max(tMin, Math.min(t1, t2));
      tMax = Math.min(tMax, Math.max(t1, t2));
    } else if (curr.y < r.top || curr.y > r.bottom) return false;
    return tMax >= tMin && tMax >= 0;
  }

  let closeTimer: ReturnType<typeof setTimeout> | null = null;
  let intentTimer: ReturnType<typeof setTimeout> | null = null;
  let prevPoint = { x: 0, y: 0 };
  let activeDisc: Element | null = null;

  function clearCloseTimer() { if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; } }
  function clearIntentTimer() { if (intentTimer) { clearTimeout(intentTimer); intentTimer = null; } }

  function openPanel(disc: Element) {
    const btn = disc.querySelector('[data-nav-trigger]') as HTMLButtonElement;
    const panel = disc.querySelector('[data-nav-panel]') as HTMLElement;
    const chevron = disc.querySelector('[data-chevron]') as HTMLElement;
    if (!btn || !panel) return;
    btn.setAttribute('aria-expanded', 'true');
    panel.classList.remove('hidden');
    chevron?.classList.add('rotate-180');
    activeDisc = disc;
  }

  function closePanel(disc: Element) {
    const btn = disc.querySelector('[data-nav-trigger]') as HTMLButtonElement;
    const panel = disc.querySelector('[data-nav-panel]') as HTMLElement;
    const chevron = disc.querySelector('[data-chevron]') as HTMLElement;
    if (!btn || !panel) return;
    btn.setAttribute('aria-expanded', 'false');
    panel.classList.add('hidden');
    chevron?.classList.remove('rotate-180');
    if (activeDisc === disc) activeDisc = null;
  }

  function closeAll(except?: Element) {
    clearCloseTimer();
    clearIntentTimer();
    disclosures.forEach((d) => { if (d !== except) closePanel(d); });
  }

  // Track pointer for menu-aim
  document.addEventListener('pointermove', (e) => {
    prevPoint = { x: e.clientX, y: e.clientY };
  }, { passive: true });

  disclosures.forEach((disc) => {
    const btn = disc.querySelector('[data-nav-trigger]') as HTMLButtonElement;
    const panel = disc.querySelector('[data-nav-panel]') as HTMLElement;
    if (!btn || !panel) return;

    // Click toggle (keyboard & mouse)
    btn.addEventListener('click', () => {
      const isOpen = btn.getAttribute('aria-expanded') === 'true';
      closeAll(disc);
      if (isOpen) closePanel(disc); else openPanel(disc);
    });

    if (hoverEnabled) {
      // Pointer enters a trigger area
      (disc as HTMLElement).addEventListener('pointerenter', (e: PointerEvent) => {
        if (e.pointerType === 'touch') return;
        clearCloseTimer();

        if (activeDisc && activeDisc !== disc) {
          // Another menu is open — use intent delay + menu-aim
          clearIntentTimer();
          intentTimer = setTimeout(() => {
            const panelRect = (activeDisc!.querySelector('[data-nav-panel]') as HTMLElement)?.getBoundingClientRect();
            const curr = { x: e.clientX, y: e.clientY };
            if (panelRect && shouldKeepOpen(prevPoint, curr, panelRect)) {
              // User is aiming at the active panel — don't switch yet
              return;
            }
            closeAll(disc);
            openPanel(disc);
          }, 120);
        } else {
          closeAll(disc);
          openPanel(disc);
        }
      });

      // Pointer leaves the trigger+panel zone — start close timer
      (disc as HTMLElement).addEventListener('pointerleave', (e: PointerEvent) => {
        if (e.pointerType === 'touch') return;
        clearIntentTimer();
        closeTimer = setTimeout(() => { closePanel(disc); }, 220);
      });
    }

    // Keyboard focus
    disc.addEventListener('focusin', () => { closeAll(disc); openPanel(disc); });

    panel.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') { closePanel(disc); btn.focus(); }
    });
    btn.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') { closePanel(disc); }
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('[data-nav-disclosure]')) closeAll();
  });

  document.querySelector('nav[aria-label="Main"]')?.addEventListener('focusout', () => {
    requestAnimationFrame(() => {
      if (!document.activeElement?.closest('[data-nav-disclosure]')) closeAll();
    });
  });

  // ── Mobile drawer ──
  const mobileToggle = document.querySelector('[data-mobile-toggle]') as HTMLButtonElement;
  const drawer = document.querySelector('[data-mobile-drawer]') as HTMLElement;
  const menuIcon = document.querySelector('[data-menu-icon]') as HTMLElement;
  const closeIcon = document.querySelector('[data-close-icon]') as HTMLElement;

  function openDrawer() {
    drawer.classList.remove('hidden');
    drawer.classList.add('flex', 'flex-col');
    mobileToggle.setAttribute('aria-expanded', 'true');
    menuIcon.classList.add('hidden');
    closeIcon.classList.remove('hidden');
    const first = drawer.querySelector('a, button, summary, [tabindex]') as HTMLElement;
    first?.focus();
  }

  function closeDrawer() {
    drawer.classList.add('hidden');
    drawer.classList.remove('flex', 'flex-col');
    mobileToggle.setAttribute('aria-expanded', 'false');
    menuIcon.classList.remove('hidden');
    closeIcon.classList.add('hidden');
    mobileToggle.focus();
  }

  mobileToggle?.addEventListener('click', () => {
    mobileToggle.getAttribute('aria-expanded') === 'true' ? closeDrawer() : openDrawer();
  });

  drawer?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') closeDrawer();
  });

  // ── Cart ──
  document.querySelectorAll('[data-open-cart]').forEach((btn) => {
    btn.addEventListener('click', () => window.dispatchEvent(new Event('open-cart-drawer')));
  });
</script>
