---
import Logo from './Logo.astro';
import CartBadge from '@/islands/CartBadge';
interface Props { section?: string }
const { section } = Astro.props;
const items = [
  { href: '/tools/', label: 'Free tools', key: 'tools' },
  { href: '/targets/', label: 'Targets', key: 'targets' },
  { href: '/#why', label: 'Why us', key: 'why' },
  { href: '/guides/', label: 'Guides', key: 'guides' },
];
---
<nav class="border-b border-line-light">
  <div class="container-x flex flex-wrap items-center justify-between gap-4 py-5">
    <Logo />
    <div class="hidden md:flex gap-7 text-[15px] font-medium">
      {items.map((i) => (
        <a href={i.href} class={`no-underline ${section === i.key ? 'text-brand' : 'text-ink hover:text-brand'}`}>{i.label}</a>
      ))}
    </div>
    <div class="flex items-center gap-3">
      <a href="/targets/" class="btn btn-primary !px-5 !py-3 !text-[15px]">
        Shop targets
      </a>
      <button type="button" class="relative flex h-11 w-11 items-center justify-center rounded border-[1.5px] border-line hover:border-ink" aria-label="Open cart" data-open-cart>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <span class="absolute -right-1.5 -top-1.5"><CartBadge client:load /></span>
      </button>
      <button type="button" class="md:hidden flex h-11 w-11 items-center justify-center rounded border-[1.5px] border-ink" aria-label="Open menu" data-menu-toggle>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <div class="container-x hidden flex-col gap-3 pb-5 md:!hidden" data-menu>
    {items.map((i) => <a href={i.href} class="text-ink no-underline text-base py-1">{i.label}</a>)}
  </div>
</nav>
<script>
  const t = document.querySelector('[data-menu-toggle]');
  const m = document.querySelector('[data-menu]');
  t?.addEventListener('click', () => { m?.classList.toggle('hidden'); m?.classList.toggle('flex'); });

  const cartBtn = document.querySelector('[data-open-cart]');
  cartBtn?.addEventListener('click', () => {
    window.dispatchEvent(new Event('open-cart-drawer'));
  });
</script>
