---
interface Props { current: string }
const { current } = Astro.props;
const tabs = [
  ['generator', 'Pattern generator'], ['fov', 'FOV calculator'], ['wizard', 'Selection wizard'],
  ['convert', 'Format converter'], ['check', 'Detection check'], ['quality', 'Quality analyzer'],
];
---
<div class="container-x flex flex-wrap gap-2 pt-5 text-sm font-medium">
  {tabs.map(([k, l]) => (
    <a href={`/tools/${k}/`} class={`rounded-full px-3.5 py-2 no-underline ${current === k ? 'bg-ink text-white hover:text-white' : 'bg-ground-panel text-ink hover:text-ink'}`}>{l}</a>
  ))}
</div>
