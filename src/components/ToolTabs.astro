---
import { tools } from '@/lib/tools';
interface Props { current: string }
const { current } = Astro.props;
---
<div class="container-x flex flex-wrap gap-2 pt-5 text-sm font-medium">
  {tools.map((t) => (
    <a href={t.href} class={`rounded-full px-3.5 py-2 no-underline ${current === t.key ? 'bg-ink text-white hover:text-white' : 'bg-ground-panel text-ink hover:text-ink'}`}>
      {t.title}{!t.live && <span class="ml-1 text-xs text-ink-muted">(soon)</span>}
    </a>
  ))}
</div>
