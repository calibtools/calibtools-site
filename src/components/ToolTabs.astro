---
import { tools } from '@/lib/tools';
interface Props { current: string }
const { current } = Astro.props;
/** Short labels that fit one row at 1280px; full names in aria-label. */
const shortLabels: Record<string, string> = {
  generator: 'Generator', fov: 'FOV', wizard: 'Wizard', convert: 'Convert',
  check: 'Check', quality: 'Quality', capture: 'Capture',
};
---
<div class="container-x flex flex-wrap gap-2 pt-5 text-sm font-semibold">
  {tools.map((t) => (
    <a href={t.href} aria-label={t.title} class={`rounded-full h-11 md:h-10 px-4 inline-flex items-center no-underline ${current === t.key ? 'bg-ink text-white hover:text-white' : 'bg-ground-panel text-ink hover:text-ink'}`}>
      {shortLabels[t.key] ?? t.title}
    </a>
  ))}
</div>
