---
/**
 * Category tiles (home and /targets/): rows on phones, tiles from md.
 * Board outlines are drawn to scale, and only for collections whose sizes are in boardSizes.ts.
 * Category images: the board faces are the generated patterns composited into the scene, not drawn by the image
 * model; a collection without an image shows its outline instead.
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import compositeImg from '@/assets/categories/composite-boards.webp';
import ceramicImg from '@/assets/products/charuco-ceramic/01-hero.webp';
import lidarIqImg from '@/assets/categories/lidar-image-quality.webp';
import multiSensorImg from '@/assets/categories/multi-sensor.webp';
import mountsImg from '@/assets/products/mounting-fixture/01-hero.webp';
import { formatCardPrice, type Collection } from '@/lib/shopify';
import { toScaleOutlines } from '@/lib/boardDrawing';
import { COMPOSITE_SIZES, CERAMIC_SIZES } from '@/lib/boardSizes';

interface Props { collections: Collection[] }
const { collections } = Astro.props;

const outlines: Record<string, { svg: string; caption: string }> = {
  'composite-boards': toScaleOutlines([COMPOSITE_SIZES[0], COMPOSITE_SIZES[2], COMPOSITE_SIZES[4]].map((s) => s.label), 10),
  'ceramic-glass': toScaleOutlines(CERAMIC_SIZES.slice(0, 3).map((s) => s.label), 2.5),
};

const images: Record<string, { src: ImageMetadata; alt: string }> = {
  'composite-boards': { src: compositeImg, alt: '400 by 300 mm aluminum composite ChArUco board CT-CHA-P-400X300-D6 standing on a small stand, seen from the front left.' },
  'ceramic-glass': { src: ceramicImg, alt: 'White ceramic ChArUco calibration plate seen from straight above, with a steel rule along its lower edge.' },
  'lidar-image-quality': { src: lidarIqImg, alt: 'Three square matte reflectance panels side by side: dark gray, mid gray and near white.' },
  'multi-sensor': { src: multiSensorImg, alt: 'Example layout of a LiDAR-camera target: a square panel with four ArUco markers and four circular holes cut through it.' },
  'mounts-accessories': { src: mountsImg, alt: 'Calib.Tools CT-ACC-M-FIX14 mounting fixture with two black anodized edge clamps and red thumb screws.' },
};

const tiles = await Promise.all(collections.map(async (c) => {
  const entry = await getEntry('collections', c.handle);
  /* Lowest priced product of the collection (0 = quote only) */
  const priced = c.products.filter((p) => Number(p.priceMinAmount) > 0).sort((x, y) => Number(x.priceMinAmount) - Number(y.priceMinAmount));
  const count = c.products.length;
  return {
    handle: c.handle,
    title: entry?.data.title ?? c.title,
    description: entry?.data.description ?? c.description,
    price: priced.length ? formatCardPrice(priced[0].priceFrom) : '',
    outline: outlines[c.handle],
    image: images[c.handle],
    /* The store may list none yet (quote-only collections): say nothing rather than "0 products" */
    countLabel: count > 0 ? `${count} ${count === 1 ? 'product' : 'products'}` : '',
  };
}));
---
<div class="grid grid-cols-1 border-t border-line md:grid-cols-3 md:gap-6 md:border-t-0 lg:grid-cols-5">
  {tiles.map((t) => (
    <a href={`/targets/collection/${t.handle}/`} data-card class="group flex items-center justify-between gap-4 border-b border-line py-4 text-ink no-underline hover:text-ink md:card md:bracket md:flex-col md:items-stretch md:justify-start md:gap-3 md:border-b md:p-5 md:hover:border-ink">
      {t.image
        ? <Image src={t.image.src} alt={t.image.alt} widths={[160, 320, 640]} sizes="(min-width: 1024px) 200px, (min-width: 768px) 30vw, 84px" class="aspect-[3/2] w-[84px] shrink-0 bg-ground-panel object-cover md:w-full" loading="lazy" />
        : <div class="aspect-[3/2] w-[84px] shrink-0 items-end md:flex md:w-full [&>svg]:hidden md:[&>svg]:block" set:html={t.outline?.svg ?? ''} />}
      <span class="spec-label hidden md:block">{t.outline ? t.outline.caption : t.countLabel}</span>
      <div class="flex min-w-0 flex-1 flex-col gap-1 md:flex-none md:gap-2">
        <strong class="text-[17px] leading-tight md:text-[20px]">{t.title}</strong>
        <span class="text-[14px] leading-snug text-ink-muted">{t.description}</span>
      </div>
      <span class="shrink-0 font-mono text-[14px] font-semibold md:mt-auto md:pt-2">{t.price ? `from ${t.price}` : 'quote'}</span>
    </a>
  ))}
</div>
