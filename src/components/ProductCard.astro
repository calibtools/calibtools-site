---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Rating from './Rating.astro';
import { formatCardPrice } from '@/lib/shopify';

interface Props {
  href: string;
  title: string;
  /** Short summary (<= 90 chars). Falls back to sub if not provided. */
  summary?: string;
  /** @deprecated Use summary instead. Kept for backward compat. */
  sub?: string;
  from: string;
  /** Remote image URL (Shopify CDN). */
  image?: string;
  /** Local optimized image (from import.meta.glob). */
  localImage?: ImageMetadata;
  placeholder?: string;
  /** Up to 3 value-only chip strings, rendered as "val · val · val". */
  chips?: string[];
  /** Star rating average (hidden when reviewCount is 0). */
  rating?: number;
  /** Review count (hidden when 0). */
  reviewCount?: number;
  /** Line drawing (SVG markup from boardDrawing.ts). Shown instead of the image when given. */
  drawing?: string;
  /** Caption under the drawing, e.g. the part number drawn. */
  drawingCaption?: string;
}
const {
  href, title, summary, sub, from: rawFrom, image, localImage,
  placeholder = 'PRODUCT', chips, rating = 0, reviewCount = 0, drawing, drawingCaption,
} = Astro.props;
const from = formatCardPrice(rawFrom);
const displaySummary = summary || sub || '';
---
<!-- Six shared rows (image, label, title, copy, chips, price) so cards in one row line up whatever wraps
     or is missing: DESIGN.md §3 "Card rows". A row with nothing to show stays, empty. -->
<a href={href} data-card class="card bracket rows-6 gap-y-1.5 text-ink no-underline hover:text-ink hover:border-ink">
  {/* No picture, no box: an empty frame is a placeholder (DESIGN.md §8.6). The row itself stays. */}
  {(drawing || localImage || image) ? (
  <div class="aspect-[4/3] border-b border-line bg-sheet flex items-center justify-center overflow-hidden font-mono text-xs text-ink-soft">
    {drawing ? (
      <div class="fit-svg flex h-full w-full items-center justify-center p-4" set:html={drawing} />
    ) : localImage ? (
      <Picture
        src={localImage}
        widths={[480, 800]}
        formats={['avif', 'webp', 'jpeg']}
        alt={title}
        class="h-full w-full object-cover"
        loading="lazy"
      />
    ) : image ? (
      <img src={image} alt="" class="h-full w-full object-cover" loading="lazy" />
    ) : null}
  </div>
  ) : <div></div>}
  <span class="spec-label px-5 pt-3.5">{drawing && drawingCaption ? drawingCaption : ''}</span>
  <div class="flex flex-col gap-1.5 px-5">
    <strong class="text-[17px] leading-snug">{title}</strong>
    {reviewCount > 0 && <Rating average={rating} count={reviewCount} size={12} />}
  </div>
  <span class="px-5 text-sm text-ink-muted line-clamp-2">{displaySummary}</span>
  <span class="px-5 text-[12px] font-mono text-ink-muted">{chips && chips.length > 0 ? chips.join(' · ') : ''}</span>
  <span class="self-end px-5 pb-5 font-mono text-[14px] font-semibold text-ink">{from ? `from ${from}` : 'quote'}</span>
</a>
