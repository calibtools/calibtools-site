---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import CartDrawer from '@/islands/CartDrawer';

interface Props {
  title: string;
  description?: string;
  /** Which nav item is current */
  section?: 'tools' | 'targets' | 'why' | 'guides';
  /** JSON-LD structured data objects to emit in <head>. */
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** Open Graph image URL. Falls back to /og/default.png. */
  ogImage?: string;
}
const { title, description = 'Precision camera calibration targets and free browser tools for machine vision.', section, jsonLd, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ?? '/og/default.png';
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Calib.Tools</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Calib.Tools" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/GeistVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMonoVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body class="bg-ground text-ink font-sans antialiased">
    <Nav section={section} />
    <main>
      <slot />
    </main>
    <Footer />
    <CartDrawer client:load />
  </body>
</html>
