---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import CartDrawer from '@/islands/CartDrawer';
import MobileBottomCluster from '@/islands/MobileBottomCluster';

interface PreloadImage {
  href: string;
  type: string;
  srcset?: string;
  sizes?: string;
}

interface Props {
  title: string;
  description?: string;
  /** Which nav item is current */
  section?: 'tools' | 'targets' | 'why' | 'guides';
  /** JSON-LD structured data objects to emit in <head>. */
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** Open Graph image URL. Falls back to /og/default.png. */
  ogImage?: string;
  /** Hero / LCP image to preload. */
  preloadImages?: PreloadImage[];
  /** Add noindex meta tag. */
  noindex?: boolean;
  /** Page colour theme. Only the home page uses 'dark'. */
  theme?: 'dark' | 'light';
}
const { title, description = 'Precision camera calibration targets and free browser tools for machine vision.', section, jsonLd, ogImage, preloadImages, noindex, theme = 'light' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ?? '/og/default.png';
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en" {...theme === 'dark' ? { 'data-theme': 'dark' } : {}}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Calib.Tools</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Calib.Tools" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/GeistVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMonoVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content={theme === 'dark' ? '#0A0A0A' : '#FFFFFF'}>
    {preloadImages?.map((img) => (
      <link rel="preload" as="image" href={img.href} type={img.type} imagesrcset={img.srcset} imagesizes={img.sizes} />
    ))}
    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body class="bg-ground text-ink font-sans antialiased">
    <Nav section={section} theme={theme} />
    <main class="pb-[88px] md:pb-0">
      <slot />
    </main>
    <Footer />
    <slot name="mobile-cluster">
      <MobileBottomCluster client:load mode="shop" />
    </slot>
    <CartDrawer client:load />
  </body>
</html>
