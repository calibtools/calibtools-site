---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import CartDrawer from '@/islands/CartDrawer';
import MobileBottomCluster from '@/islands/MobileBottomCluster';
import { ORGANIZATION_LD, autoBreadcrumbLd } from '@/lib/seo';

interface PreloadImage {
  href: string;
  type: string;
  srcset?: string;
  sizes?: string;
}

interface Props {
  title: string;
  description?: string;
  /** Which nav item is current */
  section?: 'tools' | 'targets' | 'why' | 'guides' | 'support' | 'generator' | 'applications';
  /** JSON-LD structured data objects to emit in <head>. */
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** Open Graph image URL. Falls back to /og/default.png. */
  ogImage?: string;
  /** Hero / LCP image to preload. */
  preloadImages?: PreloadImage[];
  /** Add noindex meta tag. */
  noindex?: boolean;
  /** Page color theme. Only the home page uses 'dark'. */
  theme?: 'dark' | 'light';
  /** Open Graph type. Defaults to 'website'. */
  ogType?: 'website' | 'article';
}
const { title, description = 'Precision camera calibration targets and free browser tools for machine vision.', section, jsonLd, ogImage, preloadImages, noindex, theme = 'light', ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Absolute URL: link previews in chat and social apps do not resolve relative image paths
const ogImageUrl = new URL(ogImage ?? '/og/default.png', Astro.site).href;
const providedLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const hasBreadcrumb = providedLd.some((ld) => ld['@type'] === 'BreadcrumbList');
const autoBc = !hasBreadcrumb ? autoBreadcrumbLd(Astro.url.pathname, title) : null;
const jsonLdItems = [...providedLd, ...(autoBc ? [autoBc] : []), ORGANIZATION_LD];
---
<!doctype html>
<html lang="en" {...theme === 'dark' ? { 'data-theme': 'dark' } : {}}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Calib.Tools</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Calib.Tools" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/GeistVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMonoVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" content={theme === 'dark' ? '#0A0A0A' : '#FFFFFF'}>
    {preloadImages?.map((img) => (
      <link rel="preload" as="image" href={img.href} type={img.type} imagesrcset={img.srcset} imagesizes={img.sizes} />
    ))}
    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body class="bg-ground text-ink font-sans antialiased">
    <Nav section={section} theme={theme} />
    <main>
      <slot />
    </main>
    <Footer />
    <slot name="mobile-cluster">
      <MobileBottomCluster client:load mode="shop" />
    </slot>
    <CartDrawer client:load />
    <script is:inline>
      // Hide the floating bottom cluster when the footer is in view.
      // Uses a scroll listener (synchronous with scroll) rather than
      // IntersectionObserver so the hidden state is set before any
      // same-frame read of computed styles.
      (function() {
        var footer = document.querySelector('footer');
        if (!footer) return;
        function check() {
          var fr = footer.getBoundingClientRect();
          var hidden = fr.top < window.innerHeight;
          document.querySelectorAll('[data-mobile-cluster]').forEach(function(el) {
            el.style.opacity = hidden ? '0' : '';
            el.style.pointerEvents = hidden ? 'none' : '';
          });
        }
        window.addEventListener('scroll', check, { passive: true });
        check();
      })();
    </script>
    <script>
      // A link to a folded section, or to something inside one, opens it first.
      import { openDisclosuresFor, idFromHash } from '@/lib/openForHash';
      function openTarget() {
        const id = idFromHash(location.hash);
        const el = id ? document.getElementById(id) : null;
        if (el && openDisclosuresFor(el) > 0) el.scrollIntoView({ block: 'start' });
      }
      openTarget();
      window.addEventListener('hashchange', openTarget);
    </script>
  </body>
</html>
