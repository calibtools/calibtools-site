---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Which nav item is current */
  section?: 'tools' | 'targets' | 'why' | 'guides';
}
const { title, description = 'Precision camera calibration targets and free browser tools for machine vision.', section } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Calib.Tools</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Calib.Tools" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-ground text-ink font-sans antialiased">
    <Nav section={section} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
