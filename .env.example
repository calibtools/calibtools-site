# Shopify Storefront API (shop.calib.tools).
# Public token is safe for the browser — it only grants read access + cart/customer create.
# Without these vars, builds use static fallback data so pages still render.
PUBLIC_SHOPIFY_DOMAIN=shop.calib.tools
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=replace-me

# Shopify Admin API — client-credentials OAuth (used by Pages Functions & scripts).
# Create a custom app: Settings → Apps → Develop apps → Create app.
# Scopes needed: read_customers, write_customers, read_orders.
SHOPIFY_STORE_DOMAIN=shop.calib.tools
SHOPIFY_CLIENT_ID=replace-me
SHOPIFY_CLIENT_SECRET=replace-me
